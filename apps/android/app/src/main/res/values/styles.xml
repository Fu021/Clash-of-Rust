<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_canvas">#f6f8fb</color>
    <bool name="launch_light_bars">true</bool>
    <style name="ClientBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
        <item name="android:colorBackground">@color/launch_canvas</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ClientTheme" parent="ClientBase" />
    <style name="ClientDarkBase" parent="ClientTheme">
        <item name="android:windowBackground">#111923</item>
        <item name="android:colorBackground">#111923</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="ClientDark" parent="ClientDarkBase" />
    <style name="ClientLight" parent="ClientTheme">
        <item name="android:windowBackground">#f6f8fb</item>
        <item name="android:colorBackground">#f6f8fb</item>
    </style>
</resources>

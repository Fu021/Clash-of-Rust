!insertmacro MUI_LANGUAGE "English"
!insertmacro InstallerVersionInfo ${LANG_ENGLISH} "Clash of Rust Windows Setup"
!define INSTALLER_UNINSTALL_SHORTCUT_EN "Uninstall Clash of Rust"

LangString InstallerLaunch ${LANG_ENGLISH} "Start Clash of Rust"
LangString InstallerAddShortcuts ${LANG_ENGLISH} "Add shortcuts"
LangString InstallerWriteFailed ${LANG_ENGLISH} "Setup could not write $InstallFile. Check whether the file is in use and verify disk space and write permissions."
LangString InstallerLaunchFromStart ${LANG_ENGLISH} "Installation complete. Open Clash of Rust from the Start menu."
LangString InstallerClientRunning ${LANG_ENGLISH} "Clash of Rust is running. Quit it and try again."
LangString InstallerRequiresArm64 ${LANG_ENGLISH} "This installer requires ARM64 Windows."
LangString InstallerRequiresX64 ${LANG_ENGLISH} "This installer requires 64-bit Windows."
LangString InstallerConfirmReplace ${LANG_ENGLISH} "Uninstall the existing Clash of Rust before continuing?$\r$\n$\r$\nYour subscriptions and settings will be kept. Choose No to cancel setup."
LangString InstallerShutdownFailed ${LANG_ENGLISH} "Could not quit Clash of Rust. Quit it from the system tray and run setup again."
LangString InstallerRemoveOldFailed ${LANG_ENGLISH} "Could not uninstall the previous version. Quit Clash of Rust, uninstall it, and run setup again."
LangString InstallerDataTitle ${LANG_ENGLISH} "Settings and data"
LangString InstallerDataDescription ${LANG_ENGLISH} "Choose whether to delete Clash of Rust data for the current Windows user."
LangString InstallerDeleteData ${LANG_ENGLISH} "Delete all settings and data"
LangString InstallerDeleteDirectory ${LANG_ENGLISH} "Selecting this option deletes the following folder:"
LangString InstallerKeepUnknownDirectory ${LANG_ENGLISH} "The data folder could not be located. Settings and data will be kept."
LangString InstallerDeleteDataFailed ${LANG_ENGLISH} "Some settings or data could not be deleted. Close programs using the folder and try again.$\r$\n$\r$\n$UserDataDir"
LangString InstallerUninstallShortcut ${LANG_ENGLISH} "${INSTALLER_UNINSTALL_SHORTCUT_EN}"
LangString InstallerStopCliFailed ${LANG_ENGLISH} "Could not stop the command-line backend. Run cor stop and try again."
LangString InstallerRemoveCliAutostartFailed ${LANG_ENGLISH} "Could not remove command-line startup. Run cor service remove --yes and try again."
LangString InstallerRemoveNetworkHelperFailed ${LANG_ENGLISH} "Could not remove the network helper. Turn off TUN and try again."
LangString InstallerRemoveAutostartFailed ${LANG_ENGLISH} "Could not remove automatic startup. Check the Task Scheduler service and try again."
LangString InstallerFilesInUse ${LANG_ENGLISH} "Clash of Rust or its core is in use. Quit Clash of Rust and try again."

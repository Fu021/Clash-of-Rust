import { Theme, Demo } from "../theme/palette.slint";
import { Label, Caption, Heading, Panel, ActionButton, Field, Badge } from "../components/controls.slint";

export component PreviewDialog inherits Rectangle {
    in property <int> kind;
    callback close();
    callback accept();
    property <int> countdown: 3;
    property <bool> raw-rule: false;
    property <int> selected-accent: Demo.accent-preview;
    changed kind => { root.countdown = 3; }
    Timer { interval: 1s; running: root.kind == 3 && root.countdown > 0; triggered => { root.countdown -= 1; } }
    background: #00000065;
    TouchArea { }
    Panel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 64px, root.kind == 10 ? 560px : root.kind >= 6 ? 700px : 560px);
        height: root.kind == 10 ? 332px : root.kind == 3 ? 402px : root.kind == 4 ? 370px : root.kind == 5 ? 304px : root.kind >= 6 ? 430px : 240px;
        VerticalLayout {
            padding: 24px; spacing: 16px;
            Heading {
                text: root.kind == 10 ? "强调色" : root.kind == 1 ? "删除订阅？" : root.kind == 2 ? "放弃尚未应用的修改？" : root.kind == 3 ? "开启 Claude 保护？" : root.kind == 4 ? "新建规则" : root.kind == 5 ? "编辑订阅" : root.kind == 6 ? Demo.detail-title + " · 检测详情" : root.kind == 7 ? "风险项目 · 3" : root.kind == 8 ? "正常项目 · 61" : "其他线索 · 12";
                font-size: 20px;
                height: 32px;
            }
            if root.kind == 1: Label {
                text: "将删除“备用订阅”及其缓存配置和自定义规则。\n此操作无法撤销。";
                wrap: word-wrap;
                vertical-alignment: top;
            }
            if root.kind == 2: Label {
                text: "当前未应用的规则顺序、快捷规则与自定义规则修改将被丢弃。";
                wrap: word-wrap;
                vertical-alignment: top;
            }
            if root.kind == 3: VerticalLayout {
                spacing: 12px;
                Label { text: "将使用当前节点，启用 TUN、严格路由、UDP、广泛规则、加密 DNS 与实时异常连接拦截。"; wrap: word-wrap; }
                Label { text: "这些设置可能影响其他应用、国内网站与内网服务；节点故障时相关解析也可能失败。"; wrap: word-wrap; color: Theme.warning; }
                Caption { text: "原代理模式、DNS、UDP、规则和节点选择会保存；重启后仍保留，关闭保护后恢复。"; wrap: word-wrap; }
                Caption { text: "无法保证消除所有地区线索或满足服务的账号资格要求。"; wrap: word-wrap; }
            }
            if root.kind == 4: VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { text: "表单"; selected: !root.raw-rule; clicked => { root.raw-rule = false; } }
                    ActionButton { text: "规则文本"; selected: root.raw-rule; clicked => { root.raw-rule = true; } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if !root.raw-rule: HorizontalLayout { Caption { text: "类型"; width: 80px; } Field { text: "DOMAIN-SUFFIX"; } }
                if !root.raw-rule: HorizontalLayout { Caption { text: "匹配内容"; width: 80px; } Field { placeholder: "example.com"; } }
                if !root.raw-rule: HorizontalLayout { Caption { text: "策略"; width: 80px; } Field { text: "DIRECT"; } }
                if root.raw-rule: Field { placeholder: "DOMAIN-SUFFIX,example.com,DIRECT"; }
                Caption { text: "新增规则将优先匹配，点击应用修改后生效。"; }
            }
            if root.kind == 5: VerticalLayout {
                spacing: 12px;
                Caption { text: "名称"; }
                Field { text: "备用订阅"; }
                Caption { text: "订阅地址或本地文件"; }
                Field { text: "https://example.com/subscription"; }
            }
            if root.kind >= 6 && root.kind <= 9: VerticalLayout {
                spacing: 10px;
                if root.kind == 6: Caption { text: "可用 4 / 5 · 绿色与黄色结果计入可用数量"; }
                for entry[i] in root.kind == 6 ? [
                    {title: "Claude", detail: "确认可用 · 德国", tone: 1},
                    {title: "ChatGPT", detail: "确认可用 · 德国", tone: 1},
                    {title: "Gemini", detail: "仅网页可达", tone: 2},
                    {title: "其他平台", detail: "确认可用 1 · 不可用或受限 1", tone: 4}
                ] : root.kind == 7 ? [
                    {title: "浏览器时区", detail: "Asia/Shanghai · 与出口地区不同", tone: 2},
                    {title: "项目代理配置", detail: "项目 A 的 HTTPS_PROXY 指向其他代理", tone: 3},
                    {title: "直连线路", detail: "相关请求曾使用 DIRECT · 查看连接记录", tone: 3}
                ] : root.kind == 8 ? [
                    {title: "网络出口", detail: "内核与浏览器均识别为德国", tone: 1},
                    {title: "实际递归 DNS", detail: "采样地区与当前出口一致", tone: 1},
                    {title: "项目配置", detail: "已扫描的配置中未发现额外代理覆盖", tone: 1}
                ] : [
                    {title: "浏览器语言", detail: "zh-CN · 仅为环境线索", tone: 4},
                    {title: "IPv6 出口", detail: "本次未取得有效结果", tone: 2},
                    {title: "请求实时观测", detail: "未捕捉到新的相关请求", tone: 4}
                ]: Rectangle {
                    height: 62px;
                    background: Theme.inset;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        Badge { text: entry.tone == 1 ? "正常" : entry.tone == 2 ? "待确认" : entry.tone == 3 ? "风险" : "线索"; tone: entry.tone; }
                        VerticalLayout { Label { text: entry.title; } Caption { text: entry.detail; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
            if root.kind == 10: VerticalLayout {
                spacing: 12px;
                for row in [0, 1]: HorizontalLayout {
                    spacing: 12px;
                    for column in [0, 1, 2]: Rectangle {
                        height: 76px;
                        width: (parent.width - 24px) / 3;
                        border-radius: 8px;
                        border-width: root.selected-accent == row * 3 + column ? 2px : 1px;
                        border-color: root.selected-accent == row * 3 + column ? Theme.accent : Theme.line;
                        background: root.selected-accent == row * 3 + column ? Theme.accent-wash : Theme.surface;
                        Rectangle {
                            x: 14px; y: 22px; width: 32px; height: 32px; border-radius: 16px;
                            background: Demo.accent-colors[row * 3 + column];
                            if root.selected-accent == row * 3 + column: Label { width: parent.width; height: parent.height; text: "✓"; color: #ffffff; horizontal-alignment: center; font-size: 19px; }
                        }
                        Label { x: 57px; y: 0px; width: parent.width - 65px; height: parent.height; text: Demo.accent-names[row * 3 + column]; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.selected-accent = row * 3 + column; } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                if root.kind == 10: ActionButton { text: "恢复默认"; clicked => { root.selected-accent = 0; } }
                Rectangle { horizontal-stretch: 1; }
                ActionButton { text: root.kind >= 6 && root.kind <= 9 ? "关闭" : "取消"; clicked => { root.close(); } }
                if root.kind < 6 || root.kind == 10: ActionButton {
                    text: root.kind == 10 ? "完成" : root.kind == 1 ? "删除订阅" : root.kind == 2 ? "放弃修改" : root.kind == 3 ? (root.countdown > 0 ? "请阅读（" + root.countdown + " 秒）" : "确认开启") : "保存";
                    primary: root.kind != 1;
                    danger: root.kind == 1;
                    enabled: root.kind != 3 || root.countdown == 0;
                    clicked => { if root.kind == 10 { Demo.accent-preview = root.selected-accent; } root.accept(); }
                }
            }
        }
    }
}

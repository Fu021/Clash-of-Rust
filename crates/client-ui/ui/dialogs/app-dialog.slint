import { Motion, Presence } from "../components/motion.slint";
import { DiagnosticActions } from "../components/notice.slint";
import { Theme, AccentPalette } from "../theme/palette.slint";
import { GeometryTarget } from "../components/geometry.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, Paragraph, Heading, Panel, ContentPanel, ActionButton, Field, Select, SettingRow, Divider } from "../components/controls.slint";
import { CopyButton } from "../components/desktop-copy.slint";
import { YamlDocument } from "../components/yaml-document.slint";
export component AppDialog inherits Rectangle {
    property <length> action-width: max(88px, max(copy-measure.preferred-width, max(disconnect-measure.preferred-width, dismiss-measure.preferred-width)) + 28px);
    copy-measure := Label { visible: false; text: root.kind == 15 ? @tr("复制规则原文") : root.kind == 13 ? @tr("复制全文") : @tr("复制详情"); }
    disconnect-measure := Label { visible: false; text: @tr("关闭连接"); }
    dismiss-measure := Label { visible: false; text: root.kind == 14 ? @tr("继续编辑") : (root.opened ? root.source-accept : root.last-accept) == "" ? @tr("关闭") : @tr("取消"); }
    in-out property <int> selected-accent: UiData.accent;
    presence := Presence { open: root.opened; motion-enabled: root.drawer ? Motion.layout-active : Motion.active; }
    out property <bool> mounted: presence.mounted;
    property <int> source-kind: UiData.modal != 0 ? UiData.modal : YamlDocument.confirm-close ? 14 : 0;
    property <bool> opened: root.source-kind != 0;
    property <int> kind;
    property <bool> drawer: root.kind == 10 || root.kind == 15;
    property <bool> rule-writable: root.opened && UiData.rule-types.length > 0
        && !UiData.working && !UiData.protected && !UiData.protection-pending && !UiData.exiting;
    changed source-kind => {
        if self.source-kind != 0 {
            self.kind = self.source-kind; self.selected-accent = UiData.accent;
            UiData.scroll-dialog = 0px;
        }
    }
    // Keep the last heading during exit; business state may already be cleared.
    property <string> source-title: root.source-kind == 14 ? YamlDocument.discard-title() : UiData.modal-title;
    property <string> source-description: root.source-kind == 14 ? YamlDocument.discard-detail() : UiData.modal-description;
    property <string> source-accept: root.source-kind == 14 ? @tr("放弃修改") : UiData.modal-accept;
    property <string> last-title;
    property <string> last-description;
    property <string> last-accept;
    property <string> rule-raw: root.source-kind == 15 ? UiData.modal-copy : "";
    property <string> last-rule-raw;
    changed rule-raw => { if self.source-kind == 15 { self.last-rule-raw = self.rule-raw; } }
    changed mounted => { if !self.mounted { self.last-rule-raw = ""; } }
    changed source-title => { if self.opened { self.last-title = self.source-title; } }
    changed source-description => {
        if self.opened {
            self.last-description = self.source-description;
        }
    }
    changed source-accept => { if self.opened { self.last-accept = self.source-accept; } }
    init => { self.kind = self.source-kind; self.last-title = self.source-title; self.last-description = self.source-description; self.last-accept = self.source-accept; self.last-rule-raw = self.rule-raw; }
    visible: presence.mounted;
    if presence.mounted: Rectangle {
        opacity: presence.progress;
        property <bool> opened: root.opened;
        changed opened => { if self.opened && !root.drawer { modal-focus.focus(); } }
        background: root.drawer ? transparent : #00000065;
        if !root.drawer: TouchArea { }
        init => { if !root.drawer { modal-focus.focus(); } }
        modal-focus := FocusScope { enabled: root.opened && !root.drawer; }
        dialog := Panel {
            if root.kind == 15: GeometryTarget { key: "rule-details-panel"; bounds: [dialog.absolute-position.x, dialog.absolute-position.y, dialog.width, dialog.height]; }
            border-radius: root.drawer ? 0px : 18px;
            drop-shadow-blur: 32px; drop-shadow-offset-y: 8px;
            x: root.drawer ? parent.width - self.width + (1 - presence.progress) * 32px : (parent.width - self.width) / 2;
            y: root.drawer ? 44px : (parent.height - self.height) / 2 + (1 - presence.progress) * 8px;
            width: min(parent.width - 48px, root.drawer ? max(360px * Theme.text-scale, root.action-width * (root.kind == 10 ? 3 : 2) + Theme.dialog-padding * 2 + Theme.content-gap * 2) : root.kind == 11 || root.kind == 13 ? 700px : 600px);
            height: root.drawer ? parent.height - 44px : min(parent.height - 48px, content.preferred-height);
            content := VerticalLayout {
                padding: Theme.dialog-padding; spacing: Theme.dialog-gap;
                Heading { text: root.opened ? root.source-title : root.last-title; font-size: 20px * Theme.text-scale; }
                PageScroll {
                    content-key: root.kind + "/" + root.last-title + "/" + root.last-description + (root.kind == 15 ? "/" + root.last-rule-raw : "");
                    content-y <=> UiData.scroll-dialog;
                    min-height: 0px;
                    preferred-height: body.preferred-height;
                    body := VerticalLayout {
                        width: dialog.width - Theme.dialog-padding * 2;
                        alignment: start; padding-right: Theme.content-gap; spacing: Theme.page-gap;
                        if UiData.modal-country != "": HorizontalLayout {
                            cross-axis-alignment: center; spacing: Theme.content-gap;
                            if UiData.modal-flagged: Text { text: UiData.modal-flag; width: 24px; height: 24px; font-size: 20px; }
                            Label { text: UiData.modal-country; }
                        }
                        if (root.opened ? root.source-description : root.last-description) != "": Paragraph { text: root.opened ? root.source-description : root.last-description; }
                        if root.kind == 2: VerticalLayout {
                            width: body.width - Theme.content-gap;
                            horizontal-stretch: 1;
                            spacing: Theme.page-gap;
                            Caption { text: @tr("名称"); }
                            Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "profile-edit-name"; text <=> UiData.edit-name; edited(value) => { UiActions.dispatch(Intent.edit-name, value, ""); } }
                            Caption { text: @tr("订阅地址或本地文件"); }
                            Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "profile-edit-source"; text <=> UiData.edit-source; edited(value) => { UiActions.dispatch(Intent.edit-source, value, ""); } }
                            ActionButton { modal-control: true; text: @tr("选择文件"); clicked => { UiActions.dispatch(Intent.pick-file, "true", ""); } }
                        }
                        if root.kind == 3: VerticalLayout {
                            width: body.width - Theme.content-gap;
                            horizontal-stretch: 1;
                            spacing: Theme.page-gap;
                            Caption { text: @tr("名称"); }
                            Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "profile-edit-name"; text <=> UiData.profile-name; edited(value) => { UiActions.dispatch(Intent.profile-name, value, ""); } }
                            Caption { text: @tr("订阅地址或本地文件"); }
                            Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "profile-edit-source"; text <=> UiData.profile-source; edited(value) => { UiActions.dispatch(Intent.profile-source, value, ""); } }
                            ActionButton { modal-control: true; text: @tr("选择文件"); clicked => { UiActions.dispatch(Intent.pick-file, "false", ""); } }
                        }
                        if root.kind == 4: VerticalLayout {
                            spacing: Theme.page-gap;
                            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                ActionButton { modal-control: true; text: @tr("表单"); selected: !UiData.rule-text-mode; clicked => { UiActions.dispatch(Intent.rule-text-mode, "false", ""); } }
                                ActionButton { modal-control: true; text: @tr("规则文本"); selected: UiData.rule-text-mode; clicked => { UiActions.dispatch(Intent.rule-text-mode, "true", ""); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if UiData.rule-text-mode: Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "rule-raw"; text <=> UiData.rule-raw; edited(value) => { UiActions.dispatch(Intent.rule-raw, value, ""); } }
                            if !UiData.rule-text-mode: VerticalLayout {
                                spacing: Theme.page-gap;
                                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                    Caption { text: @tr("类型"); width: 80px; }
                                    Select { geometry-key: "rule-kind"; modal-control: true; value: UiData.rule-kind; options: UiData.rule-types; selected(index, value) => { UiActions.dispatch(Intent.rule-kind, value, ""); } }
                                }
                                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                    Caption { text: @tr("匹配内容"); width: 80px; }
                                    Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } focus-id: "rule-payload"; text <=> UiData.rule-payload; edited(value) => { UiActions.dispatch(Intent.rule-payload, value, ""); } }
                                }
                                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                    Caption { text: @tr("策略"); width: 80px; }
                                    Select { geometry-key: "rule-policy"; modal-control: true; value: UiData.rule-policy; options: UiData.rule-policies; selected(index, value) => { UiActions.dispatch(Intent.rule-policy, value, ""); } }
                                }
                                if (UiData.rule-kind == "GEOIP" || UiData.rule-kind == "IP-CIDR" || UiData.rule-kind == "IP-CIDR6" || UiData.rule-kind == "IP-ASN" || UiData.rule-kind == "RULE-SET"): SettingRow { modal-control: true; title: "no-resolve"; checked: UiData.rule-no-resolve; toggled(value) => { UiActions.dispatch(Intent.rule-no-resolve, value ? "true" : "false", ""); } }
                            }
                            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                Caption { text: @tr("插入位置"); width: 80px; }
                                Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } text <=> UiData.rule-position; edited(value) => { UiActions.dispatch(Intent.rule-position, value, ""); } }
                            }
                            SettingRow { modal-control: true; title: @tr("启用规则"); checked: UiData.rule-enabled; toggled(value) => { UiActions.dispatch(Intent.rule-enabled, value ? "true" : "false", ""); } }
                        }
                        if root.kind == 5: Field { modal-control: true; accepted => { if UiData.modal-can-accept && !UiData.working && !UiData.exiting { UiActions.dispatch(Intent.confirm, "", ""); } } text <=> UiData.rule-move-position; edited(value) => { UiActions.dispatch(Intent.rule-move-input, value, ""); } }
                        if root.kind == 8: GridLayout { spacing: Theme.content-gap;
                            CopyButton { col: 0; row: 0; modal-control: true; label: @tr("复制采样脚本"); intent: Intent.claude-copy-script; }
                            ActionButton { col: 1; row: 0; modal-control: true; text: @tr("导入剪贴板"); clicked => { UiActions.dispatch(Intent.claude-import, "", ""); } }
                            if UiData.browser-session: ActionButton { col: 0; row: 1; modal-control: true; text: @tr("关闭回传"); clicked => { UiActions.dispatch(Intent.claude-close-session, "", ""); } }
                            ActionButton { col: 1; row: 1; modal-control: true; text: @tr("打开采样页"); clicked => { UiActions.dispatch(Intent.claude-browser, "", ""); } }
                        }
                        if root.kind == 10: VerticalLayout {
                            alignment: start; spacing: 0px;
                            for item[i] in UiData.connection-details: VerticalLayout {
                                alignment: start; spacing: 0px;
                                HorizontalLayout {
                                    padding-top: Theme.content-gap; padding-bottom: Theme.content-gap;
                                    spacing: Theme.dialog-gap; cross-axis-alignment: start;
                                    Caption {
                                        text: item.label;
                                        width: min(112px * Theme.text-scale, dialog.width * 0.25);
                                        horizontal-stretch: 0; vertical-alignment: top; wrap: word-wrap;
                                    }
                                    Paragraph { text: item.value; }
                                }
                                if i + 1 < UiData.connection-details.length: Divider { }
                            }
                        }
                        if root.kind == 15: VerticalLayout {
                            spacing: Theme.content-gap;
                            Paragraph { text: root.opened ? root.rule-raw : root.last-rule-raw; }
                            if UiData.rule-types.length > 0: Divider { }
                            if UiData.rule-custom: HorizontalLayout { alignment: start; spacing: Theme.content-gap;
                                ActionButton { modal-control: true; compact: true; text: @tr("编辑"); enabled: root.rule-writable;
                                    clicked => { UiActions.dispatch(Intent.rule-edit, "", ""); } }
                                ActionButton { modal-control: true; compact: true; text: UiData.rule-enabled ? @tr("停用") : @tr("启用"); enabled: root.rule-writable;
                                    clicked => { UiActions.dispatch(Intent.rule-enable, "", ""); } }
                                ActionButton { modal-control: true; compact: true; text: @tr("删除"); danger: true; enabled: root.rule-writable;
                                    clicked => { UiActions.dispatch(Intent.rule-delete, "", ""); } }
                            }
                            if UiData.rule-types.length > 0: ActionButton { modal-control: true; compact: true; quiet: true; text: @tr("跨页移动到位置…"); enabled: root.rule-writable;
                                clicked => { UiActions.dispatch(Intent.rule-move-open, "", ""); } }
                            if UiData.rule-types.length > 0: ActionButton { modal-control: true; compact: true; quiet: true; text: @tr("恢复订阅顺序"); enabled: root.rule-writable;
                                clicked => { UiActions.dispatch(Intent.rule-restore, "", ""); } }
                        }
                        if root.kind == 12: VerticalLayout {
                            spacing: Theme.page-gap;
                            for row in [0, 1]: HorizontalLayout { cross-axis-alignment: center; spacing: Theme.page-gap;
                                for column in [0, 1, 2]: swatch := Rectangle {
                                    GeometryTarget { key: "accent:" + (row * 3 + column); bounds: [swatch.absolute-position.x, swatch.absolute-position.y, swatch.width, swatch.height]; }
                                    width: (dialog.width - Theme.dialog-padding * 2 - Theme.content-gap - Theme.page-gap * 2) / 3; height: 76px;
                                    border-radius: 8px; border-width: 1px;
                                    border-color: root.selected-accent == row * 3 + column ? Theme.accent : Theme.line;
                                    background: root.selected-accent == row * 3 + column ? Theme.accent-wash : Theme.surface;
                                    Rectangle { x: 12px; y: (parent.height - self.height) / 2; width: 24px; height: 24px; border-radius: 12px; background: AccentPalette.accent-colors[row * 3 + column]; }
                                    Label { x: 44px; height: parent.height; width: parent.width - 48px; text: AccentPalette.accent-names[row * 3 + column]; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.selected-accent = row * 3 + column; } }
                                }
                            }
                        }
                    }
                }
                if UiData.modal-error != "": VerticalLayout { spacing: Theme.content-gap;
                    Paragraph { text: UiData.modal-error; color: Theme.danger; }
                    DiagnosticActions { context: UiData.modal-error; }
                }
                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                    if root.drawer || root.kind == 11 || root.kind == 13: CopyButton {
                        geometry-key: "dialog-copy"; width: root.kind == 10 ? root.action-width : max(88px, copy-measure.preferred-width + 28px);
                        modal-control: true; label: copy-measure.text; value: UiData.modal-copy;
                        enabled: root.kind != 10 || UiData.connection-details.length > 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.kind == 10: ActionButton {
                        geometry-key: "dialog-close-connection"; width: root.action-width;
                        modal-control: true; text: @tr("关闭连接"); danger: true;
                        enabled: UiData.connection-selected-id != "" && UiData.connection-details.length > 0 && !UiData.working && !UiData.protected && !UiData.protection-pending;
                        clicked => { UiActions.dispatch(Intent.close-connection, UiData.connection-selected-id, ""); }
                    }
                    ActionButton { geometry-key: "dialog-dismiss"; width: root.kind == 10 ? root.action-width : max(68px, dismiss-measure.preferred-width + 28px); modal-control: true; text: dismiss-measure.text;
                        clicked => {
                            if root.kind == 14 { YamlDocument.continue-editing(); }
                            else { UiActions.dispatch(Intent.cancel-confirm, "", ""); }
                        }
                    }
                    if (root.opened ? root.source-accept : root.last-accept) != "": ActionButton { modal-control: true;
                        geometry-key: root.kind == 14 ? "yaml-discard-confirm" : "button:" + self.text;
                        text: root.opened ? root.source-accept : root.last-accept; primary: !self.danger; danger: root.kind == 14 || UiData.modal-danger;
                        enabled: root.kind == 14 ? YamlDocument.confirm-close : UiData.modal-can-accept && (root.kind == 12 || !UiData.working) && !UiData.exiting;
                        clicked => {
                            if root.kind == 14 { YamlDocument.discard-and-leave(); }
                            else if root.kind == 12 { UiActions.dispatch(Intent.accent-color, "" + root.selected-accent, ""); }
                            else { UiActions.dispatch(Intent.confirm, "", ""); }
                        }
                    }
                }
            }
        }
        if !root.opened: TouchArea { }
    }
}

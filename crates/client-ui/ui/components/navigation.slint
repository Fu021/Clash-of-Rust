import { Motion } from "motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData } from "../state.slint";
import { Label } from "controls.slint";

export component NavigationItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked();
    forward-focus: key-scope;
    height: Theme.control-height;
    border-radius: 8px;
    background: root.selected ? Theme.inset : area.has-hover ? Theme.surface : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if UiData.modal == 0 && !UiData.notice-modal { root.clicked(); } }
    animate background { duration: Motion.control; enabled: Motion.active; }
    Image { x: root.compact ? (parent.width - self.width) / 2 : 12px; y: (parent.height - self.height) / 2; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.secondary; animate colorize { duration: Motion.control; enabled: Motion.active; } }
    if !root.compact: Label { x: 40px; y: 0px; width: parent.width - 48px; height: parent.height; text: root.text; color: Theme.ink; font-weight: root.selected ? 600 : 400; }
    key-scope := FocusScope {
        enabled: UiData.modal == 0 && !UiData.notice-modal;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea { mouse-cursor: pointer; clicked => { key-scope.focus(); root.clicked(); } }
}

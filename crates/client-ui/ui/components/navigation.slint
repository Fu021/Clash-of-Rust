import { Theme } from "../theme/palette.slint";
import { Label } from "controls.slint";

export component NavigationItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 38px;
    border-radius: 8px;
    background: root.selected ? Theme.accent-wash : area.has-hover ? Theme.surface : transparent;
    if root.selected: Rectangle { x: 0px; y: 10px; width: 3px; height: 18px; background: Theme.accent; border-radius: 2px; }
    Image { x: 14px; y: 10px; width: 18px; height: 18px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.secondary; }
    Label { x: 44px; y: 0px; width: parent.width - 48px; height: parent.height; text: root.text; color: root.selected ? Theme.accent : Theme.ink; }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

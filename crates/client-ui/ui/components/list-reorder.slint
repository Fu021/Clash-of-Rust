// Keep the gesture and its preview outside recycled rows.
export component ListReorderPreview inherits Rectangle {
    in property <bool> active;
    in property <length> row-y;
    in property <length> row-height;
    out property <length> preview-y: clamp(root.row-y, 0px, max(0px, root.height - root.row-height));
    visible: root.active;
    clip: true;
    Rectangle {
        x: 0px; y: root.preview-y; width: parent.width; height: root.row-height;
        drop-shadow-blur: 12px; drop-shadow-offset-y: 3px; drop-shadow-color: #00000030;
        @children
    }
}

export component ListReorderGesture inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> cancel-requested;
    in property <duration> hold-duration: 550ms;
    in property <string> context;
    in property <int> row-count;
    in property <length> row-height: 80px;
    in property <length> header-height;
    in property <length> scroll-content-height;
    in-out property <length> scroll-y;
    out property <bool> reordering: root.tracking && root.enabled && root.same-layout;
    out property <int> drag-index: root.reordering ? root.source-index : -1;
    // Pointer movement is direct; scrolling must not move the lifted row.
    out property <length> drag-y: root.pointer-y - root.grab-offset;
    property <bool> tracking;
    property <bool> armed;
    property <string> press-context;
    property <int> press-row-count;
    property <length> press-row-height;
    property <length> press-header-height;
    property <length> press-height;
    property <bool> same-layout: root.context == root.press-context && root.row-count == root.press-row-count
        && root.row-height == root.press-row-height && root.header-height == root.press-header-height && root.height == root.press-height;
    property <int> source-index: -1;
    property <int> target-index: -1;
    property <length> pointer-y;
    property <length> press-y;
    property <length> press-scroll-y;
    property <length> grab-offset;
    property <length> edge: min(64px, root.height / 4);
    property <length> bottom: min(0px, root.height - root.scroll-content-height);
    property <float> direction: root.pointer-y < root.edge ? -clamp((root.edge - root.pointer-y) / max(1px, root.edge), 0, 1)
        : root.pointer-y > root.height - root.edge ? clamp((root.pointer-y - root.height + root.edge) / max(1px, root.edge), 0, 1) : 0;
    callback started(int);
    callback targeted(int);
    callback dropped(int, int);
    callback cancelled();
    width: 48px;
    changed enabled => { if !root.enabled { root.abort(); } }
    changed cancel-requested => { if root.cancel-requested { root.abort(); } }
    changed context => { root.abort(); }
    changed row-count => { root.abort(); }
    changed row-height => { root.abort(); }
    changed header-height => { root.abort(); }
    changed height => { root.abort(); }
    changed scroll-y => {
        if root.reordering { root.update-target(); }
        else if root.armed && abs(root.scroll-y - root.press-scroll-y) > 1px { root.abort(); }
    }

    function abort() {
        root.armed = false;
        if root.tracking { root.tracking = false; root.cancelled(); }
    }
    function update-target() {
        root.target-index = clamp(floor((root.pointer-y - root.scroll-y - root.header-height) / max(1px, root.row-height)), 0, root.row-count - 1);
        root.targeted(root.target-index);
    }
    Timer {
        interval: root.hold-duration;
        running: root.hold-duration > 0ms && root.armed && area.pressed && root.enabled && root.same-layout;
        triggered => {
            root.armed = false;
            root.tracking = true;
            keys.focus();
            root.started(root.source-index);
            root.update-target();
        }
    }
    Timer {
        interval: 32ms;
        running: root.reordering && root.enabled && root.direction != 0
            && (root.direction < 0 ? root.scroll-y < 0px : root.scroll-y > root.bottom);
        triggered => {
            root.scroll-y = clamp(root.scroll-y - root.direction * 24px, root.bottom, 0px);
            root.update-target();
        }
    }
    keys := FocusScope {
        x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Escape && root.reordering { root.abort(); return accept; }
            return reject;
        }
        area := TouchArea {
            y: max(0px, root.header-height + root.scroll-y);
            width: parent.width;
            height: max(0px, min(root.height, root.header-height + root.row-count * root.row-height + root.scroll-y) - self.y);
            enabled: root.enabled; mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.abort();
                    root.pointer-y = self.mouse-y + self.y;
                    root.press-y = root.pointer-y;
                    root.press-scroll-y = root.scroll-y;
                    root.press-context = root.context;
                    root.press-row-count = root.row-count;
                    root.press-row-height = root.row-height;
                    root.press-header-height = root.header-height;
                    root.press-height = root.height;
                    root.source-index = floor((root.pointer-y - root.scroll-y - root.header-height) / max(1px, root.row-height));
                    root.grab-offset = root.pointer-y - root.scroll-y - root.header-height - root.source-index * root.row-height;
                    root.armed = root.source-index >= 0 && root.source-index < root.row-count;
                    if root.armed && root.hold-duration == 0ms {
                        root.armed = false;
                        root.tracking = true;
                        keys.focus();
                        root.started(root.source-index);
                        root.update-target();
                    }
                } else if event.kind == PointerEventKind.up {
                    root.armed = false;
                    if root.reordering {
                        root.pointer-y = self.mouse-y + self.y;
                        root.update-target();
                        root.tracking = false;
                        root.dropped(root.source-index, root.target-index);
                    } else { root.abort(); }
                } else if event.kind == PointerEventKind.cancel {
                    root.abort();
                }
            }
            moved => {
                root.pointer-y = self.mouse-y + self.y;
                if !root.reordering && self.pressed && abs(root.pointer-y - root.press-y) > 8px {
                    root.armed = false;
                    root.scroll-y = clamp(root.press-scroll-y + root.pointer-y - root.press-y, root.bottom, 0px);
                }
                if root.reordering { root.update-target(); }
            }
        }
    }
}

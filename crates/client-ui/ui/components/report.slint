import { GeometryTarget } from "geometry.slint";
import { ActionButton, Panel, Label, Caption, Paragraph, Badge } from "controls.slint";
import { Theme } from "../theme/palette.slint";
import { ReportItem } from "../models.slint";

component FindingRow inherits Rectangle {
    in property <ReportItem> item;
    in property <length> title-size;
    in property <length> detail-size;
    in property <length> caption-size;
    in property <length> detail-touch-height;
    in property <string> detail-key;
    in property <bool> show-details;
    property <bool> expanded;
    property <string> item-identity: root.item.id + "\n" + root.item.title + "\n" + root.item.source;
    changed item-identity => { root.expanded = false; }
    changed item => {
        if root.item.id != "实时保护与异常拦截" || root.item.title != "实时保护与异常拦截" {
            root.expanded = false;
        }
    }
    height: content.preferred-height;
    content := HorizontalLayout {
        padding: 16px; spacing: 12px; cross-axis-alignment: start;
        Rectangle {
            width: 30px; height: 30px; border-radius: 8px; background: Theme.inset;
            if root.item.flagged: Text { text: root.item.flag; width: parent.width; height: parent.height; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; }
            if !root.item.flagged: Image { source: @image-url("../icons/ai.svg"); x: 7px; y: 7px; width: 16px; height: 16px; colorize: Theme.secondary; }
        }
        VerticalLayout {
            spacing: 5px; min-width: 0px;
            Label { text: root.item.title; font-weight: 600; font-size: root.title-size; wrap: word-wrap; }
            Paragraph { text: root.item.value; font-size: root.detail-size; }
            if root.item.country != "": Caption { text: "地区：" + root.item.country; font-size: root.caption-size; wrap: word-wrap; }
            if !root.show-details && (root.item.detail != "" || root.item.source != "" || root.item.delay != ""): HorizontalLayout {
                ActionButton {
                    geometry-key: root.detail-key;
                    text: root.expanded ? "收起详情" : "查看详情"; quiet: true; compact: true;
                    touch-height: root.detail-touch-height;
                    clicked => { root.expanded = !root.expanded; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if (root.expanded || root.show-details) && root.item.detail != "": Paragraph { text: root.item.detail; color: Theme.secondary; font-size: root.detail-size; }
            if (root.expanded || root.show-details) && root.item.source != "": Caption { text: "来源：" + root.item.source; wrap: word-wrap; color: Theme.muted; font-size: root.caption-size; }
            if (root.expanded || root.show-details) && root.item.delay != "": Caption { text: root.item.delay; color: Theme.tone-color(root.item.delay-tone); font-size: root.caption-size; }
        }
        if root.item.tone == 3: Badge { text: "需关注"; tone: 3; font-size: root.caption-size; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.subtle-line; }
}

component FindingBlock inherits Panel {
    in property <ReportItem> section;
    in property <length> title-size;
    in property <length> detail-size;
    in property <length> caption-size;
    in property <length> detail-touch-height;
    callback show-details();
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    height: block-content.preferred-height; clip: true;
    GeometryTarget { key: "claude-card:" + root.section.id; bounds: [root.absolute-position.x, root.absolute-position.y, root.width, root.height]; }
    if root.section.block-items > 0: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show-details(); }
    }
    block-content := VerticalLayout {
        padding: 16px; spacing: 6px;
        HorizontalLayout {
            cross-axis-alignment: start; spacing: 8px;
            Label { text: root.section.title; font-weight: 600; font-size: root.title-size; wrap: word-wrap; horizontal-stretch: 1; }
            if root.section.delay-tone == 3: Badge { text: "需关注"; tone: 3; font-size: root.caption-size; }
        }
        if root.section.detail != "": Caption { text: root.section.detail; wrap: word-wrap; color: root.section.delay-tone == 3 ? Theme.danger : Theme.warning; font-size: root.caption-size; }
        Paragraph { text: root.section.value; font-size: root.detail-size; color: Theme.secondary; }
        HorizontalLayout {
            ActionButton {
                geometry-key: "claude-block:" + root.section.id;
                text: "查看 " + root.section.block-items + " 项详情 →"; quiet: true; compact: true;
                touch-height: root.detail-touch-height;
                enabled: root.section.block-items > 0;
                clicked => { root.show-details(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component FindingBlocks inherits Rectangle {
    in property <[ReportItem]> items;
    in property <length> title-size: Theme.body-size;
    in property <length> detail-size: Theme.detail-size;
    in property <length> caption-size: Theme.detail-size;
    in property <length> detail-touch-height: 0px;
    callback show-details(string);
    property <int> columns: root.width < 680px * Theme.text-scale ? 1 : root.width < 1040px * Theme.text-scale ? 2 : 3;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    height: blocks.preferred-height;
    blocks := GridLayout {
        x: 0px; width: root.width;
        spacing: Theme.page-gap;
        for index in min(root.items.length, 5): FindingBlock {
            col: mod(index, root.columns); row: floor(index / root.columns);
            section: root.items[index];
            title-size: root.title-size; detail-size: root.detail-size; caption-size: root.caption-size; detail-touch-height: root.detail-touch-height;
            show-details => { root.show-details(root.items[index].id); }
        }
    }
}

export component FindingList inherits Panel {
    in property <[ReportItem]> items;
    in property <int> tone;
    in property <string> section;
    in property <length> title-size: Theme.body-size;
    in property <length> detail-size: Theme.detail-size;
    in property <length> caption-size: Theme.detail-size;
    in property <length> detail-touch-height: 0px;
    in property <int> summary-limit: -1;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    height: rows.preferred-height;
    clip: true;
    GeometryTarget { key: "claude-report"; bounds: [root.absolute-position.x, root.absolute-position.y, root.width, root.height]; }
    rows := VerticalLayout {
        spacing: 0px;
        for result[index] in root.items: result-row := VerticalLayout {
            spacing: 0px; vertical-stretch: 0;
            GeometryTarget { key: "claude-result:" + index; bounds: [result-row.absolute-position.x, result-row.absolute-position.y, result-row.width, result-row.height]; }
            if result.tone > 0 && (root.section == "" || result.id == root.section) && (root.summary-limit < 0 || index < root.summary-limit) && (root.tone == 0 || result.tone == root.tone): FindingRow {
                item: result;
                detail-key: "claude-result-detail:" + index;
                title-size: root.title-size; detail-size: root.detail-size; caption-size: root.caption-size; detail-touch-height: root.detail-touch-height;
            }
        }
    }
}

export global UiGeometry {
    callback measured(string, [length]);
}

export component GeometryTarget {
    in property <string> key;
    in property <[length]> bounds;
    changed bounds => { if root.key != "" { UiGeometry.measured(root.key, root.bounds); } }
    changed key => { if root.key != "" { UiGeometry.measured(root.key, root.bounds); } }
    init => { if root.key != "" { UiGeometry.measured(root.key, root.bounds); } }
}

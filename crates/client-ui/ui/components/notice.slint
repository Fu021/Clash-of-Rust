import { Presence } from "motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { ContentPanel, Paragraph, Heading, ActionButton } from "controls.slint";

export component DiagnosticActions inherits HorizontalLayout {
    in property <string> context;
    in property <bool> notice-control;
    spacing: Theme.content-gap; alignment: start;
    ActionButton { modal-control: true; notice-control: root.notice-control; text: UiData.diagnosing ? "正在采集…" : "导出诊断"; enabled: !UiData.diagnosing;
        clicked => { UiActions.dispatch(Intent.export-diagnostics, root.context, ""); }
    }
    ActionButton { modal-control: true; notice-control: root.notice-control; text: "复制命令";
        clicked => { UiActions.dispatch(Intent.copy, "cor diagnose --output cor-diagnose.json", ""); }
    }
    ActionButton { modal-control: true; notice-control: root.notice-control; text: "新建 Issue"; enabled: !UiData.diagnosing;
        clicked => { UiActions.dispatch(Intent.report-issue, root.context, ""); }
    }
    @children
}

export component DesktopNotice inherits Rectangle {
    in property <length> available-height;
    presence := Presence { open: UiData.notice != ""; }
    out property <bool> mounted: presence.mounted;
    out property <[length]> close-target: [panel.absolute-position.x + Theme.card-padding, panel.absolute-position.y + Theme.card-padding, panel.width - Theme.card-padding * 2, 24px];
    property <string> message;
    property <string> source: UiData.notice;
    changed source => { if self.source != "" { self.message = self.source; } }
    init => { self.message = UiData.notice; }
    height: root.available-height;
    visible: presence.mounted;
    opacity: presence.progress;
    if UiData.notice-modal: Rectangle {
        width: parent.width; height: parent.height; background: #00000065;
        TouchArea { }
    }
    error-focus := FocusScope {
        property <bool> active: UiData.notice-modal;
        enabled: self.active;
        changed active => { if self.active { self.focus(); } }
        init => { if self.active { self.focus(); } }
        key-pressed(event) => {
            if event.text == Key.Escape && self.active {
                UiActions.dispatch(Intent.dismiss-notice, "", ""); return accept;
            }
            return reject;
        }
    }
    panel := VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: UiData.notice-modal ? max(16px, (parent.height - self.height) / 2) : parent.height - self.height - 24px + (1 - presence.progress) * 8px;
        width: min(UiData.notice-modal ? 640px : 560px, parent.width - 48px); height: self.preferred-height;
        if presence.mounted: ContentPanel {
            drop-shadow-blur: 20px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000030;
            interactive: true;
            clicked => { UiActions.dispatch(Intent.dismiss-notice, "", ""); }
            if UiData.notice-modal: Heading { text: "发生错误"; color: Theme.danger; }
            HorizontalLayout { cross-axis-alignment: start; spacing: Theme.content-gap;
                Flickable {
                    property <string> context: root.message;
                    property <length> bottom: min(0px, self.height - self.content-height);
                    changed context => { self.content-y = 0px; }
                    changed bottom => { self.content-y = clamp(self.content-y, self.bottom, 0px); }
                    height: min(content.preferred-height, max(48px, root.available-height * (UiData.notice-modal ? 0.8 : 0.4) - (UiData.notice-modal ? 120px : 80px)));
                    horizontal-stretch: 1; vertical-stretch: 0; min-width: 0px;
                    interactive: true; mouse-drag-pan-enabled: true;
                    content-width: self.width; content-height: max(self.height, content.preferred-height);
                    content := VerticalLayout {
                        width: parent.width; height: self.preferred-height;
                        alignment: start; spacing: Theme.content-gap;
                        message-area := Rectangle {
                            height: message.preferred-height;
                            accessible-role: button;
                            accessible-label: root.message + "，点击关闭";
                            accessible-action-default => { UiActions.dispatch(Intent.dismiss-notice, "", ""); }
                            message := Paragraph { width: parent.width; text: root.message; color: UiData.notice-error ? Theme.danger : Theme.ink; }
                            TouchArea { mouse-cursor: pointer; clicked => { UiActions.dispatch(Intent.dismiss-notice, "", ""); } }
                        }
                    }
                }
            }
            if UiData.notice-error: DiagnosticActions { context: root.message; notice-control: true;
                if UiData.notice-recover-network && UiData.proxy-mode != 2 && !UiData.protected && !UiData.protection-pending: ActionButton {
                    modal-control: true; notice-control: true; text: "恢复系统直连"; enabled: !UiData.working;
                    clicked => { UiActions.dispatch(Intent.proxy-mode, "2", ""); }
                }
                if UiData.notice-modal && UiData.retry-core: ActionButton { modal-control: true; notice-control: true; text: "重启内核"; primary: true; enabled: UiData.notice != "" && !UiData.working; clicked => { UiActions.dispatch(Intent.restart-core, "", ""); } }
            }
        }
    }
}

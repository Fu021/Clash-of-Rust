import { Motion, Entrance, ProgressTrack, CopyFeedback } from "motion.slint";
import { Theme, AccentPalette } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { ScrollView } from "std-widgets.slint";

// Reset on navigation, not on each model refresh. Clamp after content shrinks
// (including a shorter detail) so a previous offset cannot hide the new body.
export component PageScroll inherits ScrollView {
    in property <string> content-key;
    property <length> bottom: min(0px, self.visible-height - self.content-height);
    changed content-key => { self.content-y = 0px; }
    changed bottom => { self.content-y = clamp(self.content-y, self.bottom, 0px); }
    changed content-y => {
        if self.content-y < self.bottom || self.content-y > 0px {
            self.content-y = clamp(self.content-y, self.bottom, 0px);
        }
    }
}

export component Label {
    in property <string> text;
    in property <brush> color: Theme.ink;
    in property <length> font-size: Theme.body-size;
    in property <int> font-weight: 400;
    in property <TextVerticalAlignment> vertical-alignment: center;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextOverflow> overflow: elide;
    in property <TextWrap> wrap: no-wrap;
    out property <FontMetrics> font-metrics: glyphs.font-metrics;
    preferred-width: glyphs.preferred-width;
    preferred-height: glyphs.preferred-height;
    min-height: glyphs.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    // Center the visible letter area instead of the font's asymmetric line box.
    // Using metrics keeps icons, text and controls aligned at every font size.
    glyphs := Text {
        width: parent.width;
        height: self.preferred-height;
        y: root.vertical-alignment == top ? 0px
            : root.vertical-alignment == bottom ? parent.height - self.height
            : (parent.height - self.height) / 2
                + (self.font-metrics.cap-height - self.font-metrics.ascent - self.font-metrics.descent) / 2;
        text: root.text;
        color: root.color;
        animate color { duration: Motion.control; enabled: Motion.active; }
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: root.horizontal-alignment;
        overflow: root.overflow;
        wrap: root.wrap;
    }
}

export component Caption inherits Label {
    font-size: Theme.detail-size;
    color: Theme.muted;
}

export component Heading inherits Label {
    font-size: Theme.heading-size;
    font-weight: 600;
}

export component Paragraph inherits Label {
    wrap: word-wrap;
    vertical-alignment: top;
    // A nested box layout otherwise measures wrapped text as a single line.
    height: self.preferred-height;
}

export component Panel inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: Theme.radius-lg;
    animate background, border-color { duration: Motion.appearance; enabled: Motion.active; }
    @children
}

// Keep the padding intact when text, controls or conditional rows change size.
export component ContentPanel inherits Panel {
    in property <length> gap: Theme.content-gap;
    in property <length> vertical-padding: Theme.card-padding;
    in property <length> horizontal-padding: Theme.card-padding;
    in property <bool> interactive: false;
    callback clicked();
    vertical-stretch: 0;
    height: content.preferred-height;
    if root.interactive: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    content := VerticalLayout {
        alignment: start;
        padding-left: root.horizontal-padding; padding-right: root.horizontal-padding;
        padding-top: root.vertical-padding; padding-bottom: root.vertical-padding;
        spacing: root.gap;
        @children
    }
}

export component RowPanel inherits Panel {
    in property <bool> interactive: false;
    callback clicked();
    vertical-stretch: 0;
    height: content.preferred-height;
    if root.interactive: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    content := HorizontalLayout {
        cross-axis-alignment: center;
        padding: Theme.card-padding;
        spacing: Theme.page-gap;
        @children
    }
}

export component SettingsSection inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    height: content.preferred-height;
    content := VerticalLayout {
        alignment: start;
        spacing: 10px;
        Heading { text: root.title; height: 28px; }
        @children
    }
}

export component Chevron inherits Path {
    in property <bool> expanded: false;
    width: 12px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 12;
    property <float> direction: root.expanded ? 1 : 0;
    animate direction { duration: Motion.control; easing: ease-out; enabled: Motion.active; }
    MoveTo { x: 2; y: 4 + root.direction * 4; }
    LineTo { x: 6; y: 8 - root.direction * 4; }
    LineTo { x: 10; y: 4 + root.direction * 4; }
    stroke: Theme.secondary;
    stroke-width: 1.5px;
}

export component ActionButton inherits Rectangle {
    in property <bool> modal-control: false;
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <bool> success;
    in property <bool> dropdown: false;
    in property <bool> expanded: false;
    // Quiet variant: no outline until hovered. Used for secondary actions.
    in property <bool> ghost: false;
    in property <bool> compact: false;
    property <bool> interactive: root.enabled && !root.busy && (UiData.modal == 0 || root.modal-control);
    // Mouse activation must not leave a focus highlight that resembles selection.
    property <bool> keyboard-focus: false;
    property <bool> pressed: root.interactive && area.pressed;
    property <length> press-offset: root.pressed ? 1px : 0px;
    animate press-offset { duration: Motion.fast; easing: ease-out; enabled: Motion.active; }
    callback clicked();
    forward-focus: key-scope;
    height: root.compact ? Theme.compact-height : Theme.control-height;
    width: max(root.compact ? 27px : 55px, button-label.preferred-width + (root.compact ? 20px : 26px) + (root.dropdown ? 20px : 0px));
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: root.compact ? Theme.radius-sm : Theme.radius;
    background: root.primary ? (root.pressed ? Theme.primary.darker(0.15) : root.interactive && area.has-hover ? Theme.primary.darker(0.1) : Theme.primary)
        : root.success ? Theme.success-wash : root.selected || root.pressed ? Theme.accent-wash
        : root.interactive && area.has-hover ? (root.ghost ? Theme.hover : Theme.dark ? Theme.raised : Theme.inset)
        : root.ghost ? transparent : Theme.surface;
    border-width: 1px;
    border-color: root.interactive && root.keyboard-focus && key-scope.has-focus ? Theme.accent
        : root.primary ? Theme.primary : root.selected || root.pressed ? Theme.accent.with-alpha(0.4) : root.ghost ? transparent : Theme.line-strong;
    opacity: root.enabled || root.busy ? 1 : 0.5;
    animate background, border-color, opacity { duration: Motion.fast; enabled: Motion.active; }
    button-label := Label {
        y: root.press-offset;
        width: parent.width - (root.dropdown ? 24px : 0px);
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        font-weight: 500;
        color: root.primary ? Theme.on-primary : root.danger ? Theme.danger : root.success ? Theme.success : root.selected ? Theme.accent : root.ghost ? Theme.secondary : Theme.ink;
        font-size: Theme.body-size;
    }
    if root.dropdown: Chevron {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2 + root.press-offset;
        expanded: root.expanded;
    }
    if root.busy: ProgressTrack {
        y: parent.height - 3px; width: parent.width; indeterminate: true; track: transparent;
        fill: root.primary ? Theme.on-primary : Theme.accent;
    }
    key-scope := FocusScope {
        enabled: root.interactive;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.keyboard-focus = false; key-scope.focus(); root.clicked(); }
    }
}

// One option of a segmented control (design: .seg button). The selected option
// lifts onto the surface; the track behind the group stays neutral.
component SegmentOption inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();
    forward-focus: key-scope;
    height: Theme.compact-height;
    width: option-label.preferred-width + 26px;
    border-radius: Theme.radius-sm;
    property <bool> keyboard-focus: false;
    property <bool> interactive: root.enabled && UiData.modal == 0;
    background: root.selected ? (Theme.dark ? Theme.raised : Theme.surface) : root.interactive && area.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: root.interactive && root.keyboard-focus && key-scope.has-focus ? Theme.accent : root.selected ? Theme.line-strong : transparent;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color, opacity { duration: Motion.fast; enabled: Motion.active; }
    option-label := Label {
        width: parent.width; height: parent.height; text: root.text; horizontal-alignment: center;
        font-weight: root.selected ? 600 : 400;
        color: root.selected ? Theme.ink : Theme.secondary;
    }
    key-scope := FocusScope {
        enabled: root.interactive;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.keyboard-focus = false; key-scope.focus(); root.clicked(); }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> enabled: true;
    callback picked(int);
    height: Theme.compact-height + 6px;
    width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.track;
    animate background { duration: Motion.appearance; enabled: Motion.active; }
    row := HorizontalLayout {
        padding: 3px; spacing: 2px;
        for option[i] in root.options: SegmentOption {
            text: option; selected: i == root.current; enabled: root.enabled;
            clicked => { root.picked(i); }
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    // 0 accent, 1 success, 2 warning, 3 danger, 4 neutral.
    in property <int> tone: 0;
    in property <length> width-limit: 320px;
    height: 22px * Theme.text-scale;
    width: min(label.preferred-width + 16px, root.width-limit);
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: tone == 1 ? Theme.success-wash : tone == 2 ? Theme.warning-wash : tone == 3 ? Theme.danger-wash : tone == 4 ? Theme.inset : Theme.accent-wash;
    animate background { duration: Motion.control; enabled: Motion.active; }
    label := Caption {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.tone == 1 ? Theme.success : root.tone == 2 ? Theme.warning : root.tone == 3 ? Theme.danger : root.tone == 4 ? Theme.secondary : Theme.accent;
        font-weight: 500;
        horizontal-alignment: center;
    }
}

// Six accent swatches in a row. The ring marks the current one; nothing else
// on the page changes meaning with the accent.
export component AccentSwatches inherits Rectangle {
    in property <bool> enabled: true;
    in property <int> current;
    callback picked(int);
    height: 27px;
    width: 6 * 22px + 5 * 8px + 8px;
    horizontal-stretch: 0;
    HorizontalLayout {
        alignment: end; spacing: 8px; padding-right: 4px;
        for swatch[i] in 6: Rectangle {
            width: 22px; height: 22px;
            Rectangle {
                width: 22px; height: 22px; border-radius: 11px;
                y: (parent.height - self.height) / 2;
                background: Theme.dark ? AccentPalette.dark-colors[i] : AccentPalette.accent-colors[i];
                border-width: 1px; border-color: #00000019;
            }
            if i == root.current: Rectangle {
                x: -4px; y: -4px; width: 30px; height: 30px; border-radius: 15px;
                border-width: 1.5px; border-color: Theme.dark ? AccentPalette.dark-colors[i] : AccentPalette.accent-colors[i];
            }
            accessible-role: button;
            accessible-label: AccentPalette.accent-names[i];
            TouchArea {
                enabled: root.enabled && UiData.modal == 0;
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

export component Field inherits Rectangle {
    in property <bool> modal-control: false;
    in property <bool> enabled: true;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> secret: false;
    in property <string> focus-id;
    in property <int> focus-revision: UiData.focus-revision;
    callback edited(string);
    callback accepted();
    forward-focus: input;
    changed focus-revision => {
        if root.focus-id != "" && UiData.focus-target == root.focus-id { input.focus(); }
    }
    height: Theme.control-height;
    min-width: 100px;
    background: Theme.surface;
    opacity: root.enabled ? 1 : 0.55;
    border-radius: Theme.radius;
    border-color: input.has-focus ? Theme.accent : Theme.line-strong;
    animate border-color, background { duration: Motion.fast; enabled: Motion.active; }
    border-width: 1px;
    input := TextInput {
        x: 12px;
        y: (parent.height + placeholder-label.font-metrics.cap-height) / 2 - placeholder-label.font-metrics.ascent;
        width: parent.width - 24px;
        height: self.preferred-height;
        text <=> root.text;
        enabled: root.enabled && (UiData.modal == 0 || root.modal-control);
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        font-size: Theme.body-size;
        color: Theme.ink;
        selection-background-color: Theme.primary;
        selection-foreground-color: Theme.on-primary;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    placeholder-label := Caption {
        visible: root.text == "";
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.body-size;
        color: Theme.muted;
    }
}

export component Select inherits Rectangle {
    in property <bool> enabled: true;
    changed enabled => { if !root.enabled { popup.close(); } }
    in property <bool> modal-control: false;
    in property <[string]> options;
    in property <string> value;
    callback selected(int, string);
    height: Theme.control-height;
    min-width: 100px;
    ActionButton {
        width: parent.width;
        text: root.value;
        dropdown: true;
        modal-control: root.modal-control;
        enabled: root.enabled && root.options.length > 0;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        close-policy: close-on-click-outside;
        y: root.height + 4px;
        width: max(root.width, 180px);
        height: min(320px, root.options.length * (Theme.control-height + 4px) + 12px);
        Rectangle {
            entrance := Entrance { }
            opacity: entrance.progress;
            background: Theme.surface;
            border-color: Theme.line-strong;
            border-width: 1px;
            border-radius: Theme.radius;
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding: 8px;
                    spacing: 4px;
                    for option[i] in root.options: ActionButton {
                        enabled: root.enabled;
                        width: popup.width - 16px;
                        modal-control: root.modal-control;
                        text: option;
                        selected: option == root.value;
                        clicked => { root.selected(i, option); popup.close(); }
                    }
                }
            }
        }
    }
}

export component Toggle inherits Rectangle {
    forward-focus: toggle-focus;
    in property <bool> modal-control: false;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 34px;
    height: 21px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 11px;
    background: root.checked ? Theme.primary : Theme.line-strong;
    animate background, opacity { duration: Motion.control; enabled: Motion.active; }
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        x: root.checked ? 16px : 3px;
        animate x { duration: Motion.control; easing: ease-out; enabled: Motion.active; }
        y: 3px;
        width: 15px;
        height: 15px;
        border-radius: 8px;
        background: #ffffff;
    }
    toggle-focus := FocusScope {
        enabled: root.enabled && (UiData.modal == 0 || root.modal-control);
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled && (UiData.modal == 0 || root.modal-control);
        mouse-cursor: pointer;
        clicked => { toggle-focus.focus(); root.toggled(!root.checked); }
    }
}

export component SettingRow inherits Rectangle {
    in property <bool> modal-control: false;
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: max(Theme.control-height, content.preferred-height);
    content := HorizontalLayout {
        cross-axis-alignment: center;
        spacing: Theme.page-gap;
        VerticalLayout {
            spacing: 4px;
            Label { text: root.title; }
            if root.description != "": Caption { text: root.description; }
        }
        Toggle {
            modal-control: root.modal-control;
            enabled: root.enabled && (UiData.modal == 0 || root.modal-control);
            checked: root.checked;
            toggled(value) => { root.toggled(value); }
        }
    }
}

// Settings list row (design: .set-row): title and optional hint on the left,
// the control on the right. Rows sit inside a ListPanel and are separated by Dividers.
export component FormRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    vertical-stretch: 0;
    height: max(55px, content.preferred-height);
    content := HorizontalLayout {
        padding-left: Theme.card-padding; padding-right: Theme.card-padding;
        padding-top: 13px; padding-bottom: 13px;
        cross-axis-alignment: center;
        spacing: Theme.card-padding;
        VerticalLayout {
            horizontal-stretch: 1; spacing: 1px; alignment: center;
            Label { text: root.title; font-weight: 500; }
            if root.hint != "": Caption { text: root.hint; }
        }
        HorizontalLayout { spacing: Theme.content-gap; alignment: end; cross-axis-alignment: center; horizontal-stretch: 0; @children }
    }
}

// A card whose rows run edge to edge and are divided by hairlines.
export component ListPanel inherits ContentPanel {
    vertical-padding: 0px;
    horizontal-padding: 0px;
    gap: 0px;
    clip: true;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component CopyButton inherits ActionButton {
    in property <string> value;
    in property <string> label: "复制";
    in property <Intent> intent: Intent.copy;
    width: max(88px, measure.preferred-width + 28px);
    measure := Label { visible: false; text: root.label; }
    feedback := CopyFeedback { revision: UiData.copy-revision; acknowledged: UiData.copy-value; value: root.value; any-value: root.intent != Intent.copy; }
    text: feedback.copied ? "已复制" : root.label;
    success: feedback.copied;
    clicked => { feedback.requested(); UiActions.dispatch(root.intent, root.value, ""); }
}

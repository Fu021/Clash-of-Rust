// The production component, with isolated example values for the Rust-free viewer.
import { AppWindow } from "app.slint";
import { UiData } from "state.slint";
import { Motion } from "components/motion.slint";
import { PageViews } from "components/view-toggle.slint";
import "../../../resources/fonts/NotoColorEmoji-Regular.ttf";

export component Preview inherits AppWindow {
    in-out property <bool> preview-long-names;
    property <string> long-name: "🚀 这是一份用于检验超长配置名称不会挤压状态和操作按钮的订阅 · 日本东京专线 / IPv6 / VeryLongUnbrokenConfigurationName0123456789";
    changed preview-long-names => {
        if root.preview-long-names {
            UiData.profile = root.long-name; UiData.node = root.long-name;
            UiData.profiles[0].name = root.long-name;
            UiData.groups[0].title = root.long-name;
            UiData.groups[0].current = root.long-name;
            UiData.groups[0].nodes = [{left: {group: "Proxy", name: root.long-name, kind: "AnyTLS", delay: "45 ms", tone: 1, selected: true, valid: true},
                right: {group: "Proxy", name: "🇯🇵 日本 01", kind: "VLESS", delay: "28 ms", tone: 1, valid: true}}];
        }
    }
    in-out property <string> preview-network-alert;
    changed preview-network-alert => { UiData.network-alert = root.preview-network-alert; }
    in-out property <bool> preview-motion;
    changed preview-motion => { Motion.enabled = root.preview-motion; }
    in-out property <bool> preview-sidebar-collapsed <=> root.sidebar-collapsed;
    in-out property <bool> preview-list-view;
    changed preview-list-view => { PageViews.nodes-list = root.preview-list-view; PageViews.profiles-list = root.preview-list-view; }
    in-out property <int> preview-page <=> UiData.page;
    changed preview-page => {
        let count = root.preview-page == 2 ? UiData.profiles.length : root.preview-page == 4 ? UiData.rules.length : UiData.connections.length;
        UiData.page-status = count == 0 ? "0 条" : count + " 条 · 1–" + count;
    }
    in-out property <bool> preview-fake-ip-editor;
    changed preview-fake-ip-editor => { UiData.fake-ip-editor = root.preview-fake-ip-editor; }
    in-out property <bool> preview-dark <=> UiData.dark;
    in-out property <int> preview-text-scale <=> UiData.text-scale;
    in-out property <int> preview-accent <=> UiData.accent;
    in-out property <string> preview-notice <=> UiData.notice;
    in-out property <bool> preview-notice-error <=> UiData.notice-error;
    in-out property <bool> preview-notice-critical <=> UiData.notice-critical;
    in-out property <bool> preview-notice-recover-network <=> UiData.notice-recover-network;
    in-out property <bool> preview-core-running <=> UiData.running;
    changed preview-core-running => { UiData.retry-core = !root.preview-core-running; }
    in-out property <string> preview-modal-error <=> UiData.modal-error;
    in-out property <float> preview-notice-elapsed <=> UiData.notice-elapsed;
    in-out property <bool> preview-protection-pending <=> UiData.protection-pending;
    in-out property <bool> preview-protected <=> UiData.protected;
    changed preview-protected => { UiData.proxy-mode = root.preview-protected ? 1 : 0; }
    in-out property <int> preview-protection-health <=> UiData.protection-health;
    in-out property <string> preview-protection-message <=> UiData.protection-message;
    in-out property <bool> preview-update-prereleases <=> UiData.update-prereleases;
    in-out property <bool> preview-sites-report <=> UiData.sites-report;
    in-out property <int> preview-claude-filter <=> UiData.claude-filter;
    in-out property <int> dialog;
    in-out property <bool> preview-shortcuts <=> root.rule-shortcuts-open;
    in-out property <length> preview-rules-scroll <=> UiData.scroll-rules;
    in-out property <length> preview-home-scroll <=> UiData.scroll-home;
    in-out property <length> preview-proxies-scroll <=> UiData.scroll-proxies;
    in-out property <length> preview-profiles-scroll <=> UiData.scroll-profiles;
    in-out property <length> preview-connections-scroll <=> UiData.scroll-connections;
    in-out property <length> preview-logs-scroll <=> UiData.scroll-logs;
    in-out property <length> preview-network-scroll <=> UiData.scroll-network;
    in-out property <length> preview-sites-scroll <=> UiData.scroll-sites;
    in-out property <length> preview-claude-scroll <=> UiData.scroll-claude;
    in-out property <length> preview-settings-scroll <=> UiData.scroll-settings;
    in-out property <bool> raw-rule <=> UiData.rule-text-mode;
    changed dialog => {
        UiData.modal = root.dialog == 1 || root.dialog == 2 ? 1 : root.dialog == 3 ? 7 : root.dialog == 5 ? 2 : root.dialog == 6 ? 11 : root.dialog == 10 ? 12 : root.dialog == 11 ? 10 : root.dialog;
        UiData.modal-can-accept = true;
        UiData.modal-title = root.dialog == 1 ? "删除订阅？" : root.dialog == 2 ? "放弃未保存的修改？" : root.dialog == 3 ? "开启 Claude 保护？" : root.dialog == 4 ? "新建规则" : root.dialog == 5 ? "编辑订阅" : root.dialog == 6 ? "Netflix · 检测详情" : root.dialog == 11 ? "连接详情" : "强调色";
        UiData.modal-description = root.dialog == 1 ? "将删除“备用订阅”及其配置文件。此操作无法撤销。" : root.dialog == 2 ? "尚有未应用的修改。放弃后将恢复已保存的规则。" : root.dialog == 3 ? "将固定当前节点，启用 TUN、代理 DNS、广泛规则与实时拦截，并关闭当前内核连接。共享服务可能影响其他应用，关闭后恢复原设置。" : root.dialog == 6 ? "检测结果：确认可用\n识别地区：德国\n响应时间：128 ms\n\n以下为固定演示数据，不代表真实网络检测。" : "";
        UiData.modal-accept = root.dialog == 1 ? "删除订阅" : root.dialog == 2 ? "放弃修改" : root.dialog == 3 ? "开启保护" : root.dialog == 10 ? "完成" : root.dialog == 6 || root.dialog == 11 ? "" : "保存";
        UiData.modal-danger = root.dialog == 1 || root.dialog == 2;
        if root.dialog == 13 {
            UiData.modal-title = "日志详情";
            UiData.modal-description = "[内核] time=\"2026-10-23T16:30:34Z\" level=warning\n[TCP] dial DIRECT example.test:443\n连接失败：connection timed out\n\n可在此查看完整日志，并使用下方按钮复制全文。";
            UiData.modal-copy = UiData.modal-description;
            UiData.modal-accept = "";
        }
        if root.dialog == 12 {
            UiData.modal = 1;
            UiData.modal-title = "安装预发布版 0.6.8-dev.1.example？";
            UiData.modal-description = "预发布版本可能存在尚未发现的风险与 Bug，可能导致程序崩溃、网络异常或配置兼容问题。建议先备份配置，确认后再下载安装。";
            UiData.modal-accept = "继续安装（3 秒）";
            UiData.modal-can-accept = false;
            UiData.update-prereleases = true;
            UiData.update-status = "发现预发布版 0.6.8-dev.1.example";
        }
        if root.dialog >= 7 && root.dialog <= 9 {
            UiData.modal = 0;
            UiData.claude-filter = root.dialog == 7 ? 1 : root.dialog == 8 ? 0 : 2;
        }
    }
    init => {
        Motion.enabled = root.preview-motion;
        UiData.fake-ip-editor = root.preview-fake-ip-editor;
        UiData.version = "0.7.0";
        UiData.ready = true; UiData.running = true;
        UiData.profile = root.preview-long-names ? root.long-name : "我的订阅"; UiData.node = root.preview-long-names ? root.long-name : "🇩🇪 德国 01 · IPv6";
        UiData.download-rate = "1.24 MiB/s"; UiData.upload-rate = "28.6 KiB/s";
        UiData.connection-count = "24"; UiData.download-total = "386 MiB"; UiData.upload-total = "21.7 MiB";
        UiData.overview-status = "可访问 7 / 8";
        UiData.overview-network = [

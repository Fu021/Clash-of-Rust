            {label: "连接 ID", value: "9f1a0f02-d63e-4cfe-832e-4ed947af10de"}];
        UiData.connection-selected-id = "9f1a0f02-d63e-4cfe-832e-4ed947af10de";
        UiData.page-status = "3 条 · 1–3";
        UiData.groups = [{id: "Proxy", title: root.preview-long-names ? root.long-name : "🚀 Proxy 策略 ❤️", detail: "Selector · 10 个节点", current: root.preview-long-names ? root.long-name : "🇩🇪 德国 01 · IPv6", expanded: true, testing: false, page: "10 个节点 · 1–10", previous: false, next: false,

            {id: "exit", title: "出口 IP", value: "203.0.113.42", detail: "德国", delay: "188 ms", delay-tone: 1, tone: 1, flag: "🇩🇪", flagged: true},
            {id: "dns", title: "DNS 服务器", value: "223.5.5.5  119.29.29.29", detail: "系统解析器配置", tone: 0},
            {id: "lookup", title: "DNS 解析", value: "github.com → 198.18.0.12", detail: "Fake-IP", delay: "12 ms", delay-tone: 1, tone: 1}];
        UiData.overview-services = [
            {id: "google", title: "Google", value: "142 ms", delay: "142 ms", delay-tone: 1, detail: "HTTP 204", tone: 1},
            {id: "youtube", title: "YouTube", value: "156 ms", delay: "156 ms", delay-tone: 1, detail: "HTTP 204", tone: 1},
            {id: "github", title: "GitHub", value: "311 ms", delay: "311 ms", delay-tone: 2, detail: "HTTP 200", tone: 1},
            {id: "chatgpt", title: "ChatGPT", value: "264 ms", delay: "264 ms", delay-tone: 1, detail: "HTTP 403 · 可达", tone: 2},
            {id: "claude", title: "Claude", value: "233 ms", delay: "233 ms", delay-tone: 1, detail: "HTTP 307", tone: 1},
            {id: "gemini", title: "Gemini", value: "1260 ms", delay: "1260 ms", delay-tone: 3, detail: "HTTP 200", tone: 1},
            {id: "telegram", title: "Telegram", value: "无法连接", detail: "未获得响应", tone: 3},
            {id: "x", title: "X", value: "402 ms", delay: "402 ms", delay-tone: 2, detail: "HTTP 200", tone: 1}];
        UiData.protection-status = "正在开启保护，切换 TUN、规则与 DNS…";
        UiData.connection-details = [

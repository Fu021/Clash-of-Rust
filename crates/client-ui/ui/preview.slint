                {left: {group: "Proxy", name: "日本 02 · 备用入口 · 用于确认完整名称不会丢失", kind: "Trojan", delay: "超时", tone: 3, valid: true}, right: {group: "Proxy", name: "US-美国 02", kind: "VLESS", delay: "128 ms", tone: 1, valid: true}},
                {left: {group: "Proxy", name: "👩🏽‍💻 新加坡 02", kind: "Shadowsocks", delay: "78 ms", tone: 1, valid: true}, right: {group: "Proxy", name: "😀 德国 02", kind: "VLESS", delay: "176 ms", tone: 2, valid: true}}
            ]}];
        UiData.profiles = [
            {id: "main", name: root.preview-long-names ? root.long-name : "我的订阅", source: "https://example.com/subscription", detail: "已用 2.4/100 GiB · 到期 2026-12-31 · 更新 10-15 10:30", active: true, local: false},
            {id: "backup", name: "备用订阅", source: "https://example.org/sub", detail: "已用 1/50 GiB · 不限期 · 更新 10-14 18:20", active: false, local: false},
            {id: "default", name: "默认直连", source: "default.yaml", detail: "本地配置", active: false, local: true, builtin: true},
            {id: "daily", name: "日常备用", source: "https://example.net/daily", detail: "已用 12/80 GiB · 到期 2026-12-01 · 更新 11-05 11:00", active: false, local: false},
            {id: "testing", name: "测试线路 · 用于检查长订阅名称与来源详情", source: "https://example.com/testing/long-source-path", detail: "已用 8/60 GiB · 不限期 · 更新 11-05 10:30", active: false, local: false},
            {id: "overseas", name: "海外线路", source: "https://example.org/overseas", detail: "流量信息未提供 · 更新 11-04 15:20", active: false, local: false},
            {id: "backup-c", name: "本地导入的配置", source: "", detail: "本地配置", active: false, local: true}];
        UiData.connections = [
            {id: "1", host: "api.github.com:443", detail: "tcp · 10:31:20", rule: "DOMAIN-SUFFIX github.com", route: "Proxy → 德国 01", up: "2.4 KiB/s", down: "128 KiB/s", upload: "24 KiB", download: "1.8 MiB"},
            {id: "2", host: "www.google.com:443", detail: "tcp · 10:31:24", rule: "MATCH", route: "Proxy → 德国 01", up: "1.8 KiB/s", down: "86 KiB/s", upload: "18 KiB", download: "980 KiB"},

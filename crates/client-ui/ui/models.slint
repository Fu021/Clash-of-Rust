export struct DetailItem { label: string, value: string }
export struct FakeIpExclusionItem { domain: string, source: string }
export struct NodeItem { group: string, name: string, kind: string, delay: string, tone: int, selected: bool, valid: bool, details: string }
export struct NodePair { left: NodeItem, right: NodeItem }
export struct GroupItem { id: string, title: string, detail: string, current: string, expanded: bool, testing: bool, page: string, previous: bool, next: bool, nodes: [NodePair] }
export struct ProfileItem { id: string, name: string, source: string, detail: string, active: bool, local: bool, builtin: bool }
export struct ConnectionItem { id: string, host: string, detail: string, rule: string, route: string, up: string, down: string, upload: string, download: string }
export struct RuleItem { id: string, position: string, kind: string, value: string, policy: string, source: string, selected: bool, enabled: bool, raw: string }
export struct LogItem { time: string, level: string, message: string, tone: int }
export struct ReportItem { id: string, title: string, value: string, country: string, detail: string, source: string, status-label: string, tone: int, flag: string, flagged: bool, delay: string, delay-tone: int, block-items: int }
export struct OverviewItem { id: string, title: string, value: string, detail: string, tone: int, flag: string, flagged: bool, fogged: bool, delay: string, delay-tone: int }
export struct CategoryItem { id: string, title: string, count: string, detail: string, tone: int }
export struct CategoryPair { left: CategoryItem, right: CategoryItem }

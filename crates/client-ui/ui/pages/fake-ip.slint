import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, Heading, ActionButton, Field } from "../components/controls.slint";

// A focused settings subpage: the list is the only content under the header,
// and each row keeps just the domain and its remove action.
export component FakeIpPage inherits Rectangle {
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-right: Theme.content-gap;
        padding-bottom: Theme.card-padding;
        spacing: Theme.page-gap;
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: Theme.content-gap;
            ActionButton { text: "← 返回设置"; clicked => { UiActions.dispatch(Intent.fake-ip-editor, "false", ""); } }
            Heading { text: "Fake-IP 排除项"; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            cross-axis-alignment: center;
            spacing: Theme.content-gap;
            Field {
                text <=> UiData.fake-ip-input;
                placeholder: "example.com 或 +.example.com";
                enabled: UiData.dns-override && !UiData.working;
                accepted => { if UiData.dns-override && !UiData.working { UiActions.dispatch(Intent.fake-ip-add, "", ""); } }
            }
            ActionButton {
                text: "添加";
                primary: true;
                enabled: UiData.dns-override && !UiData.working;
                clicked => { UiActions.dispatch(Intent.fake-ip-add, "", ""); }
            }
        }
        VerticalLayout {
            spacing: 4px;
            Caption { text: "格式：example.com、+.example.com 或 *.example.com；多个用逗号分隔。"; wrap: word-wrap; }
            if UiData.fake-ip-error != "": Caption { text: UiData.fake-ip-error; color: Theme.warning; wrap: word-wrap; }
        }
        PageScroll {
            vertical-stretch: 1;
            min-height: 0px;
            x: 0px;
            width: parent.width + Theme.content-gap;
            VerticalLayout {
                alignment: start;
                padding-right: Theme.content-gap;
                spacing: Theme.content-gap;
                for domain[i] in UiData.fake-ip-exclusions: Rectangle {
                    height: Theme.control-height + 16px;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.line;
                    HorizontalLayout {
                        padding: Theme.content-gap;
                        spacing: Theme.content-gap;
                        cross-axis-alignment: center;
                        Label { text: domain; }
                        ActionButton {
                            text: "删除";
                            danger: true;
                            enabled: UiData.dns-override && !UiData.working;
                            clicked => { UiActions.dispatch(Intent.fake-ip-remove, "" + i, ""); }
                        }
                    }
                }
                if UiData.fake-ip-exclusions.length == 0: Label {
                    text: "暂无排除项";
                    color: Theme.secondary;
                    height: Theme.control-height;
                }
            }
        }
    }
}

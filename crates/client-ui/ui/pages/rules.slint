import { PageSurface } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent, RuleItem } from "../state.slint";
import { RuleDragHandle } from "../components/rule-drag.slint";
import { ListReorderGesture, ListReorderPreview } from "../components/list-reorder.slint";
import { GeometryTarget } from "../components/geometry.slint";
import { PageScroll, Label, Caption, Heading, ContentPanel, ActionButton, Badge, Field, Toggle, Select, Paragraph, CopyButton } from "../components/controls.slint";
component RulesRow inherits Rectangle {
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    property <bool> protection-locked: UiData.protected || UiData.protection-pending;
    changed protection-locked => { if root.protection-locked { menu.close(); } }
    in property <RuleItem> item;
    in property <string> drag-context;
    in property <bool> highlighted;
    in property <bool> floating;
    in property <bool> wide;
    in property <bool> show-source;
    in property <length> available-height;
    in property <length> policy-width-limit;
    callback started();
    callback dragged(int);
    callback dropped(int);
    callback cancelled();
    background: root.floating || root.highlighted || root.item.selected ? Theme.accent-wash : Theme.surface;
    border-radius: root.floating ? 6px : 0px;
    border-width: root.floating ? 1px : 0px; border-color: Theme.accent;
    if !root.floating: TouchArea {
        enabled: !UiData.protected && !UiData.protection-pending && !UiData.working && UiData.modal == 0;
        clicked => { UiActions.dispatch(Intent.rule-select, root.item.id, ""); }
    }
    HorizontalLayout { cross-axis-alignment: center; padding: Theme.content-gap; spacing: Theme.content-gap;
        RuleDragHandle {
            row-height: root.height + Theme.content-gap;
            context: root.drag-context;
            enabled: !UiData.protected && !UiData.protection-pending && !root.floating && !UiData.working && !UiData.exiting && UiData.rule-types.length > 0;
            blocked: UiData.modal != 0;
            started => { root.started(); }
            dragged(delta) => { root.dragged(delta); }
            dropped(delta) => { root.dropped(delta); }
            cancelled => { root.cancelled(); }
        }
        Caption { text: root.item.position; width: 24px; horizontal-stretch: 0; }
        VerticalLayout { spacing: 4px; horizontal-stretch: 1;
            if root.wide: HorizontalLayout { spacing: 8px;
                Caption { text: root.item.kind; width: 118px; horizontal-stretch: 0; }
                Label { text: root.item.value; font-size: Theme.detail-size; opacity: root.item.enabled ? 1 : 0.5; }
            }
            if !root.wide: Label { text: root.item.value == "" ? root.item.kind : root.item.value; font-size: Theme.detail-size; opacity: root.item.enabled ? 1 : 0.5; }
            if !root.wide: Caption { text: root.item.kind + " · " + root.item.source; font-size: 12px * Theme.text-scale; }
        }
        if root.show-source: Caption { text: root.item.source; width: 56px; horizontal-stretch: 0; }
        Badge { text: root.item.policy; width-limit: root.policy-width-limit; }
        Toggle {
            checked: root.item.enabled;
            enabled: root.item.source == "自定义" && !UiData.protected && !UiData.protection-pending && !root.floating && !UiData.working;
            toggled(value) => { UiActions.dispatch(Intent.rule-select, root.item.id, ""); UiActions.dispatch(Intent.rule-enable, "", ""); }
        }
        ActionButton {
            text: ""; width: 40px; selected: root.item.selected;
            accessible-role: button; accessible-label: "规则详情与操作"; enabled: !UiData.protected && !UiData.protection-pending && (!root.floating && !UiData.working);
            Image { source: @image-url("../icons/chevron-right.svg"); colorize: Theme.secondary; width: 18px; height: 18px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
            clicked => { UiActions.dispatch(Intent.rule-select, root.item.id, ""); menu.show(); }
        }
    }
    menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: max(0px, root.width - self.width); y: root.height;
        width: min(320px, root.width); height: min(actions.preferred-height, max(160px, root.available-height - 48px));
        Rectangle {
            background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: 6px;
            PageScroll {
                actions := VerticalLayout {
                    padding: 8px; spacing: 4px;
                    Paragraph { text: root.item.kind + (root.item.value == "" ? "" : " · " + root.item.value) + " → " + root.item.policy; }
                    Caption { text: "来源：" + root.item.source + (root.item.enabled ? " · 已启用" : " · 已停用"); }
                    CopyButton { enabled: !UiData.protected && !UiData.protection-pending; label: "复制规则原文"; value: root.item.raw; }
                    Paragraph { text: root.item.raw; }
                    ActionButton { text: "编辑"; enabled: !UiData.protected && !UiData.protection-pending && root.item.source == "自定义" && !UiData.working;
                        clicked => { menu.close(); UiActions.dispatch(Intent.rule-edit, "", ""); } }
                    ActionButton { text: root.item.enabled ? "停用" : "启用"; enabled: !UiData.protected && !UiData.protection-pending && root.item.source == "自定义" && !UiData.working;
                        clicked => { menu.close(); UiActions.dispatch(Intent.rule-enable, "", ""); } }
                    ActionButton { text: "删除"; danger: true; enabled: !UiData.protected && !UiData.protection-pending && root.item.source == "自定义" && !UiData.working;
                        clicked => { menu.close(); UiActions.dispatch(Intent.rule-delete, "", ""); } }
                    ActionButton { text: "跨页移动到位置…"; enabled: !UiData.protected && !UiData.protection-pending && !UiData.working;
                        clicked => { menu.close(); UiActions.dispatch(Intent.rule-move-open, "", ""); } }
                    ActionButton { text: "恢复订阅顺序"; enabled: !UiData.protected && !UiData.protection-pending && !UiData.working;
                        clicked => { menu.close(); UiActions.dispatch(Intent.rule-restore, "", ""); } }
                }
            }
        }
    }
}
export component RulesPage inherits PageSurface {
    locked: UiData.protected || UiData.protection-pending;
    property <string> drag-id;
    property <string> drag-target;
    property <RuleItem> drag-item;
    property <length> row-extent: max(root.width >= 740px ? 44px : 56px, Theme.body-size * 2.5 + 8px) + Theme.content-gap;
    property <string> drag-context: UiData.page-offset + "/" + UiData.query + "/" + UiData.rule-profile + "/" + UiData.rule-source
        + "/" + (root.width / 1px) + "/" + (root.height / 1px) + "/" + Theme.text-scale;
    changed drag-context => { root.drag-id = ""; root.drag-target = ""; }
    VerticalLayout {
        spacing: Theme.page-gap;
        Rectangle {
            min-height: 0px; vertical-stretch: 1;
            scroll := PageScroll {
                x: 0px; width: parent.width + Theme.content-gap; height: parent.height;
                content-key: UiData.page-offset + "/" + UiData.query + "/" + UiData.rule-profile;
                content-y <=> UiData.scroll-rules;
                VerticalLayout {
                    alignment: start; padding-right: Theme.content-gap; spacing: Theme.page-gap;
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Select { geometry-key: "rule-profile"; enabled: !UiData.protected && !UiData.protection-pending; options: UiData.rule-profile-options; value: UiData.rule-profile; selected(index, value) => { UiActions.dispatch(Intent.rule-profile, UiData.rule-profiles[index].id, ""); } }
                        Badge { text: UiData.rule-dirty ? "尚未应用" : "已载入"; tone: UiData.rule-dirty ? 2 : 1; }
                    }
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Field { enabled: !UiData.protected && !UiData.protection-pending; placeholder: "搜索规则类型、内容或策略"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
                        Select { geometry-key: "rule-source"; enabled: !UiData.protected && !UiData.protection-pending; width: 120px; horizontal-stretch: 0; options: ["全部来源", "自定义", "快捷规则", "订阅"]; value: UiData.rule-source; selected(index, value) => { UiActions.dispatch(Intent.rule-filter, "" + index, ""); } }
                        ActionButton { text: "+ 新建规则"; primary: true; enabled: !UiData.protected && !UiData.protection-pending && UiData.rule-types.length > 0 && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-add, "", ""); } }
                    }
                    Caption { text: "拖动手柄排序 · 靠近边缘自动滚动 · Esc 取消 · 右箭头详情"; wrap: word-wrap; }
                    rules := ContentPanel {
                        for rule[index] in UiData.rules: RulesRow {
                            height: root.row-extent - Theme.content-gap;
                            item: rule; drag-context: root.drag-context; available-height: root.height;
                            wide: root.width >= 740px; show-source: root.width >= 900px;
                            policy-width-limit: root.width * 0.2;
                            highlighted: root.drag-target == rule.id;
                            opacity: gesture.reordering && gesture.drag-index == index ? 0.25 : 1;
                            started => { root.drag-item = rule; root.drag-id = rule.id; root.drag-target = rule.id; }
                            dragged(delta) => { root.drag-target = UiData.rules[clamp(index + delta, 0, UiData.rules.length - 1)].id; }
                            dropped(delta) => {
                                let source = root.drag-id;
                                root.drag-id = ""; root.drag-target = "";
                                if delta != 0 && source != "" {
                                    UiActions.dispatch(Intent.rule-drop, source, UiData.rules[clamp(index + delta, 0, UiData.rules.length - 1)].id);
                                }
                            }
                            cancelled => { root.drag-id = ""; root.drag-target = ""; }
                        }
                        if UiData.rules.length == 0: Caption { text: "没有匹配的规则"; height: Theme.control-height; }
                    }
                    if UiData.rule-warning != "": ContentPanel { Paragraph { text: UiData.rule-warning; color: Theme.warning; } }
                }
            }
            ListReorderPreview {
                x: scroll.x + rules.x + Theme.card-padding; y: scroll.y;
                width: rules.width - Theme.card-padding * 2; height: scroll.visible-height;
                active: gesture.reordering; row-y: gesture.drag-y;
                row-height: root.row-extent - Theme.content-gap;
                if gesture.reordering: RulesRow {
                    x: 0px; y: 0px; width: parent.width; height: root.row-extent - Theme.content-gap;
                    item: root.drag-item; floating: true; policy-width-limit: root.width * 0.2;
                    wide: root.width >= 740px; show-source: root.width >= 900px;
                }
            }
            gesture := ListReorderGesture {
                GeometryTarget { key: "rule-drag"; bounds: [gesture.absolute-position.x, gesture.absolute-position.y + gesture.header-height + gesture.scroll-y, gesture.width, gesture.row-height]; }
                x: scroll.x + rules.x + Theme.card-padding + Theme.content-gap; y: scroll.y;
                width: 24px; height: scroll.visible-height; hold-duration: 0ms;
                enabled: !UiData.protected && !UiData.protection-pending && !UiData.working && !UiData.exiting && UiData.rule-types.length > 0 && UiData.modal == 0;
                cancel-requested: root.drag-id == "";
                context: root.drag-context;
                row-count: UiData.rules.length; row-height: root.row-extent;
                header-height: rules.y + Theme.card-padding;
                scroll-content-height: scroll.content-height; scroll-y <=> scroll.content-y;
                started(index) => { root.drag-item = UiData.rules[index]; root.drag-id = root.drag-item.id; root.drag-target = root.drag-id; }
                targeted(index) => { root.drag-target = UiData.rules[index].id; }
                dropped(source, target) => {
                    let id = root.drag-id;
                    root.drag-id = ""; root.drag-target = "";
                    if source != target && id != "" { UiActions.dispatch(Intent.rule-drop, id, UiData.rules[target].id); }
                }
                cancelled => { root.drag-id = ""; root.drag-target = ""; }
            }
        }
        if UiData.rule-dirty: ContentPanel {
            vertical-padding: 8px;
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Caption { text: "● 修改尚未应用"; color: Theme.warning; }
                ActionButton { text: "放弃"; compact: true; quiet: true; enabled: !UiData.protected && !UiData.protection-pending && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-discard, "", ""); } }
                ActionButton { text: "应用修改"; compact: true; primary: true; enabled: !UiData.protected && !UiData.protection-pending && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-apply, "", ""); } }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Caption { text: UiData.page-status; }
            ActionButton { text: "上一页"; compact: true; enabled: !UiData.protected && !UiData.protection-pending && UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
            ActionButton { text: "下一页"; compact: true; enabled: !UiData.protected && !UiData.protection-pending && UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
        }
    }
}

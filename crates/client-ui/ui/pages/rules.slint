import { Theme, Demo } from "../theme/palette.slint";
import { Label, Caption, Heading, Panel, ActionButton, Badge, Field, Toggle, Divider } from "../components/controls.slint";

component QuickRule inherits Rectangle {
    in property <string> title;
    property <bool> enabled: false;
    height: 38px;
    HorizontalLayout {
        Label { text: root.title; font-size: 13px; }
        Toggle { checked: root.enabled; toggled(value) => { root.enabled = value; } }
    }
}

export component RulesPage inherits Rectangle {
    callback request-dialog(int);
    property <bool> shortcuts-open: false;
    VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            Heading { text: Demo.profile; }
            Badge { text: "当前使用中"; tone: 1; }
            ActionButton { text: "放弃修改"; clicked => { root.request-dialog(2); } }
            ActionButton { text: "应用修改"; primary: true; }
        }
        Panel {
            height: root.shortcuts-open ? 294px : 60px;
            VerticalLayout {
                padding: 14px; spacing: 8px;
                HorizontalLayout {
                    Label { text: "快捷规则"; }
                    Caption { text: "仅补充订阅缺少的规则，补充的规则优先匹配"; }
                    ActionButton { text: root.shortcuts-open ? "收起 ⌃" : "展开 ⌄"; clicked => { root.shortcuts-open = !root.shortcuts-open; } }
                }
                if root.shortcuts-open: VerticalLayout {
                    for rule in ["广告拦截 · category-ads-all", "私有域名直连 · private", "私有 IP 直连 · Private", "国内域名直连 · CN", "国内 IP 直连 · CN"]: QuickRule { title: rule; }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Field { placeholder: "搜索规则类型、内容或策略"; }
            ActionButton { text: "+ 新建规则"; primary: true; clicked => { root.request-dialog(4); } }
        }
        Panel {
            vertical-stretch: 1;
            min-height: 290px;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 42px; background: Theme.inset;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                        Caption { text: "顺序"; width: 42px; }
                        Caption { text: "类型"; width: 145px; }
                        Caption { text: "匹配内容"; }
                        Caption { text: "策略"; width: 96px; }
                        Caption { text: "操作"; width: 90px; }
                    }
                }
                for rule[i] in [
                    {kind: "DOMAIN-SUFFIX", value: "github.com", policy: "代理选择"},
                    {kind: "DOMAIN-SUFFIX", value: "google.com", policy: "代理选择"},
                    {kind: "DOMAIN", value: "localhost", policy: "DIRECT"},
                    {kind: "GEOIP", value: "CN", policy: "DIRECT"},
                    {kind: "MATCH", value: "—", policy: "代理选择"}
                ]: Rectangle {
                    height: 52px; background: mod(i, 2) == 0 ? Theme.surface : Theme.inset;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                        Caption { text: i + 1; width: 42px; }
                        Caption { text: rule.kind; width: 145px; }
                        Label { text: rule.value; font-size: 13px; }
                        Label { text: rule.policy; width: 96px; color: rule.policy == "DIRECT" ? Theme.success : Theme.accent; font-size: 13px; }
                        ActionButton { text: "编辑  ↑ ↓"; width: 90px; clicked => { root.request-dialog(4); } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Caption { text: "从上到下依次匹配 · 调整后的规则在应用修改后生效"; }
    }
}

import { PageSurface, Disclosure } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { RuleDragHandle } from "../components/rule-drag.slint";
import { ListReorderGesture } from "../components/list-reorder.slint";
import { PageScroll, Label, Caption, Heading, ContentPanel, ActionButton, Badge, Field, Toggle, Select, Paragraph, CopyButton } from "../components/controls.slint";
export component RulesPage inherits PageSurface {
    property <string> drag-id;
    property <string> drag-target;
    property <length> row-extent: max(60px, Theme.body-size * 3 + 12px) + Theme.content-gap;
    property <string> drag-context: UiData.page-offset + "/" + UiData.query + "/" + UiData.rule-profile + "/" + UiData.rule-source
        + "/" + (root.width / 1px) + "/" + (root.height / 1px) + "/" + Theme.text-scale;
    changed drag-context => { root.drag-id = ""; root.drag-target = ""; }
    VerticalLayout {
        spacing: Theme.page-gap;
        Rectangle {
            min-height: 0px; vertical-stretch: 1;
            scroll := PageScroll {
                x: 0px; width: parent.width + Theme.content-gap; height: parent.height;
                content-key: UiData.page-offset + "/" + UiData.query + "/" + UiData.rule-profile;
                viewport-y <=> UiData.scroll-rules;
                VerticalLayout {
                    alignment: start; padding-right: Theme.content-gap; spacing: Theme.page-gap;
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Select { options: UiData.rule-profile-options; value: UiData.rule-profile; selected(index, value) => { UiActions.dispatch(Intent.rule-profile, UiData.rule-profiles[index].id, ""); } }
                        Badge { text: UiData.rule-dirty ? "尚未应用" : "已载入"; tone: UiData.rule-dirty ? 2 : 1; }
                        ActionButton { text: "放弃修改"; enabled: UiData.rule-dirty && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-discard, "", ""); } }
                        ActionButton { text: "应用修改"; primary: true; enabled: UiData.rule-dirty && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-apply, "", ""); } }
                    }
                    ContentPanel {
                        vertical-padding: Theme.content-gap;
                        gap: Theme.content-gap * shortcuts.opacity;
                        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                            Label { text: "快捷规则"; }
                            ActionButton { text: UiData.shortcuts-open ? "收起" : "展开"; dropdown: true; expanded: UiData.shortcuts-open; clicked => { UiActions.dispatch(Intent.rule-collapse, "", ""); } }
                        }
                        shortcuts := Disclosure { expanded: UiData.shortcuts-open;
                            if shortcuts.mounted: VerticalLayout {
                                spacing: Theme.content-gap;
                                for title[i] in UiData.shortcuts: Rectangle {
                                    height: Theme.control-height;
                                    HorizontalLayout { cross-axis-alignment: center;
                                        Label { text: title; }
                                        Toggle { enabled: UiData.shortcut-available[i] && !UiData.working; checked: UiData.shortcut-values[i]; toggled(value) => { UiActions.dispatch(Intent.rule-toggle, "" + i, value ? "true" : "false"); } }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Field { placeholder: "搜索规则类型、内容或策略"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
                        Select { width: 120px; horizontal-stretch: 0; options: ["全部来源", "自定义", "快捷规则", "订阅"]; value: UiData.rule-source; selected(index, value) => { UiActions.dispatch(Intent.rule-filter, "" + index, ""); } }
                        ActionButton { text: "+ 新建规则"; primary: true; enabled: UiData.rule-types.length > 0 && !UiData.working; clicked => { UiActions.dispatch(Intent.rule-add, "", ""); } }
                    }
                    Caption { text: "拖动手柄排序 · 靠近边缘自动滚动 · Esc 取消 · 右箭头详情"; wrap: word-wrap; }
                    rules := ContentPanel {
                        for rule[index] in UiData.rules: entry := Rectangle {
                            height: root.row-extent - Theme.content-gap;
                            background: root.drag-target == rule.id || rule.selected ? Theme.accent-wash : Theme.surface;
                            TouchArea {
                                enabled: !UiData.working && UiData.modal == 0;
                                clicked => { UiActions.dispatch(Intent.rule-select, rule.id, ""); }
                            }
                            HorizontalLayout { cross-axis-alignment: center; padding: Theme.content-gap; spacing: Theme.content-gap;
                                RuleDragHandle {
                                    row-height: entry.height + Theme.content-gap;
                                    context: root.drag-context;
                                    enabled: !UiData.working && !UiData.exiting && !UiData.protected && UiData.rule-types.length > 0;
                                    blocked: UiData.modal != 0;
                                    started => { root.drag-id = rule.id; root.drag-target = rule.id; }
                                    dragged(delta) => { root.drag-target = UiData.rules[clamp(index + delta, 0, UiData.rules.length - 1)].id; }
                                    dropped(delta) => {
                                        let source = root.drag-id;
                                        root.drag-id = ""; root.drag-target = "";
                                        if delta != 0 && source != "" {
                                            UiActions.dispatch(Intent.rule-drop, source, UiData.rules[clamp(index + delta, 0, UiData.rules.length - 1)].id);
                                        }
                                    }
                                    cancelled => { root.drag-id = ""; root.drag-target = ""; }
                                }
                                Caption { text: rule.position; width: 32px; }
                                VerticalLayout { spacing: 4px; horizontal-stretch: 1;
                                    Label { text: rule.kind + " · " + rule.value; }
                                    Caption { text: rule.source + (rule.enabled ? "" : " · 已停用"); }
                                }
                                Badge { text: rule.policy; width-limit: root.width * 0.2; }
                                ActionButton {
                                    text: ""; width: 40px; selected: rule.selected;
                                    accessible-role: button; accessible-label: "规则详情与操作"; enabled: !UiData.working;
                                    Image { source: @image-url("../icons/chevron-right.svg"); colorize: Theme.secondary; width: 18px; height: 18px;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    }
                                    clicked => { UiActions.dispatch(Intent.rule-select, rule.id, ""); menu.show(); }
                                }
                            }
                            menu := PopupWindow {
                                close-policy: close-on-click-outside;
                                x: max(0px, entry.width - self.width); y: entry.height;
                                width: min(320px, root.width); height: min(actions.preferred-height, max(160px, root.height - 48px));
                                Rectangle {
                                    background: Theme.surface; border-color: Theme.line; border-width: 1px; border-radius: 6px;
                                    PageScroll {
                                        actions := VerticalLayout {
                                            padding: 8px; spacing: 4px;
                                            Paragraph { text: rule.kind + (rule.value == "" ? "" : " · " + rule.value) + " → " + rule.policy; }
                                            Caption { text: "来源：" + rule.source + (rule.enabled ? " · 已启用" : " · 已停用"); }
                                            CopyButton { label: "复制规则原文"; value: rule.raw; }
                                            Paragraph { text: rule.raw; }
                                            ActionButton { text: "编辑"; enabled: rule.source == "自定义" && !UiData.working;
                                                clicked => { menu.close(); UiActions.dispatch(Intent.rule-edit, "", ""); } }
                                            ActionButton { text: rule.enabled ? "停用" : "启用"; enabled: rule.source == "自定义" && !UiData.working;
                                                clicked => { menu.close(); UiActions.dispatch(Intent.rule-enable, "", ""); } }
                                            ActionButton { text: "删除"; danger: true; enabled: rule.source == "自定义" && !UiData.working;
                                                clicked => { menu.close(); UiActions.dispatch(Intent.rule-delete, "", ""); } }
                                            ActionButton { text: "跨页移动到位置…"; enabled: !UiData.working;
                                                clicked => { menu.close(); UiActions.dispatch(Intent.rule-move-open, "", ""); } }
                                            ActionButton { text: "恢复订阅顺序"; enabled: !UiData.working;
                                                clicked => { menu.close(); UiActions.dispatch(Intent.rule-restore, "", ""); } }
                                        }
                                    }
                                }
                            }
                        }
                        if UiData.rules.length == 0: Caption { text: "没有匹配的规则"; height: Theme.control-height; }
                    }
                    if UiData.rule-warning != "": ContentPanel { Paragraph { text: UiData.rule-warning; color: Theme.warning; } }
                }
            }
            gesture := ListReorderGesture {
                x: scroll.x + Theme.card-padding + Theme.content-gap; y: scroll.y;
                width: 24px; height: scroll.visible-height; hold-duration: 0ms;
                enabled: !UiData.working && !UiData.exiting && !UiData.protected && UiData.rule-types.length > 0 && UiData.modal == 0;
                cancel-requested: root.drag-id == "";
                context: root.drag-context;
                row-count: UiData.rules.length; row-height: root.row-extent;
                header-height: rules.y + Theme.card-padding;
                scroll-content-height: scroll.viewport-height; scroll-y <=> scroll.viewport-y;
                started(index) => { root.drag-id = UiData.rules[index].id; root.drag-target = root.drag-id; }
                targeted(index) => { root.drag-target = UiData.rules[index].id; }
                dropped(source, target) => {
                    let id = root.drag-id;
                    root.drag-id = ""; root.drag-target = "";
                    if source != target && id != "" { UiActions.dispatch(Intent.rule-drop, id, UiData.rules[target].id); }
                }
                cancelled => { root.drag-id = ""; root.drag-target = ""; }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Caption { text: UiData.page-status; }
            ActionButton { text: "上一页"; enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
            ActionButton { text: "下一页"; enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
        }
    }
}

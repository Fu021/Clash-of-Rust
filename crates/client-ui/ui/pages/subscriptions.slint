import { PageSurface } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { CardGrid } from "../components/card-grid.slint";
import { PageScroll, Caption, Heading, ContentPanel, ActionButton, Badge, Field } from "../components/controls.slint";
export component SubscriptionsPage inherits PageSurface {
    property <string> expanded-id;
    PageScroll {
        content-key: UiData.page-offset + "/" + UiData.query;
        content-y <=> UiData.scroll-profiles;
        x: 0px; width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start; padding-right: Theme.content-gap; spacing: Theme.page-gap;
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Field { placeholder: "搜索订阅名称或来源"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
                ActionButton { text: "打开目录"; enabled: UiData.ready; clicked => { UiActions.dispatch(Intent.open-profiles, "", ""); } }
                ActionButton { text: "+ 添加订阅"; primary: true; enabled: UiData.ready && !UiData.working; clicked => { UiActions.dispatch(Intent.add-profile, "", ""); } }
            }
            if UiData.profile-source != "": ContentPanel {
                Caption { text: "待导入：" + UiData.profile-source; }
                ActionButton { text: "导入所选配置"; primary: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.add-profile, "", ""); } }
            }
            grid := CardGrid {
                minimum-card-width: 300px;
                available-width: root.width - Theme.page-gap - Theme.content-gap;
                for row in floor((UiData.profiles.length + grid.columns - 1) / grid.columns): HorizontalLayout {
                    spacing: Theme.page-gap; cross-axis-alignment: start;
                    for column in grid.columns: VerticalLayout {
                        min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; alignment: start;
                        property <int> index: row * grid.columns + column;
                        if self.index < UiData.profiles.length: card := ContentPanel {
                            property <int> index: row * grid.columns + column;
                            property <bool> detailed: root.expanded-id == UiData.profiles[self.index].id;
                            preferred-width: 0px; min-width: 0px; horizontal-stretch: 1;
                            vertical-padding: 10px; gap: 6px;
                            border-color: UiData.profiles[self.index].active ? Theme.accent : Theme.line;
                            background: UiData.profiles[self.index].active ? Theme.accent-wash : Theme.surface;
                            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                Heading { text: UiData.profiles[card.index].name; font-size: Theme.body-size + 1px; }
                                if UiData.profiles[card.index].active: Badge { text: "使用中"; tone: 1; }
                                if UiData.profiles[card.index].local: Badge { text: "本地"; tone: 4; }
                            }
                            Caption { text: UiData.profiles[card.index].detail; }
                            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                                if !UiData.profiles[card.index].active: ActionButton {
                                    text: "使用"; primary: true; enabled: !UiData.working && !UiData.protected && !UiData.protection-pending;
                                    clicked => { UiActions.dispatch(Intent.activate-profile, UiData.profiles[card.index].id, ""); }
                                }
                                if !UiData.profiles[card.index].local: ActionButton {
                                    text: "更新"; enabled: !UiData.working && !(UiData.profiles[card.index].active && (UiData.protected || UiData.protection-pending));
                                    clicked => { UiActions.dispatch(Intent.update-profile, UiData.profiles[card.index].id, ""); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { text: card.detailed ? "收起" : "详情"; dropdown: true; expanded: card.detailed;
                                    clicked => { root.expanded-id = card.detailed ? "" : UiData.profiles[card.index].id; }
                                }
                            }
                            if card.detailed: VerticalLayout { spacing: Theme.content-gap;
                                Caption { text: "完整名称：" + UiData.profiles[card.index].name; wrap: word-wrap; }
                                Caption { text: UiData.profiles[card.index].detail; wrap: word-wrap; }
                                Caption { text: "来源：" + UiData.profiles[card.index].source; wrap: word-wrap; }
                                if !UiData.profiles[card.index].local: HorizontalLayout { spacing: Theme.content-gap;
                                    ActionButton { text: "编辑"; enabled: !UiData.working && !(UiData.profiles[card.index].active && (UiData.protected || UiData.protection-pending)); clicked => { UiActions.dispatch(Intent.edit-profile, UiData.profiles[card.index].id, ""); } }
                                    ActionButton { text: "删除"; danger: true; enabled: !UiData.working && !(UiData.profiles[card.index].active && (UiData.protected || UiData.protection-pending)); clicked => { UiActions.dispatch(Intent.delete-profile, UiData.profiles[card.index].id, ""); } }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Caption { text: UiData.page-status; }
                ActionButton { text: "上一页"; enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
                ActionButton { text: "下一页"; enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
            }
            if UiData.profiles.length == 0: ContentPanel { Caption { text: UiData.query != "" ? "没有匹配的订阅；请修改搜索条件。" : "导入订阅链接或本地 YAML 文件后，即可启用配置。"; wrap: word-wrap; } }
        }
    }
}

import { PageSurface } from "../components/motion.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { Theme } from "../theme/palette.slint";
import { PageScroll, Label, Caption, ActionButton, Segmented, Divider } from "../components/controls.slint";

component TrafficMetric inherits Rectangle {
    in property <string> title;
    in property <string> value;
    preferred-width: 0px;
    height: content.preferred-height;
    content := VerticalLayout {
        spacing: 3px;
        Caption { text: root.title; }
        Label { text: root.value; font-size: 23px * Theme.text-scale; font-weight: 600; }
    }
}

// Connection card (design: .composer). The node is the one large element; state,
// mode and subscription entry sit around it.
export component HomePage inherits PageSurface {
    property <bool> can-switch: UiData.running && !UiData.working && !UiData.protected && !UiData.protection-pending;
    PageScroll {
        content-y <=> UiData.scroll-home;
        x: 0px;
        width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start;
            padding-right: Theme.content-gap;
            spacing: Theme.page-gap;
            Rectangle {
                vertical-stretch: 0;
                height: card.preferred-height;
                background: Theme.surface;
                border-width: 1px; border-color: Theme.line;
                border-radius: Theme.radius-xl;
                clip: true;
                card := VerticalLayout {
                    VerticalLayout {
                        padding: 21px; spacing: 8px;
                        HorizontalLayout { spacing: 21px; cross-axis-alignment: center;
                            VerticalLayout { horizontal-stretch: 1; spacing: 8px;
                                Rectangle {
                                    height: node-name.preferred-height + 8px;
                                    node-name := Label {
                                        x: 0px; width: parent.width; height: parent.height;
                                        text: UiData.node != "" ? UiData.node : "未选择节点";
                                        font-size: 29px * Theme.text-scale; font-weight: 650;
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { UiActions.dispatch(Intent.navigate, "1", ""); } }
                                }
                                HorizontalLayout { spacing: 7px; alignment: start; cross-axis-alignment: center;
                                    Rectangle { width: 7px; height: 7px; border-radius: 4px; background: UiData.running ? Theme.success : Theme.muted; }
                                    Label { text: !UiData.running ? "内核尚未运行" : UiData.proxy-mode == 0 ? "系统代理已连接" : UiData.proxy-mode == 1 ? "TUN 模式已连接" : "代理已关闭"; font-size: Theme.detail-size; font-weight: 600; color: UiData.running ? Theme.success : Theme.secondary; horizontal-stretch: 0; width: self.preferred-width; }
                                    Caption { text: UiData.profile; overflow: elide; }
                                }
                            }
                            if UiData.retry-core: ActionButton { text: "重启内核"; primary: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.restart-core, "", ""); } }
                        }
                    }
                    Divider { }
                    HorizontalLayout {
                        padding: 8px; padding-left: 13px; padding-right: 13px; spacing: Theme.content-gap;
                        alignment: start;
                        Segmented { options: ["规则", "全局", "直连"]; current: UiData.mode; enabled: root.can-switch; picked(index) => { UiActions.dispatch(Intent.mode, "" + index, ""); } }
                        Segmented { options: ["系统代理", "TUN", "关闭"]; current: UiData.proxy-mode; enabled: root.can-switch; picked(index) => { UiActions.dispatch(Intent.proxy-mode, "" + index, ""); } }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "我的订阅"; compact: true; ghost: true; clicked => { UiActions.dispatch(Intent.navigate, "2", ""); } }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 0;
                height: traffic.preferred-height;
                background: Theme.surface;
                border-width: 1px; border-color: Theme.line;
                border-radius: Theme.radius-lg;
                traffic := VerticalLayout {
                    padding: 13px; padding-left: 16px; padding-right: 16px; spacing: 13px;
                    HorizontalLayout { spacing: 16px;
                        metric := TrafficMetric { title: "下载速度"; value: UiData.download-rate; }
                        Rectangle { width: 1px; height: metric.height; background: Theme.line; }
                        TrafficMetric { title: "上传速度"; value: UiData.upload-rate; }
                        Rectangle { width: 1px; height: metric.height; background: Theme.line; }
                        TrafficMetric { title: "活跃连接"; value: UiData.connection-count; }
                    }
                    Divider { }
                    HorizontalLayout {
                        Caption { text: "本次运行累计"; }
                        Caption { text: "↑ " + UiData.upload-total + "    ↓ " + UiData.download-total; horizontal-alignment: right; }
                    }
                }
            }
        }
    }
}

import { PageSurface } from "../components/motion.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { Theme } from "../theme/palette.slint";
import { PageScroll, Label, Caption, Heading, ContentPanel, ActionButton, Field, Badge, Paragraph } from "../components/controls.slint";

export component NetworkPage inherits PageSurface {
    PageScroll {
        viewport-y <=> UiData.scroll-network;
        x: 0px;
        width: parent.width + Theme.content-gap;
        VerticalLayout {
            padding-right: Theme.content-gap;
            spacing: Theme.page-gap;
            ContentPanel {
                Heading { text: "网站响应"; }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Field { text <=> UiData.test-url; edited(value) => { UiActions.dispatch(Intent.test-url, value, ""); } }
                    ActionButton { text: UiData.probing ? "测试中…" : "开始测试"; primary: true; busy: UiData.probing; enabled: !UiData.probing; clicked => { UiActions.dispatch(Intent.probe, "false", ""); } }
                }
            }
            ContentPanel {
                HorizontalLayout { cross-axis-alignment: center; Heading { text: "出口信息"; } ActionButton { text: "查询出口"; enabled: !UiData.probing; clicked => { UiActions.dispatch(Intent.probe, "true", ""); } } }
            }
            ContentPanel {
                Heading { text: "系统 DNS 查询"; }
                HorizontalLayout { cross-axis-alignment: center;
                    spacing: Theme.content-gap;
                    Field { text <=> UiData.dns-host; edited(value) => { UiActions.dispatch(Intent.dns-host, value, ""); } }
                    ActionButton { text: "解析"; enabled: !UiData.probing; clicked => { UiActions.dispatch(Intent.dns, "", ""); } }
                }
                Caption { text: "通过当前系统解析器查询"; }
            }
            for line in UiData.network-results: ContentPanel { Paragraph { text: line; } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

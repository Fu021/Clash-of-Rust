import { PageSurface } from "../components/motion.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { Theme } from "../theme/palette.slint";
import { PageScroll, Caption, ContentPanel, ActionButton, Field, Paragraph, Divider } from "../components/controls.slint";
import { ToolHeading } from "../components/sections.slint";

export component NetworkPage inherits PageSurface {
    PageScroll {
        content-y <=> UiData.scroll-network;
        VerticalLayout {
            padding-right: 8px; spacing: 16px; alignment: start;
            ContentPanel {
                ToolHeading { title: "网址检查"; icon: @image-url("../icons/network.svg"); }
                Caption { text: "检查 DNS、代理端口、HTTP / HTTPS 和实际线路"; }
                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                    Field {
                        placeholder: "域名或网址"; text <=> UiData.test-url; enabled: !UiData.probing;
                        edited(value) => { UiActions.dispatch(Intent.test-url, value, ""); }
                        accepted => { if !UiData.probing { UiActions.dispatch(Intent.probe, "", ""); } }
                    }
                    ActionButton { text: UiData.probing ? "检查中…" : "检查"; primary: true; busy: UiData.probing;
                        enabled: !UiData.probing; clicked => { UiActions.dispatch(Intent.probe, "", ""); }
                    }
                }
                VerticalLayout {
                    spacing: 0px;
                    for line in UiData.network-results: VerticalLayout {
                        spacing: 0px;
                        Divider { }
                        Rectangle {
                            height: max(32px, result.preferred-height + 14px);
                            result := Paragraph { y: 7px; width: parent.width; text: line; font-size: Theme.detail-size; }
                        }
                    }
                }
            }
        }
    }
}

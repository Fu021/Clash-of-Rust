import { PageSurface, Disclosure } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent, NodeItem, NodePair } from "../state.slint";
import { PageScroll, Label, Caption, Heading, Chevron, ContentPanel, RowPanel, ActionButton, Badge, Field, Select } from "../components/controls.slint";

component NodeCard inherits ContentPanel {
    in property <NodeItem> node;
    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1;
    interactive: UiData.running && !UiData.working && !UiData.protected && !UiData.protection-pending;
    clicked => { UiActions.dispatch(Intent.select-node, root.node.group, root.node.name); }
    border-color: node.selected ? Theme.accent : Theme.line;
    background: node.selected ? Theme.accent-wash : Theme.surface;
    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
        Label { text: root.node.name; color: root.node.selected ? Theme.accent : Theme.ink; }
        Caption { text: root.node.delay; color: root.node.tone == 1 ? Theme.success : root.node.tone == 2 ? Theme.warning : root.node.tone == 3 ? Theme.danger : Theme.muted; horizontal-stretch: 0; }
    }
    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
        Caption { text: root.node.kind; }
        if root.node.selected: Badge { text: UiData.protected ? "已锁定" : "使用中"; tone: 1; }
        ActionButton { text: "测速"; enabled: UiData.running && !UiData.working; clicked => { UiActions.dispatch(Intent.node-delay, root.node.name, ""); } }
    }
}
export component ProxiesPage inherits PageSurface {
    PageScroll {
        content-key: UiData.page-offset + "/" + UiData.query + "/" + UiData.node-sort;
        viewport-y <=> UiData.scroll-proxies;
        x: 0px; width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start;
            padding-right: Theme.content-gap; spacing: Theme.page-gap;
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Field { placeholder: "搜索节点或代理组"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
                Select { width: 172px; horizontal-stretch: 0; options: ["延迟从低到高", "延迟从高到低", "名称排序"]; value: self.options[UiData.node-sort]; selected(index, value) => { UiActions.dispatch(Intent.node-sort, "" + index, ""); } }
            }
            for group in UiData.groups: group-card := ContentPanel {
                property <[NodePair]> closing-nodes;
                property <string> closing-page;
                property <bool> expanded: group.expanded;
                property <bool> mounted: group-body.mounted;
                changed mounted => { if !self.mounted { self.closing-nodes = []; self.closing-page = ""; } }
                changed expanded => { if self.expanded { self.closing-nodes = []; self.closing-page = ""; } }
                callback toggle();
                toggle => {
                    if group.expanded { self.closing-nodes = group.nodes; self.closing-page = group.page; }
                    // Persist expansion immediately. Only the view retains the
                    // last model briefly; leaving the page releases it too.
                    UiActions.dispatch(Intent.toggle-group, group.id, "");
                }
                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                    header := Rectangle {
                        horizontal-stretch: 1; height: max(Theme.control-height, heading.preferred-height);
                        heading := HorizontalLayout { spacing: Theme.content-gap; cross-axis-alignment: center;
                            VerticalLayout { spacing: 4px; Heading { text: group.title; } Caption { text: group.detail; } }
                            Badge { text: group.current; width-limit: root.width * 0.28; }
                            Chevron { expanded: group-card.expanded; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { group-card.toggle(); } }
                    }
                    ActionButton { text: group.testing ? "测速中…" : "全部测速"; busy: group.testing; enabled: UiData.running && !UiData.working && !group.testing; clicked => { UiActions.dispatch(Intent.group-delay, group.id, ""); } }
                }
                group-body := Disclosure { expanded: group-card.expanded;
                    if group-body.mounted: VerticalLayout {
                        spacing: Theme.page-gap;
                        for pair in (group.expanded ? group.nodes : group-card.closing-nodes): HorizontalLayout { cross-axis-alignment: center; spacing: Theme.page-gap;
                            NodeCard { node: pair.left; }
                            if pair.right.valid: NodeCard { node: pair.right; }
                            if !pair.right.valid: Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                            Caption { text: group.expanded ? group.page : group-card.closing-page; }
                            ActionButton { text: "上一页"; enabled: group.previous; clicked => { UiActions.dispatch(Intent.group-page, group.id, "false"); } }
                            ActionButton { text: "下一页"; enabled: group.next; clicked => { UiActions.dispatch(Intent.group-page, group.id, "true"); } }
                        }
                    }
                }
            }
            if UiData.groups.length == 0: ContentPanel { Caption { text: UiData.running ? "当前配置没有匹配的代理组" : "内核启动后显示代理组"; } }
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Caption { text: UiData.page-status; }
                ActionButton { text: "上一页"; enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 4), ""); } }
                ActionButton { text: "下一页"; enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 4), ""); } }
            }
        }
    }
}

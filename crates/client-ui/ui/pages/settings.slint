import { PageSurface } from "../components/motion.slint";
import { Theme, AccentPalette } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, SettingsSection, ListPanel, FormRow, ActionButton, AccentSwatches, Segmented, Divider, Field, Select, Toggle } from "../components/controls.slint";
import { FakeIpPage } from "fake-ip.slint";
component SettingsScroll inherits PageScroll {
    // Section tabs live in the page header (app.slint). A tab asks for a jump through
    // settings-section/settings-jump; this page reports the section at the top of the
    // viewport through settings-active, so the two never feed each other.
    property <length> body-inset: max(0px, (root.width - Theme.content-gap - 720px) / 2);
    property <length> reading-line: -root.content-y + 64px;
    property <bool> at-end: root.content-height > root.visible-height + 1px && -root.content-y >= root.content-height - root.visible-height - 1px;
    property <int> active: root.at-end || root.reading-line >= tasks.y ? 4
        : root.reading-line >= updates.y ? 3 : root.reading-line >= look.y ? 2 : root.reading-line >= network.y ? 1 : 0;
    property <int> jump: UiData.settings-jump;
    property <[length]> section-tops: [general.y, network.y, look.y, updates.y, tasks.y];
    changed active => { UiData.settings-active = root.active; }
    changed jump => { root.content-y = -root.section-tops[clamp(UiData.settings-section, 0, 4)]; }
    property <bool> dns-locked: !UiData.working && !UiData.update-busy && !UiData.protected && !UiData.protection-pending;
    content-y <=> UiData.scroll-settings;
    VerticalLayout {
        alignment: start; padding-left: root.body-inset; padding-right: root.body-inset + Theme.content-gap;
        padding-bottom: 21px; spacing: Theme.section-gap;
        general := SettingsSection {
            title: "常规";
            ListPanel {
                FormRow { title: "开机自启动";
                    Toggle { checked: UiData.autostart; enabled: !UiData.working; toggled(value) => { UiActions.dispatch(Intent.autostart, value ? "true" : "false", ""); } }
                }
                Divider { }
                FormRow { title: "托盘显示上传与下载速度";
                    Toggle { checked: UiData.tray-speed; enabled: !UiData.working; toggled(value) => { UiActions.dispatch(Intent.tray-speed, value ? "true" : "false", ""); } }
                }
                Divider { }
                FormRow { title: "窗口大小";
                    Field { width: 76px; horizontal-stretch: 0; text <=> UiData.window-width; edited(value) => { UiActions.dispatch(Intent.window-width, value, ""); } }
                    Caption { text: "×"; horizontal-stretch: 0; }
                    Field { width: 76px; horizontal-stretch: 0; text <=> UiData.window-height; edited(value) => { UiActions.dispatch(Intent.window-height, value, ""); } }
                    ActionButton { text: "恢复默认"; compact: true; ghost: true; clicked => { UiActions.dispatch(Intent.reset-window, "", ""); } }
                }
            }
        }
        network := SettingsSection {
            title: "网络";
            VerticalLayout {
                spacing: Theme.page-gap;
                ListPanel {
                    FormRow { title: "混合端口";
                        Field { text <=> UiData.mixed-port; width: 96px; horizontal-stretch: 0; enabled: !UiData.protected && !UiData.protection-pending; edited(value) => { UiActions.dispatch(Intent.mixed-port, value, ""); } }
                    }
                    Divider { }
                    FormRow { title: "启用 IPv6";
                        Toggle { checked: UiData.ipv6; enabled: root.dns-locked; toggled(value) => { UiActions.dispatch(Intent.ipv6, value ? "true" : "false", ""); } }
                    }
                    Divider { }
                    FormRow { title: "启用 UDP";
                        Toggle { checked: UiData.udp || UiData.protected; enabled: root.dns-locked; toggled(value) => { UiActions.dispatch(Intent.udp, value ? "true" : "false", ""); } }
                    }
                    Divider { }
                    FormRow { title: "DNS 覆盖";
                        Toggle { checked: UiData.dns-override; enabled: root.dns-locked; toggled(value) => { UiActions.dispatch(Intent.dns-override, value ? "true" : "false", ""); } }
                    }
                    Divider { }
                    FormRow { title: "Fake-IP";
                        Toggle { checked: UiData.fake-ip; enabled: UiData.dns-override && root.dns-locked; toggled(value) => { UiActions.dispatch(Intent.fake-ip, value ? "true" : "false", ""); } }
                    }
                    Divider { }
                    FormRow { title: "Fake-IP 排除项";
                        ActionButton { text: "管理"; compact: true; enabled: UiData.dns-override && root.dns-locked; clicked => { UiActions.dispatch(Intent.fake-ip-editor, "true", ""); } }
                    }
                }
                if UiData.ports-dirty: HorizontalLayout { alignment: end;
                    ActionButton { text: "保存并重启内核"; primary: true; compact: true; enabled: !UiData.working && !UiData.protected && !UiData.protection-pending; clicked => { UiActions.dispatch(Intent.save-ports, "", ""); } }
                }
            }
        }
        look := SettingsSection {
            title: "外观";
            ListPanel {
                FormRow { title: "主题";
                    Segmented {
                        options: ["浅色", "深色", "跟随系统"];
                        // Stored order is 0 dark, 1 light, 2 follow system; the control shows light first.
                        current: UiData.appearance == 1 ? 0 : UiData.appearance == 0 ? 1 : 2;
                        enabled: !UiData.exiting;
                        picked(index) => { UiActions.dispatch(Intent.appearance, index == 0 ? "1" : index == 1 ? "0" : "2", ""); }
                    }
                }
                Divider { }
                FormRow { title: "强调色";
                    AccentSwatches { current: UiData.accent; enabled: !UiData.exiting; picked(index) => { UiActions.dispatch(Intent.accent-color, "" + index, ""); } }
                }
                Divider { }
                FormRow { title: "字号";
                    Select { width: 100px; horizontal-stretch: 0; value: "" + UiData.text-scale + "%"; options: ["80%", "90%", "100%", "110%", "125%", "150%"]; selected(index, value) => { UiActions.dispatch(Intent.text-scale, value, ""); } }
                }
            }
        }
        updates := SettingsSection {
            title: "更新";
            ListPanel {
                FormRow { title: "当前版本 " + UiData.version; hint: UiData.update-status;
                    ActionButton { text: "查看 Release"; compact: true; ghost: true; clicked => { UiActions.dispatch(Intent.open-release, "", ""); } }
                    ActionButton { text: "检查更新"; compact: true; busy: UiData.update-checking; enabled: !UiData.update-checking && !UiData.update-busy; clicked => { UiActions.dispatch(Intent.check-update, "", ""); } }
                    if UiData.update-available: ActionButton { text: "下载安装"; compact: true; primary: true; enabled: !UiData.update-busy; clicked => { UiActions.dispatch(Intent.install-update, "", ""); } }
                }
                Divider { }
                FormRow { title: "包含预发布版本";
                    Toggle { checked: UiData.update-prereleases; enabled: !UiData.working && !UiData.update-busy && !UiData.update-checking; toggled(value) => { UiActions.dispatch(Intent.update-prereleases, value ? "true" : "false", ""); } }
                }
                Divider { }
                FormRow { title: "Geo 数据"; hint: UiData.geo-status;
                    ActionButton { text: "更新 Geo 数据"; compact: true; busy: UiData.geo-updating; enabled: UiData.ready && !UiData.working && !UiData.geo-updating; clicked => { UiActions.dispatch(Intent.update-geo, "", ""); } }
                }
            }
        }
        tasks := SettingsSection {
            title: "计划任务";
            ListPanel {
                FormRow { title: "定时测速"; hint: "0 表示关闭";
                    Field { text <=> UiData.interval; width: 76px; horizontal-stretch: 0; edited(value) => { UiActions.dispatch(Intent.interval-input, value, ""); } }
                    Caption { text: "分钟"; horizontal-stretch: 0; }
                    ActionButton { text: "保存"; compact: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.save-interval, "", ""); } }
                }
                Divider { }
                FormRow { title: "订阅自动更新"; hint: "仅远程订阅，0 关闭，默认 360";
                    Field { text <=> UiData.subscription-interval; width: 76px; horizontal-stretch: 0; edited(value) => { UiActions.dispatch(Intent.subscription-interval-input, value, ""); } }
                    Caption { text: "分钟"; horizontal-stretch: 0; }
                    ActionButton { text: "保存"; compact: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.save-subscription-interval, "", ""); } }
                }
            }
        }
    }

}

export component SettingsPage inherits PageSurface {
    if UiData.fake-ip-editor: FakeIpPage { }
    if !UiData.fake-ip-editor: SettingsScroll { x: 0px; width: parent.width + Theme.content-gap; }
}

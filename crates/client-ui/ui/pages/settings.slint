import { PageSurface } from "../components/motion.slint";
import { Theme, AccentPalette } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, ContentPanel, RowPanel, SettingsSection, ActionButton, AccentChoice, SettingRow, Divider, Field, Select, Paragraph } from "../components/controls.slint";
export component SettingsPage inherits PageSurface {
    PageScroll {
        viewport-y <=> UiData.scroll-settings;
        x: 0px; width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start; padding-right: Theme.content-gap; padding-bottom: Theme.card-padding; spacing: Theme.section-gap;
            SettingsSection {
                title: "外观";
                ContentPanel {
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Label { text: "主题"; }
                        ActionButton { text: "深色"; selected: UiData.appearance == 0; enabled: !UiData.exiting; clicked => { UiActions.dispatch(Intent.appearance, "0", ""); } }
                        ActionButton { text: "浅色"; selected: UiData.appearance == 1; enabled: !UiData.exiting; clicked => { UiActions.dispatch(Intent.appearance, "1", ""); } }
                        ActionButton { text: "跟随系统"; selected: UiData.appearance == 2; enabled: !UiData.exiting; clicked => { UiActions.dispatch(Intent.appearance, "2", ""); } }
                    }
                    Divider { }
                    HorizontalLayout { cross-axis-alignment: center;
                        Label { text: "强调色"; }
                        AccentChoice { text: AccentPalette.accent-names[UiData.accent]; swatch: AccentPalette.accent-colors[UiData.accent]; enabled: !UiData.exiting; clicked => { UiActions.dispatch(Intent.accent-picker, "", ""); } }
                    }
                    Divider { }
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Label { text: "字号"; }
                        Select { width: 100px; horizontal-stretch: 0; value: "" + UiData.text-scale + "%"; options: ["80%", "90%", "100%", "110%", "125%", "150%"]; selected(index, value) => { UiActions.dispatch(Intent.text-scale, value, ""); } }
                    }
                    Divider { }
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Label { text: "窗口大小"; }
                        Field { width: 90px; horizontal-stretch: 0; text <=> UiData.window-width; edited(value) => { UiActions.dispatch(Intent.window-width, value, ""); } }
                        Caption { text: "×"; horizontal-stretch: 0; }
                        Field { width: 90px; horizontal-stretch: 0; text <=> UiData.window-height; edited(value) => { UiActions.dispatch(Intent.window-height, value, ""); } }
                        ActionButton { text: "恢复默认"; clicked => { UiActions.dispatch(Intent.reset-window, "", ""); } }
                    }
                }
            }
            SettingsSection {
                title: "常规";
                ContentPanel {
                    SettingRow { title: "开机自启动"; checked: UiData.autostart; enabled: !UiData.working; toggled(value) => { UiActions.dispatch(Intent.autostart, value ? "true" : "false", ""); } }
                    Divider { }
                    SettingRow { title: "托盘显示上传与下载速度"; checked: UiData.tray-speed; enabled: !UiData.working; toggled(value) => { UiActions.dispatch(Intent.tray-speed, value ? "true" : "false", ""); } }
                }
            }
            SettingsSection {
                title: "网络";
                ContentPanel {
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        Label { text: "混合端口"; }
                        Field { text <=> UiData.mixed-port; width: 100px; horizontal-stretch: 0; edited(value) => { UiActions.dispatch(Intent.mixed-port, value, ""); } }
                    }
                    if UiData.ports-dirty: ActionButton { text: "保存并重启内核"; primary: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.save-ports, "", ""); } }
                    Divider { }
                    SettingRow { title: "DNS 覆盖"; checked: UiData.dns-override; enabled: !UiData.working && !UiData.update-busy; toggled(value) => { UiActions.dispatch(Intent.dns-override, value ? "true" : "false", ""); } }
                    Divider { }
                    SettingRow { title: "启用 IPv6"; checked: UiData.ipv6; enabled: !UiData.working && !UiData.update-busy; toggled(value) => { UiActions.dispatch(Intent.ipv6, value ? "true" : "false", ""); } }
                    Divider { }
                    SettingRow { title: "启用 UDP"; checked: UiData.udp || UiData.protected; enabled: !UiData.working && !UiData.protected && !UiData.update-busy; toggled(value) => { UiActions.dispatch(Intent.udp, value ? "true" : "false", ""); } }
                }
            }
            SettingsSection {
                title: "定时测速";
                RowPanel {
                    Field { text <=> UiData.interval; width: 100px; horizontal-stretch: 0; edited(value) => { UiActions.dispatch(Intent.interval-input, value, ""); } }
                    Caption { text: "分钟 · 0 表示关闭"; }
                    ActionButton { text: "保存间隔"; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.save-interval, "", ""); } }
                }
            }
            SettingsSection {
                title: "Geo 数据";
                RowPanel {
                    Caption { text: UiData.geo-status; }
                    ActionButton { text: "更新所有 Geo 数据"; busy: UiData.geo-updating; enabled: UiData.ready && !UiData.working; clicked => { UiActions.dispatch(Intent.update-geo, "", ""); } }
                }
            }
            SettingsSection {
                title: "更新";
                ContentPanel {
                    Label { text: "当前版本 " + UiData.version; }
                    SettingRow { title: "包含预发布版本"; checked: UiData.update-prereleases; enabled: !UiData.working && !UiData.update-busy && !UiData.update-checking;
                        toggled(value) => { UiActions.dispatch(Intent.update-prereleases, value ? "true" : "false", ""); }
                    }
                    Paragraph { text: UiData.update-status; font-size: Theme.detail-size; color: Theme.secondary; }
                    HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                        ActionButton { text: "检查更新"; busy: UiData.update-checking; enabled: !UiData.update-checking && !UiData.update-busy; clicked => { UiActions.dispatch(Intent.check-update, "", ""); } }
                        ActionButton { text: "查看 Release"; clicked => { UiActions.dispatch(Intent.open-release, "", ""); } }
                        if UiData.update-available: ActionButton { text: "下载安装"; primary: true; enabled: !UiData.update-busy; clicked => { UiActions.dispatch(Intent.install-update, "", ""); } }
                    }
                }
            }
        }
    }
}

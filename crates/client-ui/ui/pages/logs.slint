import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { Label, Caption, Panel, ActionButton, Field, Badge } from "../components/controls.slint";
export component LogsPage inherits Rectangle {
    VerticalLayout {
        spacing: Theme.page-gap;
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Field { placeholder: "搜索日志"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
            ActionButton { text: "导出"; enabled: UiData.ready && !UiData.working; clicked => { UiActions.dispatch(Intent.export-logs, "", ""); } }
            ActionButton { text: "清空"; enabled: UiData.ready && !UiData.working; clicked => { UiActions.dispatch(Intent.clear-logs, "", ""); } }
        }
        Panel {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    alignment: start; padding: Theme.card-padding; spacing: Theme.content-gap;
                    for entry in UiData.logs: Rectangle {
                        height: max(44px, Theme.body-size * 1.5 + 16px);
                        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.page-gap;
                            if entry.time != "": Caption { text: entry.time; width: 66px; horizontal-stretch: 0; }
                            Badge { text: entry.level; tone: entry.tone; width: 52px; }
                            Label { text: entry.message; }
                        }
                    }
                }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Caption { text: UiData.page-status; }
            ActionButton { text: "上一页"; enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
            ActionButton { text: "下一页"; enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
        }
    }
}

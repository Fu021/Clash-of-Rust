import { PageSurface } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, Panel, ActionButton, Field, Badge, Select } from "../components/controls.slint";
import { CopyButton } from "../components/desktop-copy.slint";
import { GeometryTarget } from "../components/geometry.slint";
import { ChoiceBar } from "../components/sections.slint";
import { LogItem } from "../models.slint";

component LogRow inherits Rectangle {
    in property <LogItem> entry;
    in property <string> original;
    in property <int> row-index;
    property <string> focused-original;
    property <bool> current: root.row-index >= 0 && root.row-index < UiData.logs.length
        && root.original == (UiData.logs[root.row-index].original == "" ? UiData.logs[root.row-index].message : UiData.logs[root.row-index].original);
    changed original => { keys.clear-focus(); }
    GeometryTarget { key: "log:" + root.entry.message; bounds: [root.absolute-position.x, root.absolute-position.y, root.width, root.height]; }
    height: max(34px, Theme.detail-size * 1.6 + 12px);
    background: row-area.has-hover ? Theme.inset : root.entry.tone == 3 ? Theme.danger-wash : root.entry.tone == 2 ? Theme.warning-wash : transparent;
    accessible-role: button;
    accessible-label: root.entry.message;
    accessible-action-default => { if root.current && UiData.modal == 0 { UiActions.dispatch(Intent.log-detail, root.original, ""); } }
    keys := FocusScope {
        enabled: root.current && UiData.modal == 0;
        focus-gained(reason) => { root.focused-original = root.original; }
        key-pressed(event) => {
            if root.current && root.focused-original == root.original && (event.text == Key.Return || event.text == " ") {
                UiActions.dispatch(Intent.log-detail, root.original, "");
                return accept;
            }
            return reject;
        }
    }
    row-area := TouchArea {
        enabled: root.current && UiData.modal == 0;
        mouse-cursor: pointer;
        clicked => { UiActions.dispatch(Intent.log-detail, root.original, ""); }
    }
    HorizontalLayout { cross-axis-alignment: center; spacing: 10px; padding-left: 16px; padding-right: 8px;
        if root.entry.time != "": Caption { text: root.entry.time; width: 66px; horizontal-stretch: 0; }
        Caption { text: root.entry.level; color: root.entry.tone == 3 ? Theme.danger : root.entry.tone == 2 ? Theme.warning : Theme.secondary; width: 52px * Theme.text-scale; horizontal-stretch: 0; }
        Label { text: root.entry.message; font-size: Theme.detail-size; }
        CopyButton { geometry-key: "copy-log:" + root.entry.message; value: root.entry.message; enabled: root.current; quiet: true; compact: true; }
    }
}

component LogSlot inherits VerticalLayout {
    in property <LogItem> entry;
    in property <int> row-index;
    property <string> current: root.entry.original == "" ? root.entry.message : root.entry.original;
    property <string> snapshot;
    init => { root.snapshot = root.current; }
    changed current => { root.snapshot = root.current; }
    for held in [{ original: root.snapshot }]: LogRow { entry: root.entry; original: held.original; row-index: root.row-index; }
}

export component LogsPage inherits PageSurface {
    VerticalLayout {
        spacing: Theme.page-gap;
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            if root.width >= 720px && Theme.text-scale <= 1.1: ChoiceBar {
                width: 260px; horizontal-stretch: 0; options: [@tr("全部"), @tr("信息"), @tr("警告"), @tr("错误")];
                selected: UiData.log-level == "INFO" ? 1 : UiData.log-level == "WARN" ? 2 : UiData.log-level == "ERROR" ? 3 : 0;
                chosen(index) => { UiActions.dispatch(Intent.log-level, ["全部等级", "INFO", "WARN", "ERROR"][index], ""); }
            }
            Field { placeholder: @tr("搜索日志"); focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
            Select { geometry-key: "log-level"; width: 112px; horizontal-stretch: 0; options: [@tr("全部等级"), "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]; value: UiData.log-level == "全部等级" ? self.options[0] : UiData.log-level; selected(index, value) => { UiActions.dispatch(Intent.log-level, index == 0 ? "全部等级" : value, ""); } }
        }
        Panel {
            vertical-stretch: 1;
            PageScroll {
                content-key: UiData.page-offset + "/" + UiData.query + "/" + UiData.log-level;
                content-y <=> UiData.scroll-logs;
                VerticalLayout {
                    alignment: start; padding-top: 6px; padding-bottom: 6px; spacing: 0px;
                    for entry[index] in UiData.logs: LogSlot { entry: entry; row-index: index; }
                }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Caption { text: UiData.page-status; }
            ActionButton { text: @tr("导出诊断"); enabled: !UiData.diagnosing; clicked => { UiActions.dispatch(Intent.export-diagnostics, "", ""); } }
            ActionButton { text: @tr("上一页"); enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
            ActionButton { text: @tr("下一页"); enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
        }
    }
}

import { PageSurface, ProgressTrack } from "../components/motion.slint";
import { DiagnosticActions } from "../components/notice.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { FindingBlocks, FindingList } from "../components/report.slint";
import { PageScroll, Caption, Heading, Panel, ContentPanel, RowPanel, ActionButton, Toggle, Paragraph } from "../components/controls.slint";
import { ToolHeading } from "../components/sections.slint";
export component AiCheckPage inherits PageSurface {
    motion-revision: UiData.claude-filter + 1;
    PageScroll {
        content-key: UiData.claude-filter + "/" + UiData.claude-result-page;
        content-y <=> UiData.scroll-claude;
        x: 0px; width: parent.width + Theme.content-gap;
        VerticalLayout {
            alignment: start; padding-right: Theme.content-gap; spacing: Theme.page-gap;
            ContentPanel {
                border-color: UiData.protected ? Theme.accent : Theme.line;
                ToolHeading { title: @tr("Claude 保护"); icon: @image-url("../icons/ai.svg");
                    Rectangle { horizontal-stretch: 1; }
                    Toggle { enabled: !UiData.working && !UiData.exiting && !UiData.claude-busy && !UiData.protection-pending && (UiData.running || UiData.protected); checked: UiData.protected; toggled(value) => { UiActions.dispatch(Intent.claude-protection, value ? "true" : "false", ""); } }
                }
                Caption { text: UiData.protection-pending ? UiData.protection-status : UiData.protected ? @tr("保护节点：{}", UiData.protection-node) : @tr("一键启用 TUN、广泛规则、代理 DNS 与实时拦截"); }
                if UiData.protection-pending: ProgressTrack { indeterminate: true; track: Theme.subtle-line; fill: Theme.accent; }
                Caption { text: @tr("可能影响其他应用与国内网站；关闭后恢复原状态。"); color: Theme.warning; }
            }
            HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                Heading { text: UiData.claude-busy ? @tr("正在检测…") : @tr("地区线索检测"); }
                ActionButton { text: @tr("导出报告"); enabled: UiData.ready; clicked => { UiActions.dispatch(Intent.claude-export, "", ""); } }
                ActionButton { text: UiData.claude-busy ? @tr("取消") : @tr("开始检测"); primary: true; enabled: UiData.running; clicked => { UiActions.dispatch(UiData.claude-busy ? Intent.claude-cancel : Intent.claude-start, "", ""); } }
            }
            if UiData.claude-busy: ProgressTrack { value: UiData.claude-progress; track: Theme.subtle-line; fill: Theme.accent; }
            if UiData.claude-status != "": Paragraph { text: UiData.claude-status; font-size: Theme.detail-size; color: UiData.claude-error ? Theme.danger : Theme.secondary; }
            if UiData.claude-error: DiagnosticActions { context: UiData.claude-status; }
            if UiData.claude-audit != "": Caption { text: UiData.claude-audit; }
            if UiData.claude-guard != "": Caption { text: UiData.claude-guard; }
            if UiData.browser-session: RowPanel {
                Caption { text: @tr("浏览器正在自动采样；离开此页会关闭回传入口。"); }
                ActionButton { text: @tr("关闭入口"); clicked => { UiActions.dispatch(Intent.claude-close-session, "", ""); } }
            }
            if UiData.claude-filter < 0 && UiData.claude-results.length > 0: VerticalLayout {
                spacing: 8px;
                HorizontalLayout { cross-axis-alignment: center;
                    Heading { text: @tr("报告摘要"); }
                    Caption { text: UiData.claude-normal == "0" && UiData.claude-risk == "0" && UiData.claude-clues == "0" ? @tr("暂无检测结果") : @tr("{} 项需关注", UiData.claude-risk); horizontal-alignment: right; color: UiData.claude-risk == "0" ? Theme.secondary : Theme.danger; }
                }
                FindingBlocks {
                    items: UiData.claude-results;
                    show-details(section) => { UiActions.dispatch(Intent.claude-filter, section, ""); }
                }
            }
            if UiData.claude-filter >= 0: VerticalLayout {
                spacing: Theme.page-gap;
                HorizontalLayout { cross-axis-alignment: center;
                    ActionButton { text: @tr("← 返回报告"); clicked => { UiActions.dispatch(Intent.claude-filter, "-1", ""); } }
                    Caption { text: UiData.claude-result-status; horizontal-alignment: right; }
                }
                Heading { text: [@tr("实时保护与异常拦截"), @tr("Claude 连接与选路"), @tr("出口与 IP 属性"), @tr("DNS 与 WebRTC"), @tr("浏览器与配置")][UiData.claude-filter]; }
                FindingList { items: UiData.claude-results; }
                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                    Caption { text: UiData.claude-result-status; }
                    ActionButton { text: @tr("上一页"); compact: true; enabled: UiData.claude-previous; clicked => { UiActions.dispatch(Intent.claude-page, "" + (UiData.claude-result-page - 1), ""); } }
                    ActionButton { text: @tr("下一页"); compact: true; enabled: UiData.claude-next; clicked => { UiActions.dispatch(Intent.claude-page, "" + (UiData.claude-result-page + 1), ""); } }
                }
            }
        }
    }
}

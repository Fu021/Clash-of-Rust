import { Theme, Demo } from "../theme/palette.slint";
import { Label, Caption, Panel, ActionButton, Badge, Field, Divider } from "../components/controls.slint";

struct Connection { host: string, rule: string, route: string, up: string, down: string, upload: string, download: string }

export component ConnectionsPage inherits Rectangle {
    property <string> search;
    property <bool> descending: true;
    property <int> sort-column: 3;
    property <[Connection]> rows: root.descending ? [
        {host: "api.github.com:443", rule: "DOMAIN-SUFFIX", route: "代理选择 → 德国 01", up: "24 KiB/s", down: "1.20 MiB/s", upload: "42.6 KiB", download: "12.4 MiB"},
        {host: "claude.ai:443", rule: "DOMAIN-SUFFIX", route: "代理选择 → 德国 01", up: "8.1 KiB/s", down: "86.4 KiB/s", upload: "18.2 KiB", download: "4.82 MiB"},
        {host: "example.com:443", rule: "GEOIP", route: "DIRECT", up: "0 B/s", down: "0 B/s", upload: "2.0 KiB", download: "34.0 KiB"}
    ] : [
        {host: "example.com:443", rule: "GEOIP", route: "DIRECT", up: "0 B/s", down: "0 B/s", upload: "2.0 KiB", download: "34.0 KiB"},
        {host: "claude.ai:443", rule: "DOMAIN-SUFFIX", route: "代理选择 → 德国 01", up: "8.1 KiB/s", down: "86.4 KiB/s", upload: "18.2 KiB", download: "4.82 MiB"},
        {host: "api.github.com:443", rule: "DOMAIN-SUFFIX", route: "代理选择 → 德国 01", up: "24 KiB/s", down: "1.20 MiB/s", upload: "42.6 KiB", download: "12.4 MiB"}
    ];
    VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            Field { placeholder: "搜索域名、IP、规则或代理链"; text <=> root.search; }
            Badge { text: "3 条连接"; tone: 4; }
            ActionButton { text: "关闭全部"; danger: true; }
        }
        Panel {
            min-height: 360px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 58px; background: Theme.inset;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 10px;
                        for title[i] in ["连接名称", "规则 / 代理链", "上传速度\n上传量", "下载速度\n下载量", "操作"]: Rectangle {
                            horizontal-stretch: i < 2 ? 2 : 1;
                            min-width: i < 2 ? 145px : 72px;
                            Caption { x: 0px; width: parent.width; height: parent.height; text: title + (root.sort-column == i ? (root.descending ? " ↓" : " ↑") : ""); }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.descending = root.sort-column == i ? !root.descending : true; root.sort-column = i; }
                            }
                        }
                    }
                }
                for row[i] in root.rows: Rectangle {
                    height: 96px;
                    visible: root.search == "" || row.host == root.search || row.rule == root.search || row.route == root.search;
                    background: mod(i, 2) == 0 ? Theme.surface : Theme.inset;
                    HorizontalLayout {
                        padding: 14px; spacing: 10px;
                        VerticalLayout { horizontal-stretch: 2; min-width: 145px; Label { text: row.host; font-size: 13px; } Caption { text: "TCP · 10:31:26"; color: Theme.muted; } }
                        VerticalLayout { horizontal-stretch: 2; min-width: 145px; Caption { text: row.rule; } Caption { text: row.route; } }
                        VerticalLayout { min-width: 72px; horizontal-stretch: 1; Label { text: row.up; font-size: 13px; } Caption { text: row.upload; } }
                        VerticalLayout { min-width: 72px; horizontal-stretch: 1; Label { text: row.down; font-size: 13px; color: Theme.accent; } Caption { text: row.download; } }
                        Rectangle { min-width: 72px; horizontal-stretch: 1; ActionButton { y: (parent.height - self.height) / 2; text: "关闭"; danger: true; } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        HorizontalLayout {
            Caption { text: "3 条 · 1–3"; }
            ActionButton { text: "上一页"; enabled: false; }
            ActionButton { text: "下一页"; enabled: false; }
        }
    }
}

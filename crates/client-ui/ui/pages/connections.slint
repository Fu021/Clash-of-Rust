import { PageSurface } from "../components/motion.slint";
import { Theme } from "../theme/palette.slint";
import { UiData, UiActions, Intent } from "../state.slint";
import { PageScroll, Label, Caption, Panel, ActionButton, Field, Badge } from "../components/controls.slint";
component SortHeading inherits Rectangle {
    in property <string> label;
    in property <string> field;
    in property <bool> active;
    in property <bool> descending;
    height: max(22px, Theme.detail-size * 1.5);
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: root.label + (root.active ? (root.descending ? " ↓" : " ↑") : "");
    accessible-action-default => { UiActions.dispatch(Intent.connection-sort, root.field, ""); }
    HorizontalLayout { spacing: 4px;
        Caption { text: root.label; min-width: 0px; color: root.active ? Theme.accent : Theme.secondary; }
        // Keep the indicator's geometry stable, including when no sort is active.
        // A path does not depend on fallback-font shaping or empty text metrics.
        Rectangle { width: 16px; horizontal-stretch: 0;
            Path {
                x: 2px; y: (parent.height - self.height) / 2;
                width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12;
                stroke: root.active ? Theme.accent : transparent;
                stroke-width: 1.5px;
                MoveTo { x: 6; y: root.descending ? 1 : 11; }
                LineTo { x: 6; y: root.descending ? 11 : 1; }
                MoveTo { x: 2; y: root.descending ? 7 : 5; }
                LineTo { x: 6; y: root.descending ? 11 : 1; }
                LineTo { x: 10; y: root.descending ? 7 : 5; }
            }
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { UiActions.dispatch(Intent.connection-sort, root.field, ""); } }
}
export component ConnectionsPage inherits PageSurface {
    property <string> sort-field: UiData.connection-sort;
    property <bool> sort-descending: UiData.descending;
    property <length> available: root.width - 24px - 48px - 72px;
    property <length> host-column: root.available * 0.35;
    property <length> rule-column: root.available * 0.31;
    property <length> speed-column: root.available * 0.17;
    VerticalLayout {
        spacing: Theme.page-gap;
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Field { placeholder: "搜索域名、IP、规则或代理链"; focus-id: "page-search"; text <=> UiData.query; edited(value) => { UiActions.dispatch(Intent.query, value, ""); } }
            Badge { text: UiData.connection-count + " 条连接"; tone: 4; }
            ActionButton { text: "关闭全部"; danger: true; enabled: UiData.running && !UiData.working; clicked => { UiActions.dispatch(Intent.close-all, "", ""); } }
        }
        Panel {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: max(52px, Theme.detail-size * 3 + 8px); background: Theme.surface;
                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                    HorizontalLayout { cross-axis-alignment: center; padding-left: 12px; padding-right: 12px; spacing: 12px;
                        VerticalLayout { width: root.host-column; SortHeading { label: "连接名称"; field: "name"; active: root.sort-field == "name"; descending: root.sort-descending; } SortHeading { label: "开始时间"; field: "start"; active: root.sort-field == "start"; descending: root.sort-descending; } }
                        VerticalLayout { width: root.rule-column; SortHeading { label: "规则"; field: "rule"; active: root.sort-field == "rule"; descending: root.sort-descending; } SortHeading { label: "代理链"; field: "chain"; active: root.sort-field == "chain"; descending: root.sort-descending; } }
                        VerticalLayout { width: root.speed-column; SortHeading { label: "上传速度"; field: "upload-rate"; active: root.sort-field == "upload-rate"; descending: root.sort-descending; } SortHeading { label: "上传量"; field: "upload-total"; active: root.sort-field == "upload-total"; descending: root.sort-descending; } }
                        VerticalLayout { width: root.speed-column; SortHeading { label: "下载速度"; field: "download-rate"; active: root.sort-field == "download-rate"; descending: root.sort-descending; } SortHeading { label: "下载量"; field: "download-total"; active: root.sort-field == "download-total"; descending: root.sort-descending; } }
                        Caption { width: 72px; text: "操作"; }
                    }
                }
                PageScroll {
                    content-key: UiData.page-offset + "/" + UiData.query + "/" + UiData.connection-sort + "/" + (UiData.descending ? "desc" : "asc");
                    viewport-y <=> UiData.scroll-connections;
                    for connection[i] in UiData.connections: Rectangle {
                        y: i * root.row-height;
                        height: root.row-height;
                        background: Theme.surface;
                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.subtle-line; }
                        TouchArea { mouse-cursor: pointer; clicked => { UiActions.dispatch(Intent.connection-detail, connection.id, ""); } }
                        HorizontalLayout { cross-axis-alignment: center; padding: 12px; spacing: 12px;
                            VerticalLayout { width: root.host-column; spacing: 4px; Label { text: connection.host; } Caption { text: connection.detail; } }
                            VerticalLayout { width: root.rule-column; spacing: 4px; Caption { text: connection.rule; } Caption { text: connection.route; } }
                            VerticalLayout { width: root.speed-column; spacing: 4px; Label { text: connection.up; } Caption { text: connection.upload; } }
                            VerticalLayout { width: root.speed-column; spacing: 4px; Label { text: connection.down; color: Theme.accent; } Caption { text: connection.download; } }
                            ActionButton { width: 72px; text: "关闭"; danger: true; enabled: !UiData.working; clicked => { UiActions.dispatch(Intent.close-connection, connection.id, ""); } }
                        }
                    }
                    content-height: UiData.connections.length * root.row-height;
                }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
            Caption { text: UiData.page-status; }
            ActionButton { text: "上一页"; enabled: UiData.previous; clicked => { UiActions.dispatch(Intent.list-page, "" + max(0, UiData.page-offset - 60), ""); } }
            ActionButton { text: "下一页"; enabled: UiData.next; clicked => { UiActions.dispatch(Intent.list-page, "" + (UiData.page-offset + 60), ""); } }
        }
    }
    property <length> row-height: max(84px, Theme.body-size * 3 + 36px);
}

import { Motion, MotionScope, ProgressTrack } from "components/motion.slint";
import { DesktopNotice } from "components/notice.slint";
import { ScrollView } from "std-widgets.slint";
import { UiData, UiActions, Intent } from "state.slint";
import { Theme } from "theme/palette.slint";
export { Theme } from "theme/palette.slint";
export { Motion } from "components/motion.slint";
export { UiData, UiActions, Intent, Choice, DetailItem, FakeIpExclusionItem, NodeItem, NodePair, GroupItem, ProfileItem, ConnectionItem, RuleItem, LogItem, ReportItem, OverviewItem, CategoryItem, CategoryPair } from "state.slint";
import { Label, Caption, ContentPanel, Panel, ActionButton, Badge, Paragraph } from "components/controls.slint";
import { NavigationItem } from "components/navigation.slint";
import { ProtectionBadge, ProtectionAlert } from "components/protection-status.slint";
import { HomePage } from "pages/home.slint";
import { ProxiesPage } from "pages/proxies.slint";
import { SubscriptionsPage } from "pages/subscriptions.slint";
import { ConnectionsPage } from "pages/connections.slint";
import { RulesPage } from "pages/rules.slint";
import { LogsPage } from "pages/logs.slint";
import { NetworkPage } from "pages/network.slint";
import { IpCheckPage } from "pages/ip-check.slint";
import { AiCheckPage } from "pages/ai-check.slint";
import { SettingsPage } from "pages/settings.slint";
import { AppDialog } from "dialogs/app-dialog.slint";
import "../../../resources/fonts/SourceHanSansCN-Regular.otf";
export component AppWindow inherits Window {
    MotionScope { }
    out property <bool> modal-mounted: dialog-host.mounted;
    in-out property <int> accent-draft <=> dialog-host.selected-accent;
    out property <bool> notice-mounted: notice-host.mounted;
    in-out property <string> app-title: "Clash of Rust";
    title: root.app-title;
    preferred-width: 950px;
    preferred-height: 700px;
    background: Theme.sidebar;
    animate background { duration: Motion.appearance; enabled: Motion.active; }
    in-out property <bool> dark <=> UiData.dark;
    in-out property <int> page <=> UiData.page;
    in-out property <length> window-min-width: 800px;
    in-out property <length> window-min-height: 450px;
    min-width: root.window-min-width;
    min-height: root.window-min-height;
    default-font-family: "Source Han Sans CN";
    default-font-size: Theme.body-size;
    icon: @image-url("../../../resources/icons/app.png");
    property <int> appearance: UiData.appearance;
    property <float> font-scale: UiData.text-scale / 100.0;
    changed dark => { Theme.system-dark = root.dark; }
    changed appearance => { Theme.appearance = root.appearance; }
    changed font-scale => { Theme.text-scale = root.font-scale; }
    property <int> accent: UiData.accent;
    changed accent => { Theme.accent-index = root.accent; }
    property <[string]> titles: ["首页", "代理", "订阅", "连接", "规则", "日志", "网络诊断", "IP 检测", "A÷检测", "设置"];
    property <[int]> sidebar-pages: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    property <[string]> settings-tabs: ["常规", "网络", "外观", "更新", "计划任务"];
    property <[image]> icons: [@image-url("icons/home.svg"), @image-url("icons/proxies.svg"), @image-url("icons/subscriptions.svg"), @image-url("icons/connections.svg"), @image-url("icons/rules.svg"), @image-url("icons/logs.svg"), @image-url("icons/network.svg"), @image-url("icons/ip.svg"), @image-url("icons/ai.svg"), @image-url("icons/settings.svg")];
    // Below 880 logical px the sidebar folds to an icon bar (55 = Fibonacci), as in the design.
    property <bool> compact: root.width < 880px;
    property <length> side-width: root.compact ? 55px : Theme.sidebar-width;
    forward-focus: keys;
    keys := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                UiActions.dispatch(Intent.escape, "", "");
                return accept;
            }
            return reject;
        }
    Rectangle {
        x: 0px; y: 0px; width: root.side-width; height: parent.height; background: Theme.sidebar;
        animate background { duration: Motion.appearance; enabled: Motion.active; }
        // The logo keeps the app's shape and takes the accent color; it also opens the system notification.
        Rectangle {
            x: root.compact ? (parent.width - self.width) / 2 : 8px; y: 5px; width: 40px; height: 40px; border-radius: Theme.radius;
            background: icon-area.pressed ? Theme.press : icon-area.has-hover ? Theme.hover : transparent;
            animate background { duration: Motion.fast; enabled: Motion.active; }
            accessible-role: button;
            accessible-label: "系统通知";
            accessible-action-default => { if !UiData.notification-busy && UiData.modal == 0 { UiActions.dispatch(Intent.system-notification, "", ""); } }
            Image { x: 9px; y: 9px; width: 22px; height: 22px; source: @image-url("../../../resources/icons/app.png"); colorize: Theme.accent; animate colorize { duration: Motion.appearance; enabled: Motion.active; } }
            FocusScope {
                enabled: !UiData.notification-busy && UiData.modal == 0;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " { UiActions.dispatch(Intent.system-notification, "", ""); return accept; }
                    return reject;
                }
            }
            icon-area := TouchArea {
                enabled: !UiData.notification-busy && UiData.modal == 0;
                mouse-cursor: pointer;
                clicked => { UiActions.dispatch(Intent.system-notification, "", ""); }
            }
        }
        if !root.compact: Text {
            x: 50px; y: 5px; height: 40px; width: parent.width - 54px;
            text: "clash of rust"; color: Theme.ink; vertical-alignment: center; overflow: elide;
            font-size: 18px * Theme.text-scale; font-weight: 500; letter-spacing: -0.2px;
        }
        nav := ScrollView {
            content-y <=> UiData.scroll-navigation;
            x: 0px; y: 51px; width: parent.width; height: max(0px, footer.y - self.y - 8px);
            VerticalLayout { alignment: start; padding-left: 8px; padding-right: 8px; spacing: 1px;
                for route-id in root.sidebar-pages: VerticalLayout {
                    spacing: 1px;
                    if route-id == 6 && !root.compact: Caption { text: "工具"; height: 30px; x: 8px; vertical-alignment: bottom; }
                    if route-id == 6 && root.compact: Rectangle { height: 21px; Rectangle { y: 10px; x: 8px; width: parent.width - 16px; height: 1px; background: Theme.line; } }
                    NavigationItem {
                        text: root.compact ? "" : root.titles[route-id]; icon: root.icons[route-id]; selected: UiData.page == route-id;
                        trailing: root.compact || route-id != 3 ? "" : UiData.connection-count;
                        clicked => { UiActions.dispatch(Intent.navigate, "" + route-id, ""); }
                    }
                }
            }
        }
        footer := VerticalLayout {
            x: 8px; y: parent.height - self.height - 8px; width: parent.width - 16px;
            height: self.preferred-height; spacing: 6px;
            Rectangle { height: 1px; background: Theme.line; }
            NavigationItem {
                text: root.compact ? "" : root.titles[9]; icon: root.icons[9]; selected: UiData.page == 9;
                clicked => { UiActions.dispatch(Intent.navigate, "9", ""); }
            }
            if !root.compact: HorizontalLayout {
                padding-left: 8px; padding-right: 8px; height: 18px;
                Caption { text: UiData.version; overflow: elide; font-size: 11px * Theme.text-scale; }
            }
        }
    }
    // The canvas rises from the sidebar with a rounded top-left corner only: the
    // right and bottom strips repaint the canvas colour over the other three arcs.
    Rectangle {
        x: root.side-width; y: 0px; width: parent.width - root.side-width; height: parent.height;
        background: Theme.canvas; border-radius: 12px;
        border-width: 1px; border-color: Theme.line;
        animate background { duration: Motion.appearance; enabled: Motion.active; }
        Rectangle { x: parent.width - 16px; width: 16px; height: parent.height; background: Theme.canvas; animate background { duration: Motion.appearance; enabled: Motion.active; } }
        Rectangle { y: parent.height - 16px; height: 16px; width: parent.width; background: Theme.canvas; animate background { duration: Motion.appearance; enabled: Motion.active; } }
        // Page header (55): title, settings tabs, then protection and kernel state on the right.
        HorizontalLayout {
            y: 1px; x: 1px; width: parent.width - 2px; height: Theme.page-head-height;
            padding-left: 21px; padding-right: 13px; spacing: 10px;
            Label { text: root.titles[UiData.page]; font-size: Theme.title-size; font-weight: 600; horizontal-stretch: 0; width: self.preferred-width; }
            if UiData.page == 9: HorizontalLayout { spacing: 2px; padding-left: 3px; alignment: start; horizontal-stretch: 0;
                for tab[i] in root.settings-tabs: Rectangle {
                    height: Theme.compact-height; width: tab-label.preferred-width + 20px; y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: UiData.settings-active == i ? Theme.press : tab-area.has-hover ? Theme.hover : transparent;
                    animate background { duration: Motion.fast; enabled: Motion.active; }
                    accessible-role: button;
                    accessible-label: tab;
                    tab-label := Label { text: tab; width: parent.width; height: parent.height; horizontal-alignment: center; color: UiData.settings-active == i ? Theme.ink : Theme.secondary; font-weight: UiData.settings-active == i ? 600 : 400; }
                    tab-area := TouchArea {
                        enabled: UiData.modal == 0;
                        mouse-cursor: pointer;
                        clicked => { UiData.settings-section = i; UiData.settings-jump += 1; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if UiData.protection-health > 0: ProtectionBadge {
                health: UiData.protection-health;
                enabled: UiData.modal == 0;
                clicked => { UiActions.dispatch(Intent.navigate, "8", ""); }
            }
            Rectangle {
                horizontal-stretch: 0; y: (parent.height - self.height) / 2;
                height: 28px; width: kernel-text.preferred-width + 38px; border-radius: 14px;
                border-width: 1px; border-color: Theme.line-strong;
                Rectangle { x: 11px; y: (parent.height - self.height) / 2; width: 7px; height: 7px; border-radius: 4px; background: UiData.running ? Theme.success : UiData.ready ? Theme.warning : Theme.muted; animate background { duration: Motion.control; enabled: Motion.active; } }
                kernel-text := Label { x: 25px; width: parent.width - 36px; height: parent.height; text: UiData.running ? "内核运行中" : UiData.ready ? "内核未启动" : "正在初始化"; font-size: Theme.detail-size; color: Theme.secondary; }
            }
        }
        Rectangle { x: 1px; y: Theme.page-head-height; width: parent.width - 2px; height: 1px; background: Theme.line; }
        VerticalLayout {
            x: 22px; y: Theme.page-head-height + 21px; width: parent.width - 22px - 21px; height: parent.height - Theme.page-head-height - 21px - 13px;
            spacing: Theme.page-gap;
            if UiData.protection-health == 3: ProtectionAlert {
                health: UiData.protection-health; message: UiData.protection-message;
                enabled: UiData.modal == 0;
                clicked => { UiActions.dispatch(Intent.navigate, "8", ""); }
            }
            if UiData.update-busy || UiData.update-available: ContentPanel {
                HorizontalLayout { cross-axis-alignment: center; spacing: Theme.content-gap;
                    Label { text: UiData.update-status; wrap: word-wrap; }
                    if UiData.update-downloading: ActionButton { text: "取消"; clicked => { UiActions.dispatch(Intent.cancel-update, "", ""); } }
                    if UiData.update-available && !UiData.update-busy: ActionButton { text: "下载安装"; primary: true; clicked => { UiActions.dispatch(Intent.install-update, "", ""); } }
                }
                if UiData.update-downloading: ProgressTrack { value: UiData.update-fraction; track: Theme.line; fill: Theme.accent; }
            }
            Rectangle {
                vertical-stretch: 1; min-height: 0px; clip: true;
                if UiData.page == 0: HomePage { }
                if UiData.page == 1: ProxiesPage { }
                if UiData.page == 2: SubscriptionsPage { }
                if UiData.page == 3: ConnectionsPage { }
                if UiData.page == 4: RulesPage { }
                if UiData.page == 5: LogsPage { }
                if UiData.page == 6: NetworkPage { }
                if UiData.page == 7: IpCheckPage { }
                if UiData.page == 8: AiCheckPage { }
                if UiData.page == 9: SettingsPage { }
            }
        }
    }
    // Only active/closing overlays mount their content; the page remains live.
    dialog-host := AppDialog { }
    // Last sibling: notices overlay dialogs without changing page geometry.
    notice-host := DesktopNotice { x: (parent.width - self.width) / 2; width: min(640px, parent.width - 48px); }
    }
}

export global PreviewNetwork {
    pure public function target(tool: int) -> string {
        return tool == 7 ? "203.0.113.53:53"
            : tool == 8 || tool == 9 ? "203.0.113.42"
            : tool == 10 ? "https://example.com/test.bin"
            : tool == 11 ? "example.com:22"
            : tool >= 14 && tool <= 16 ? ""
            : tool == 17 ? "AUTO" : "example.com";
    }
    pure public function results(tool: int) -> [string] {
        if tool == 1 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · example.com",
                "系统 DNS · 198.18.0.12", "内核 DNS · 203.0.113.42",
                "解析对照 · 系统使用 Fake-IP，结果不同不等于故障"];
        }
        if tool == 2 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "本机代理 TCP · 1 ms", "目标 TCP · 23 ms（含代理侧 DNS）",
                "TLS 握手 · 46 ms", "等待首字节 · 128 ms",
                "路径 · 经本机 SOCKS5 代理，沿用当前线路"];
        }
        if tool == 3 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "IPv4 · 203.0.113.42 · HTTP 200 · 128 ms",
                "IPv6 · 2001:db8::42 · HTTP 200 · 143 ms"];
        }
        if tool == 4 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "命中规则 · DOMAIN-SUFFIX,example.com,PROXY",
                "实际线路 · PROXY → AUTO → 🇩🇪 德国 01"];
        }
        if tool == 5 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "TLS 握手 · 46 ms", "证书信任 · 域名与信任链验证通过",
                "协议 · TLS 1.3"];
        }
        if tool == 6 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "请求结果 · 5 / 5 成功", "响应头耗时 · 中位 128 ms",
                "最快 / 最慢 · 112 / 169 ms", "失败 · 0"];
        }
        if tool == 7 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · 203.0.113.53:53",
                "SOCKS5 UDP · 中继已建立", "DNS 探针 · 收到匹配响应 · 24 ms"];
        }
        if tool == 8 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · 203.0.113.42",
                "系统 ICMP · 5 次发送 / 5 次响应", "丢包 · 0%",
                "说明 · 不代表代理节点延迟"];
        }
        if tool == 9 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · 203.0.113.42",
                "第 1 跳 · 192.0.2.1 · 1 ms", "第 2 跳 · 未响应",
                "第 3 跳 · 203.0.113.42 · 23 ms"];
        }
        if tool == 10 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
                "已接收 · 8 MiB", "平均速度 · 4.2 MiB/s",
                "实际耗时 · 1.90 秒", "结束原因 · 已达到流量上限",
                "实际线路 · PROXY → AUTO → 🇩🇪 德国 01"];
        }
        if tool == 11 {
            return ["预览 · 固定演示结果，未发送请求", "目标 · example.com:22",
                "本机代理 TCP · 1 ms", "目标 TCP · 端口 22 · 128 ms",
                "检查范围 · 不发送应用数据，不代表服务可用"];
        }
        if tool == 12 {
            return ["预览 · 固定演示结果，未发送请求", "网站响应 · HEAD · HTTP 200",
                "content-type · text/html", "cache-control · max-age=300",
                "实际线路 · PROXY → AUTO → 🇩🇪 德国 01"];
        }
        if tool == 13 {
            return ["预览 · 固定演示结果，未发送请求", "预判范围 · 最后生成的配置，不连接目标",
                "无法确认 · 第 2 条 RULE-SET 需要动态信息，后续命中不能确定"];
        }
        if tool == 14 {
            return ["预览 · 固定演示结果，未读取配置", "目标 · 当前实例",
                "dns · 对象 2 项 → 对象 6 项 · 已覆盖或变化",
                "rules · 列表 300 项 → 列表 312 项 · 已覆盖或变化",
                "proxies · 列表 100 项 → 列表 100 项 · 一致",
                "tun.enable · 开启", "对照范围 · 不显示正文、节点地址或凭据"];
        }
        if tool == 15 {
            return ["预览 · 固定演示结果，未读取连接", "当前连接 · 6 个",
                "主机 · example.com · 2 个 · ↑ 1024 B · ↓ 8192 B",
                "策略链 · PROXY → AUTO → 🇩🇪 德国 01 · 6 个 · ↑ 2048 B · ↓ 16384 B",
                "检查范围 · 只统计仍存在的连接，不保存历史"];
        }
        if tool == 16 {
            return ["预览 · 固定演示结果，未读取内核", "内核版本 · 示例",
                "当前连接 · 6 个", "内核托管堆 · 31457280 B · 30.00 MiB",
                "统计范围 · 托管堆不是进程 RSS，不含 GUI 和后台"];
        }
        if tool == 17 {
            return ["预览 · 固定演示结果，未读取节点", "目标 · AUTO",
                "类型 · URLTest", "当前选择 · AUTO → 🇩🇪 德国 01",
                "所属策略组 · PROXY", "检查范围 · 不主动测速，自动组可能变化"];
        }
        return ["预览 · 固定演示结果，未发送请求", "目标 · https://example.com",
            "系统 DNS · 198.18.0.12", "内核 DNS · 203.0.113.42",
            "本机代理 · 端口可连接 · 1 ms", "HTTPS · HTTP 200 · 128 ms",
            "HTTP · HTTP 301 · 96 ms", "采用协议 · HTTPS",
            "实际线路 · PROXY → AUTO → 🇩🇪 德国 01 · 命中 DomainSuffix (example.com)"];
    }
}

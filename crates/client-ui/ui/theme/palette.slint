// Design v1.3: cool-gray neutrals, hairline borders, one accent used only for
// primary actions and selection. Type, spacing and radii follow the golden ratio
// (see design/ui-redesign/index.html): sizes 14·φ^(n/4), spacing 8·φ^(n/2).
export global Theme {
    in-out property <float> text-scale: 1;
    out property <length> body-size: 14px * text-scale;
    out property <length> detail-size: 12px * text-scale;
    out property <length> heading-size: 18px * text-scale;
    out property <length> title-size: 16px * text-scale;
    // 34 is the design's default control height; it grows with the font size.
    out property <length> control-height: max(34px, body-size * 1.5 + 13px);
    out property <length> compact-height: max(27px, body-size * 1.5 + 6px);
    // Shared spacing. Content cards size to their layouts, never to the window.
    out property <length> card-padding: 16px;
    out property <length> page-gap: 13px;
    out property <length> content-gap: 8px;
    out property <length> section-gap: 28px;
    out property <length> dialog-padding: 24px;
    out property <length> dialog-gap: 16px;
    out property <length> page-head-height: 55px;
    out property <length> sidebar-width: 180px;
    // Radii: 5 / 8 / 13 / 16.
    out property <length> radius-sm: 5px;
    out property <length> radius: 8px;
    out property <length> radius-lg: 13px;
    out property <length> radius-xl: 16px;
    // 0 dark, 1 light, 2 follow system. The preview supplies a mock system theme.
    in-out property <int> appearance: 2;
    in-out property <bool> system-dark: false;
    out property <bool> dark: appearance == 0 || (appearance == 2 && system-dark);
    out property <color> canvas: dark ? #1d2022 : #f8f9f9;
    out property <color> sidebar: dark ? #17191a : #f0f2f2;
    out property <color> surface: dark ? #24282a : #ffffff;
    out property <color> raised: dark ? #2b2f31 : #ffffff;
    out property <color> inset: dark ? #1a1d1e : #f0f2f2;
    out property <color> ink: dark ? #eceeef : #16191a;
    out property <color> secondary: dark ? #b8bdc0 : #4c5256;
    out property <color> muted: dark ? #8e9599 : #646b6f;
    // Hairlines and interaction layers are translucent ink, so they sit on any surface.
    out property <color> line: dark ? #eceeef17 : #16191a1a;
    out property <color> line-strong: dark ? #eceeef2b : #16191a2e;
    out property <color> subtle-line: line;
    out property <color> hover: dark ? #eceeef0d : #16191a0b;
    out property <color> press: dark ? #eceeef17 : #16191a14;
    out property <color> track: dark ? #eceeef12 : #16191a0f;
    in-out property <int> accent-index: 0;
    out property <color> accent: dark ? AccentPalette.dark-colors[accent-index] : AccentPalette.accent-colors[accent-index];
    out property <color> accent-wash: accent.with-alpha(0.11);
    out property <color> accent-wash-strong: accent.with-alpha(0.2);
    // Primary actions use the theme's accent; the label flips to dark ink on the light dark-mode accents.
    out property <color> primary: accent;
    out property <color> on-primary: dark ? #0d1415 : #ffffff;
    out property <color> success: dark ? #8cc77a : #3a7a2c;
    out property <color> success-wash: success.with-alpha(0.12);
    out property <color> warning: dark ? #e2b464 : #a2641a;
    out property <color> warning-wash: warning.with-alpha(0.13);
    out property <color> danger: dark ? #ef8b7f : #b4372b;
    out property <color> danger-wash: danger.with-alpha(0.11);
    out property <color> info: dark ? #86b4ef : #2a6fc4;
}

// Shared swatches; the saved selection belongs to the application settings.
export global AccentPalette {
    out property <[string]> accent-names: ["青绿", "蓝色", "紫色", "玫红", "琥珀", "石墨"];
    out property <[color]> accent-colors: [#0f766e, #2563eb, #7c3aed, #be185d, #b45309, #475569];
    out property <[color]> dark-colors: [#5fc9ad, #7aa7f0, #a991f0, #ec86b4, #e0a15c, #a3afbf];
}

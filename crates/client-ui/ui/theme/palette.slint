// Design A: solid surfaces, restrained outlines, and a neutral, legible palette.
export global Theme {
    // 0 dark, 1 light, 2 follow system. The preview supplies a mock system theme.
    in-out property <int> appearance: 2;
    in-out property <bool> system-dark: false;
    out property <bool> dark: appearance == 0 || (appearance == 2 && system-dark);
    out property <color> canvas: dark ? #111923 : #f6f8fb;
    out property <color> sidebar: dark ? #1a222d : #ffffff;
    out property <color> surface: dark ? #1c2735 : #ffffff;
    out property <color> inset: dark ? #26323d : #f1f4f8;
    out property <color> ink: dark ? #f1f5f9 : #141c29;
    out property <color> secondary: dark ? #bdc8d5 : #4b596b;
    out property <color> muted: dark ? #a3afbf : #64748b;
    out property <color> line: dark ? #3c4b5d : #d2d9e3;
    out property <color> subtle-line: dark ? #334155 : #e2e8f0;
    out property <color> accent: dark ? #8ce3c4 : #0f766e;
    out property <color> accent-wash: dark ? #254137 : #e7f4f0;
    out property <color> primary: #0f766e;
    out property <color> success: dark ? #86efac : #166534;
    out property <color> success-wash: dark ? #203c34 : #edf8f0;
    out property <color> warning: dark ? #fcd34d : #92400e;
    out property <color> warning-wash: dark ? #3b3428 : #fff7e5;
    out property <color> danger: dark ? #fca5a5 : #b91c1c;
    out property <color> danger-wash: dark ? #402c39 : #fef2f2;
}

// Preview state has no network, file, privilege or application callbacks attached.
export global Demo {
    in-out property <string> profile: "我的订阅";
    in-out property <string> node: "德国 01 · IPv6";
    in-out property <bool> protected: false;
    in-out property <string> detail-title: "AI";
    // This only changes the picker/its button. It does not change Theme or settings.
    in-out property <int> accent-preview: 0;
    out property <[string]> accent-names: ["青绿", "蓝色", "紫色", "玫红", "琥珀", "石墨"];
    out property <[color]> accent-colors: [#0f766e, #2563eb, #7c3aed, #be185d, #b45309, #475569];
}

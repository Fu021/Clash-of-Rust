import { FindingBlocks, FindingList } from "../../components/report.slint";
import { MobileTypography } from "typography.slint";

export component MobileReportBlocks inherits FindingBlocks {
    title-size: MobileTypography.font-size(14);
    detail-size: MobileTypography.font-size(13);
    caption-size: MobileTypography.font-size(12);
    detail-touch-height: 48px;
}

export component MobileReport inherits FindingList {
    title-size: MobileTypography.font-size(14);
    detail-size: MobileTypography.font-size(13);
    caption-size: MobileTypography.font-size(12);
    detail-touch-height: 48px;
}

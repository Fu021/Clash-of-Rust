                cancel-requested: MobileView.rule-drag-id == "";
                context: list.content-key + "/" + MobileView.detail + "/" + (root.width / 1px) + "/" + Theme.text-scale;
                row-count: MobileData.rules.length; row-height: root.row-extent;
                header-height: root.toolbar-extent + root.card-padding;
                scroll-content-height: list.content-height; scroll-y <=> list.content-y;
                started(index) => {
                    root.drag-item = MobileData.rules[index];
                    MobileView.rule-selected = true; MobileView.selected-rule = MobileData.rules[index];
                    MobileView.selected-id = MobileData.rules[index].id; MobileView.rule-position = MobileData.rules[index].position;
                    MobileView.rule-drag-id = MobileData.rules[index].id;
                }
                targeted(index) => { MobileView.rule-drag-target = MobileData.rules[index].id; }
                dropped(source, target) => {
                    if source != target && MobileView.rule-drag-id != "" {
                        MobileActions.request(MobileIntent.rule-drop, MobileView.rule-drag-id, MobileData.rules[target].id);
                    }
                    MobileView.rule-drag-id = ""; MobileView.rule-drag-target = "";
                }
                cancelled => { MobileView.rule-drag-id = ""; MobileView.rule-drag-target = ""; }
            }
        }
        if !root.scrolling-footer: RulesFooter { }
    }
}

component LogsToolbar inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.gap; vertical-stretch: 0;
    MField { placeholder: @tr("搜索日志内容"); text <=> MobileView.query; edited(value) => { MobileActions.request(MobileIntent.query, "logs", value); } }
    GridLayout { spacing: 4px;
        for title[index] in [@tr("全部"), @tr("信息"), @tr("警告"), @tr("错误")]: MButton {
            col: mod(index, Theme.text-scale > 1.25 ? 2 : 4); row: floor(index / (Theme.text-scale > 1.25 ? 2 : 4));
            text: title; quiet: true; selected: MobileView.log-level == ["全部等级", "INFO", "WARN", "ERROR"][index];
            clicked => { MobileView.log-level = ["全部等级", "INFO", "WARN", "ERROR"][index]; MobileActions.request(MobileIntent.log-level, MobileView.log-level, ""); }
        }
    }
    GridLayout { spacing: 4px;
        MSelect { col: 0; row: 0; colspan: 3; geometry-key: "log-level";
            options: ["全部等级", "TRACE", "DEBUG", "INFO", "WARN", "ERROR"]; value: MobileView.log-level;
            display-value(value) => { MobilePageText.label(value) }
            selected(index, value) => { MobileView.log-level = value; MobileActions.request(MobileIntent.log-level, value, ""); }
        }
        MButton { col: 0; row: 1; text: @tr("导出"); quiet: true; clicked => { MobileActions.request(MobileIntent.export-logs, "", ""); } }
        MButton { col: 1; row: 1; text: @tr("清空"); quiet: true; enabled: !MobileData.working; clicked => { MobileActions.request(MobileIntent.clear-logs, "", ""); } }
        MButton { col: 2; row: 1; text: @tr("诊断"); quiet: true;
            GeometryTarget { key: "preview-export-diagnostics"; bounds: [parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height]; }
            clicked => { MobileActions.request(MobileIntent.export-diagnostics, "", ""); }
        }
    }
}
component LogCard inherits MCard {
    in property <LogItem> item;
    interactive: true; clicked => { MobileView.log-message = root.item.message; MobileView.detail = 10; }
    border-radius: 0px; border-width: 0px; vertical-padding: 6px; gap: 0px;
    background: root.item.tone == 3 ? Theme.danger-wash : root.item.tone == 2 ? Theme.warning-wash : Theme.surface;
    HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
        MSmall { text: root.item.level; color: root.item.tone == 3 ? Theme.danger : root.item.tone == 2 ? Theme.warning : Theme.secondary; horizontal-stretch: 0; }
        MSmall { text: root.item.time; font-size: MobileTypography.font-size(12); }
        MCopyButton { value: root.item.message; quiet: true; width: 64px; horizontal-stretch: 0; }
    }
    Text { text: root.item.message; color: Theme.ink; wrap: word-wrap; overflow: elide; vertical-alignment: top; min-width: 0px; height: MobileTypography.font-size(14) * 2.8; font-size: MobileTypography.font-size(14); }
}
export component LogsRow inherits VerticalLayout {
    in property <LogItem> item;
    for entry in [root.item]: LogCard { item: entry; }
}
export component MobileLogs inherits PageSurface {
    clip: true;
    list := ListView { content-key: MobileView.query + "/" + MobileView.log-level;
        width: parent.width; height: parent.height;
        for index in MobileData.logs.length + 1: Rectangle {
            height: index == 0 ? header.header-height : content.preferred-height + 1px;
            content := VerticalLayout { x: 0px; y: 0px; width: parent.width; height: self.preferred-height; alignment: start; spacing: 0px;
                if index > 0: LogsRow { item: MobileData.logs[index - 1]; }
            }
        }
    }
    header := ListHeader {
        x: 0px; y: 0px; width: list.visible-width;
        list-height: list.visible-height; list-content-height: list.content-height; content-y <=> list.content-y;
        LogsToolbar { }
    }
}
export component MobileNetwork inherits PageSurface {
    property <bool> opened <=> MobileView.network-open;
    property <bool> wide: root.width >= max(620px, 600px * Theme.text-scale);
    property <length> menu-width: 156px * max(1, Theme.text-scale);
    HorizontalLayout {
        spacing: MobileTypography.gap;
        if root.wide || !root.opened: MScroll {
            preferred-width: root.wide ? root.menu-width : 0px;
            max-width: root.wide ? root.menu-width : 100000px;
            horizontal-stretch: root.wide ? 0 : 1;
            NetworkToolMenu {
                selected: MobileData.network-tool; descriptions: !root.wide; touch-input: true;
                body-size: MobileTypography.font-size(14);
                detail-size: MobileTypography.font-size(12);
                enabled: !MobileView.modal && !MobileView.notice-modal;
                chosen(index) => {
                    MobileActions.request(MobileIntent.network-tool, "" + index, "");
                    root.opened = true;
                }
            }
        }
        if root.wide || root.opened: MScroll {
        geometry-key: "network-detail-viewport";
        width: root.wide ? root.width - root.menu-width - MobileTypography.gap : root.width;
        content-key: "" + MobileData.network-tool;
        VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
            if !root.wide: HorizontalLayout {
                alignment: start;
                MButton {
                    geometry-key: "network-menu-back";
                    text: @tr("‹ 全部工具"); quiet: true; compact: true;
                    width: max(120px, MobileTypography.font-size(14) * 7 + 16px); horizontal-stretch: 0;
                    clicked => { MobileActions.request(MobileIntent.probe-cancel, "", ""); root.opened = false; }
                }
            }
            NetworkToolHeading {
                tool: MobileData.network-tool;
                body-size: MobileTypography.font-size(17);
                detail-size: MobileTypography.font-size(12);
            }
        MCard {
            if NetworkTools.needs-target(MobileData.network-tool): MSmall { text: NetworkTools.target-labels[MobileData.network-tool]; }
            HorizontalLayout { spacing: 8px;
                if NetworkTools.needs-target(MobileData.network-tool): MField { geometry-key: "network-target"; text <=> MobileView.test-url; placeholder: NetworkTools.target-labels[MobileData.network-tool]; enabled: !MobileData.probe-busy; }
                MButton { text: MobileData.probe-busy ? @tr("取消") : @tr("检查"); primary: !MobileData.probe-busy;
                    geometry-key: "network-run";
                    width: max(76px, MobileTypography.font-size(15) * 4 + 16px); horizontal-stretch: 0;
                    clicked => { MobileActions.request(MobileData.probe-busy ? MobileIntent.probe-cancel : MobileIntent.probe, MobileView.test-url, parameters.encoded); }
                }
            }
            parameters := NetworkToolOptions { tool: MobileData.network-tool; touch-input: true; enabled: !MobileData.probe-busy && !MobileView.modal && !MobileView.notice-modal; }
            VerticalLayout {
                spacing: 0px;
                for line in MobileData.probe-results: VerticalLayout {
                    spacing: 0px;
                    MDivider { }
                    Rectangle {
                        height: max(32px, result.preferred-height + 14px);
                        result := MParagraph { y: 7px; width: parent.width; text: line; font-size: MobileTypography.font-size(14); }
                    }
                }
            }
            if MobileData.probe-results.length > 0: HorizontalLayout {
                alignment: start;
                MButton {
                    geometry-key: "network-export";
                    text: @tr("导出诊断"); compact: true;
                    width: max(140px, MobileTypography.font-size(14) * 9 + 24px); horizontal-stretch: 0;
                    clicked => { MobileActions.request(MobileIntent.export-diagnostics, "网络工具检查", ""); }
                }
            }
            if MobileData.network-tool == 0 && MobileData.probe-results.length > 0: GridLayout {
                spacing: 8px;
                for tool[index] in [1, 2, 4, 11]: MButton {
                    col: mod(index, 2); row: floor(index / 2);
                    text: NetworkTools.titles[tool]; quiet: true;
                    clicked => { MobileActions.request(MobileIntent.network-tool, "" + tool, ""); }
                }
            }
        }
    } } }
}
component CategoryCard inherits MCard {
    in property <CategoryItem> item;
    interactive: true; clicked => { MobileView.category = root.item.id; MobileActions.request(MobileIntent.site-category, root.item.id, ""); MobileView.detail = 6; }
    vertical-padding: 12px; horizontal-padding: 12px; gap: 6px;
    MText { text: IpStatusText.label(root.item.title); font-weight: 600; font-size: MobileTypography.font-size(15); }
    MHeading { text: root.item.count; color: root.item.tone == 2 ? Theme.warning : Theme.accent; font-size: MobileTypography.font-size(24); }
    MSmall { text: root.item.detail; wrap: word-wrap; font-size: MobileTypography.font-size(12); }
    MSmall { text: @tr("查看详情 ›"); color: Theme.accent; font-size: MobileTypography.font-size(12); }
}
export component MobileIpCheck inherits PageSurface {
    MScroll { VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
            MHeading { text: @tr("检测报告"); }
            MButton { text: MobileData.detecting ? @tr("取消") : @tr("重新检测"); primary: true; width: max(100px, MobileTypography.font-size(15) * 4 + 16px); horizontal-stretch: 0;
                clicked => { MobileActions.request(MobileData.detecting ? MobileIntent.site-cancel : MobileIntent.site-start, "", ""); }
            }
        }
        MCard {
            MSmall { text: MobileData.site-progress; }
            MSmall { text: @tr("Cloudflare 探针出口"); }
            HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
                if MobileData.exit-flag != "": Text { text: MobileData.exit-flag; width: 24px; height: 24px; font-size: 20px; }
                MSmall { text: MobileData.exit-country; }
            }
            MHeading { text: MobileData.exit-ip == "" ? @tr("等待检测") : MobileData.exit-ip; font-size: MobileTypography.font-size(24); }
            MSmall { text: MobileData.site-summary; wrap: word-wrap; }
            MProgress { value: MobileData.progress; }
        }
        for pair in MobileData.categories: VerticalLayout { spacing: MobileTypography.gap;
            if root.width < 340px || Theme.text-scale > 1.25: CategoryCard { item: pair.left; }
            if (root.width < 340px || Theme.text-scale > 1.25) && pair.right.id != "": CategoryCard { item: pair.right; }
            if root.width >= 340px && Theme.text-scale <= 1.25: HorizontalLayout { spacing: MobileTypography.gap;
                CategoryCard { item: pair.left; }
                if pair.right.id != "": CategoryCard { item: pair.right; }
            }
        }
        MButton { text: @tr("IP 信息与全部结果"); clicked => { MobileView.category = "all"; MobileActions.request(MobileIntent.site-category, "all", ""); MobileView.detail = 6; } }
    } }
}
component MobileProtection inherits MCard {
            in property <bool> retry-available;
            selected: MobileData.protected;
            MToolHeading { title: MobileData.protection-supported ? @tr("Claude 保护") : @tr("Claude 保护 · 暂未开放"); icon: @image-url("../../icons/ai.svg");
            MSwitch { width: 48px; horizontal-stretch: 0; checked: MobileData.protected; enabled: MobileData.protection-supported && !MobileData.protection-pending;
                toggled(value) => { if value { MobileView.detail = 8; } else { MobileActions.request(MobileIntent.claude-protection, "false", ""); } }
            }
            }
            MSmall { text: MobileData.protection-status != "" ? MobileData.protection-status : @tr("固定节点 · VPN · 代理 DNS · 实时拦截"); wrap: word-wrap; }
            if MobileData.protection-pending: MProgress { indeterminate: true; }
            if root.retry-available: MButton {
                geometry-key: "retry-protection"; text: @tr("重试"); enabled: !MobileData.working;
                clicked => { MobileActions.request(MobileIntent.restart-core, "", ""); }
            }
            MSmall { text: @tr("可能影响其他应用与国内网站；关闭后恢复原状态。"); color: Theme.warning; wrap: word-wrap; }
}
export component MobileAiCheck inherits PageSurface {
    in property <bool> protection-retry;
    property <bool> compact-actions: root.width < 440px || Theme.text-scale > 1.25;
    MScroll { VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        MobileProtection { retry-available: root.protection-retry; }
        GridLayout { spacing: MobileTypography.small-gap;
            MHeading { col: 0; row: 0; text: MobileData.claude-busy ? @tr("正在检测…") : @tr("地区线索检测"); }
            HorizontalLayout {
                col: root.compact-actions ? 0 : 1; row: root.compact-actions ? 1 : 0;
                horizontal-stretch: root.compact-actions ? 1 : 0; spacing: MobileTypography.small-gap;
                MButton { text: @tr("导出报告"); min-width: root.compact-actions ? 0px : max(100px, MobileTypography.font-size(15) * 4 + 24px); clicked => { MobileActions.request(MobileIntent.export-report, "claude", ""); } }
                MButton { text: MobileData.claude-busy ? @tr("取消") : @tr("开始检测"); primary: true;
                    min-width: root.compact-actions ? 0px : max(100px, MobileTypography.font-size(15) * 4 + 24px);
                    clicked => { MobileActions.request(MobileData.claude-busy ? MobileIntent.claude-cancel : MobileIntent.claude-start, "", ""); }
                }
            }
        }
        MSmall { text: MobileData.claude-status; wrap: word-wrap; }
        if MobileData.claude-browser-status != "": VerticalLayout {
            spacing: MobileTypography.small-gap;
            MSmall { text: MobileData.claude-browser-status; wrap: word-wrap; }
            if MobileData.claude-browser-retry: MButton {
                geometry-key: "claude-browser-retry";
                text: @tr("重试浏览器采样");
                clicked => { MobileActions.request(MobileIntent.claude-browser-retry, "", ""); }
            }
        }
        if MobileData.claude-results.length > 0: VerticalLayout { spacing: 8px;
            HorizontalLayout { cross-axis-alignment: center;
                MSmall { text: @tr("报告摘要"); font-weight: 600; }
                MSmall { text: MobileData.claude-normal == "0" && MobileData.claude-risk == "0" && MobileData.claude-clues == "0" ? @tr("暂无检测结果") : @tr("{} 项需关注", MobileData.claude-risk); horizontal-alignment: right; color: MobileData.claude-risk == "0" ? Theme.secondary : Theme.danger; }
            }
            MobileReportBlocks {
                items: MobileData.claude-results;
                show-details(section) => { MobileView.claude-section = section; MobileView.detail = 1; }
            }
        }
    } }
}
export component MobileTools inherits PageSurface {
    MScroll { VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        MSmall { text: @tr("流量与规则"); font-weight: 600; }
        MCard { vertical-padding: 4px; gap: 0px;
            for route[index] in [3, 4, 5]: VerticalLayout { spacing: 0px;
                if index > 0: MDivider { }
                HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: Theme.inset;
                        Image { x: 8px; y: 8px; width: 18px; height: 18px; colorize: Theme.secondary; source: [@image-url("../../icons/connections.svg"), @image-url("../../icons/rules.svg"), @image-url("../../icons/logs.svg")][index]; }
                    }
                    MRow { geometry-key: "preview-tool:" + route; title: [@tr("连接"), @tr("规则"), @tr("日志")][index]; subtitle: index == 0 ? @tr("{} 条活跃连接", MobileData.connection-count) : index == 1 ? @tr("快捷规则与匹配顺序") : @tr("查看与导出运行记录");
                        value: index == 1 && MobileData.rule-dirty ? @tr("尚未应用") : ""; value-color: Theme.warning;
                        clicked => { MobileView.navigate(route); }
                    }
                }
            }
        }
        MSmall { text: @tr("检测与诊断"); font-weight: 600; }
        MCard { vertical-padding: 4px; gap: 0px;
            for route[index] in [6, 7, 8]: VerticalLayout { spacing: 0px;
                if index > 0: MDivider { }
                HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: Theme.inset;
                        Image { x: 8px; y: 8px; width: 18px; height: 18px; colorize: Theme.secondary; source: [@image-url("../../icons/network.svg"), @image-url("../../icons/ip.svg"), @image-url("../../icons/ai.svg")][index]; }
                    }
                MRow { geometry-key: "preview-tool:" + route; title: [@tr("网络诊断"), @tr("IP 检测"), @tr("A÷检测")][index]; subtitle: index == 0 ? @tr("DNS、网站响应与实际线路") : index == 1 ? @tr("平台可用情况与地区报告") : @tr("地区线索与配置");
                        value: index == 2 && MobileData.claude-risk != "0" ? @tr("{} 项需关注", MobileData.claude-risk) : ""; value-color: Theme.danger;
                        clicked => { MobileView.navigate(route); }
                    }
                }
            }
        }
        MobileProtection { }
    } }
}

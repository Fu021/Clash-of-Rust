        MText { col: 2; row: 0; colspan: root.narrow ? 3 : 1; text: root.item.value == "" ? root.item.kind : root.item.value; preferred-width: 0px; font-size: MobileTypography.font-size(14); opacity: root.item.enabled ? 1 : 0.5; }
        MSmall { col: 2; row: 1; colspan: 2; text: root.item.kind + " · " + root.item.source; font-size: MobileTypography.font-size(11); }
        MTag { col: root.narrow ? 5 : 3; row: 0; text: root.item.policy; width-limit: min(90px, max(72px, root.width * 0.2)); }
        MSwitch { col: 4; row: root.narrow ? 1 : 0; rowspan: root.narrow ? 1 : 2; geometry-key: root.floating ? "" : "rule-switch:" + root.item.id; width: 48px; horizontal-stretch: 0; checked: root.item.enabled;
            enabled: root.item.source == "自定义" && !MobileData.protected && !MobileData.protection-pending && !root.floating && !MobileData.working;
            toggled(value) => { MobileActions.request(MobileIntent.rule-enable, root.item.id, ""); }
        }

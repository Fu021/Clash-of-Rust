component ConnectionCloseButton inherits MButton {
    in property <string> connection-id;
    in property <string> current-id;
    in property <int> page-index;
    property <bool> can-close: root.enabled && !MobileView.modal && !MobileView.notice-modal
        && root.connection-id != "" && root.connection-id == root.current-id && root.page-index == MobileData.connection-page-index;
    property <string> target: root.can-close ? root.connection-id + "/" + root.page-index + "/"
        + root.absolute-position.x / 1px + "/" + root.absolute-position.y / 1px : "";
    property <string> settling-target;
    property <string> settled-target;
    property <string> pressed-target;

    geometry-key: "connection-close:" + root.connection-id;
    text: "×"; quiet: true; danger: true; accessible-role: button; accessible-label: @tr("关闭连接");
    enabled: !MobileData.protected && !MobileData.protection-pending;
    selected: press.pressed && root.pressed-target != "" && root.pressed-target == root.target;
    function wait-for-stable-target() {
        root.pressed-target = "";
        root.settled-target = "";
        root.settling-target = root.target;
        if root.settling-target != "" {
            forward-delay.start();
            forward-delay.restart();
        } else {
            forward-delay.stop();
        }
    }
    init => { root.wait-for-stable-target(); }
    changed target => { root.wait-for-stable-target(); }
    forward-delay := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            root.settled-target = root.settling-target;
            self.stop();
        }
    }
    clicked => {
        if root.can-close { MobileActions.request(MobileIntent.close-connection, root.connection-id, ""); }
    }
    press := TouchArea {
        enabled: !MobileView.modal && !MobileView.notice-modal;
        mouse-cursor: root.can-close ? pointer : default;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pressed-target = root.can-close && root.settled-target == root.target ? root.target : "";
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.pressed-target = "";
            }
        }
        clicked => {
            if root.can-close && root.pressed-target == root.target {
                root.clicked();
                root.focus();
            }
        }
    }
}


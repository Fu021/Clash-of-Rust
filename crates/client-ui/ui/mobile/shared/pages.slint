                    col: Theme.text-scale > 1.25 ? 0 : index; row: Theme.text-scale > 1.25 ? index : 0;
                    height: metric.preferred-height; min-width: 0px;
                    metric := VerticalLayout { padding: 12px; spacing: 6px;
                        MSmall { text: title; font-size: MobileTypography.font-size(12); }
                        MHeading { text: [MobileData.claude-normal, MobileData.claude-risk, MobileData.claude-clues][index]; color: index == 0 ? Theme.success : index == 1 ? Theme.danger : Theme.warning; font-size: MobileTypography.font-size(26); }
                    }
                    TouchArea { enabled: !MobileView.modal && !MobileView.notice-modal; mouse-cursor: pointer; clicked => { MobileView.detail = [7, 1, 9][index]; } }
                }
            }
        }
        if MobileData.claude-results.length > 0: VerticalLayout { spacing: 8px;
            MSmall { text: "检测结果"; font-weight: 600; }
            MobileReport { items: MobileData.claude-results; }
        }
    } }
}
export component MobileTools inherits PageSurface {
    MScroll { VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        MSmall { text: "流量与规则"; font-weight: 600; }
        MCard { vertical-padding: 4px; gap: 0px;
            for route[index] in [3, 4, 5]: VerticalLayout { spacing: 0px;
                if index > 0: MDivider { }
                HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: Theme.inset;
                        Image { x: 8px; y: 8px; width: 18px; height: 18px; colorize: Theme.secondary; source: [@image-url("../../icons/connections.svg"), @image-url("../../icons/rules.svg"), @image-url("../../icons/logs.svg")][index]; }
                    }
                    MRow { geometry-key: "preview-tool:" + route; title: ["连接", "规则", "日志"][index]; subtitle: index == 0 ? MobileData.connection-count + " 条活跃连接" : index == 1 ? "快捷规则与匹配顺序" : "查看与导出运行记录";
                        value: index == 1 && MobileData.rule-dirty ? "尚未应用" : ""; value-color: Theme.warning;
                        clicked => { MobileView.navigate(route); }
                    }
                }
            }
        }
        MSmall { text: "检测与诊断"; font-weight: 600; }
        MCard { vertical-padding: 4px; gap: 0px;
            for route[index] in [6, 7, 8]: VerticalLayout { spacing: 0px;
                if index > 0: MDivider { }
                HorizontalLayout { spacing: 12px; cross-axis-alignment: center;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: Theme.inset;
                        Image { x: 8px; y: 8px; width: 18px; height: 18px; colorize: Theme.secondary; source: [@image-url("../../icons/network.svg"), @image-url("../../icons/ip.svg"), @image-url("../../icons/ai.svg")][index]; }
                    }
                MRow { geometry-key: "preview-tool:" + route; title: ["网络诊断", "IP 检测", "A÷检测"][index]; subtitle: index == 0 ? "DNS、网站响应与实际线路" : index == 1 ? "平台可用情况与地区报告" : "地区线索与配置";
                        value: index == 2 && MobileData.claude-risk != "0" ? MobileData.claude-risk + " 风险" : ""; value-color: Theme.danger;
                        clicked => { MobileView.navigate(route); }
                    }
                }
            }
        }
        MobileProtection { }
    } }
}

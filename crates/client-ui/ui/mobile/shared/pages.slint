import { PageSurface, Disclosure, Entrance, Motion } from "../../components/motion.slint";
import { ListReorderGesture, ListReorderPreview } from "../../components/list-reorder.slint";
import { PageViews, ViewModeIcon } from "../../components/view-toggle.slint";
import { GeometryTarget } from "../../components/geometry.slint";
import { Panel } from "../../components/controls.slint";
import { MobileTypography } from "typography.slint";
import { Theme } from "../../theme/palette.slint";
import { ConnectionPower } from "../../components/brand.slint";
import { MobileNetworkInfo, MobileServices } from "overview.slint";
import { MobileReport } from "reports.slint";
import { HomeConnections } from "../../components/home-section.slint";
import { NodeItem, ProfileItem, CategoryItem, ConnectionItem, RuleItem, LogItem } from "../../state.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "state.slint";
import { MText, MSmall, MHeading, MParagraph, MCard, MButton, MPagination, MRow, MDivider, MSwitch, MField, MSelect, MTag, MNav, MScroll, ListView, ListHeader, MProgress, MCopyButton, MDragHandle, MToolHeading } from "controls.slint";

component StatusCard inherits MCard {
    vertical-padding: 18px; gap: 12px;
    HorizontalLayout { cross-axis-alignment: center; spacing: 14px;
        VerticalLayout { spacing: 8px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            HorizontalLayout { spacing: 6px;
                MSmall { text: "● " + (MobileData.vpn-connected ? "已连接" : MobileData.vpn-pending ? "连接中…" : "未连接"); horizontal-stretch: 0; color: MobileData.vpn-connected ? Theme.success : Theme.secondary; }
                MSmall { text: "· " + MobileData.profile; preferred-width: 0px; }
            }
            Rectangle { height: max(40px, name.preferred-height);
                name := MHeading { width: parent.width; height: parent.height; text: MobileData.node; font-size: MobileTypography.font-size(26); }
                TouchArea { mouse-cursor: pointer; clicked => { MobileView.navigate(1); } }
            }
            MSmall { text: MobileData.vpn-connected ? "VPN  ·  全局网络接管" : MobileData.vpn-pending ? "等待系统授权" : "系统网络"; }
        }
        ConnectionPower {
            width: 52px; height: 52px;
            connected: MobileData.vpn-connected;
            label: MobileData.vpn-connected ? "断开 VPN" : MobileData.vpn-pending ? "取消连接" : "连接 VPN";
            enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending && !MobileView.modal && !MobileView.notice-modal;
            clicked => { MobileActions.request(MobileData.vpn-connected || MobileData.vpn-pending ? MobileIntent.disconnect : MobileIntent.connect, "", ""); }
        }
    }
    MDivider { }
    GridLayout { spacing: 4px;
        for label[index] in ["规则", "全局", "直连"]: MButton {
            col: Theme.text-scale > 1.25 ? 0 : index; row: Theme.text-scale > 1.25 ? index : 0;
            text: label; quiet: true; selected: MobileData.mode == index;
            enabled: MobileData.core-running && !MobileData.protected && !MobileData.protection-pending;
            clicked => { MobileActions.request(MobileIntent.mode, "" + index, ""); }
        }
    }
    if !MobileData.core-running: MButton { geometry-key: "retry-core"; text: "重试启动"; enabled: !MobileData.working && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.restart-core, "", ""); } }
}
component TrafficCard inherits MCard {
    GridLayout { spacing: 16px;
        for label[index] in ["↓ 下载", "↑ 上传", "活跃连接", "本次累计"]: VerticalLayout {
            col: Theme.text-scale > 1.25 ? 0 : mod(index, 2); row: Theme.text-scale > 1.25 ? index : floor(index / 2);
            spacing: 6px; min-width: 0px;
            MSmall { text: label; }
            MHeading { text: index == 0 ? (MobileData.vpn-connected ? MobileData.download-rate : "0 B/s") : index == 1 ? (MobileData.vpn-connected ? MobileData.upload-rate : "0 B/s") : index == 2 ? (MobileData.core-running ? MobileData.connection-count : "0") : MobileData.download-total;
                font-size: MobileTypography.font-size(20);
            }
            MSmall { text: index == 0 ? "累计 " + MobileData.download-total : index == 1 ? "累计 " + MobileData.upload-total : index == 2 ? "查看实时连接" : "↑ " + MobileData.upload-total; font-size: MobileTypography.font-size(12); }
        }
    }
}
component ConnectionFeed inherits HomeConnections {
    items: MobileData.connections; count: MobileData.connection-count; running: MobileData.core-running;
    enabled: !MobileView.modal && !MobileView.notice-modal;
    title-size: MobileTypography.font-size(16); body-size: MobileTypography.font-size(14);
    caption-size: MobileTypography.font-size(12); control-size: 48px;
    open-all => { MobileView.navigate(3); }
    item-selected(id) => {
        MobileView.navigate(3); MobileView.selected-id = id;
        MobileActions.request(MobileIntent.connection-detail, id, ""); MobileView.detail = 5;
    }
}
export component MobileHome inherits PageSurface {
    property <bool> wide: root.width / Theme.text-scale >= 640px;
    property <length> column-width: (root.width - MobileTypography.padding) / 2;
    MScroll {
        content-y <=> MobileView.home-scroll-y;
        if !root.wide: VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
            StatusCard { } TrafficCard { }
            MobileNetworkInfo { width: root.width; available-width: root.width; }
            MobileServices { width: root.width; available-width: root.width; }
            ConnectionFeed { width: root.width; }
        }
        if root.wide: HorizontalLayout { spacing: MobileTypography.padding; width: root.width;
            VerticalLayout { width: root.column-width; horizontal-stretch: 0; alignment: start; spacing: MobileTypography.gap;
                StatusCard { } TrafficCard { }
                MobileNetworkInfo { available-width: root.column-width; }
            }
            VerticalLayout { width: root.column-width; horizontal-stretch: 0; alignment: start; spacing: MobileTypography.gap;
                MobileServices { available-width: root.column-width; }
                ConnectionFeed { limit: 4; }
            }
        }
    }
}

component NodeCard inherits MCard {
    in property <NodeItem> item;
    in property <string> group;
    in property <bool> detailed;
    in property <bool> list-view;
    callback detail-requested();
    vertical-padding: (root.list-view ? 4px : 8px) * MobileTypography.density;
    horizontal-padding: 10px;
    gap: (root.list-view ? 2px : 4px) * MobileTypography.density;
    border-radius: 10px;
    selected: root.item.selected;
    interactive: MobileData.core-running && !MobileData.protected && !MobileData.protection-pending;
    clicked => { MobileActions.request(MobileIntent.select-node, root.group, root.item.name); }
    if root.list-view: HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
        MText { text: root.item.name; font-size: MobileTypography.font-size(14); font-weight: 500; }
        MButton { text: root.item.delay; compact: true; quiet: true; text-color: Theme.tone-color(root.item.tone); width: 62px; horizontal-stretch: 0; enabled: !MobileData.delay-busy && !MobileData.protection-pending;
            clicked => { MobileActions.request(MobileIntent.node-delay, root.item.name, ""); }
        }
        MButton { text: "⋯"; compact: true; quiet: true; width: 48px; horizontal-stretch: 0;
            accessible-role: button; accessible-label: "节点详情"; clicked => { root.detail-requested(); }
        }
    }
    if !root.list-view: VerticalLayout { spacing: 4px * MobileTypography.density;
        HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
            MText { text: root.item.name; font-size: MobileTypography.font-size(14); font-weight: 500; }
            MButton { text: "⋯"; compact: true; quiet: true; width: 48px; horizontal-stretch: 0;
                accessible-role: button; accessible-label: "节点详情"; clicked => { root.detail-requested(); }
            }
        }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.small-gap;
            MSmall { text: root.item.kind; font-size: MobileTypography.font-size(12); }
            MButton { text: root.item.delay; compact: true; quiet: true; text-color: Theme.tone-color(root.item.tone); width: 62px; horizontal-stretch: 0; enabled: !MobileData.delay-busy && !MobileData.protection-pending;
                clicked => { MobileActions.request(MobileIntent.node-delay, root.item.name, ""); }
            }
        }
    }
    if root.detailed: VerticalLayout { spacing: MobileTypography.small-gap;
        MSmall { text: "完整名称：" + root.item.name; wrap: word-wrap; }
        MSmall { text: "协议：" + root.item.kind + (root.selected ? (MobileData.protected ? " · 已锁定" : " · 使用中") : ""); wrap: word-wrap; }
    }
}
export component MobileProxies inherits PageSurface {
    motion-revision: PageViews.nodes-list ? 1 : 0;
    motion-enabled: Motion.layout-active;
    property <string> detail-group;
    property <string> detail-node;
    function show-detail(group: string, node: string) {
        self.detail-node = self.detail-group == group && self.detail-node == node ? "" : node;
        self.detail-group = group;
    }
    MScroll { content-key: MobileView.query + "/" + MobileView.node-sort; VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
            MButton { geometry-key: "nodes-view"; width: 48px; height: 48px; horizontal-stretch: 0; quiet: true;
                accessible-label: PageViews.nodes-list ? "切换到宫格视图" : "切换到列表视图";
                ViewModeIcon { list-view: PageViews.nodes-list; x: 14px; y: 14px + parent.press-offset; width: 20px; height: 20px; }
                clicked => { PageViews.nodes-list = !PageViews.nodes-list; }
            }
            MField { placeholder: "搜索节点或策略组"; text <=> MobileView.query; edited(value) => { MobileActions.request(MobileIntent.query, "proxies", value); } }
        }
        HorizontalLayout { spacing: MobileTypography.small-gap;
            MSelect { options: ["延迟从低到高", "延迟从高到低", "名称排序"]; value: self.options[MobileView.node-sort];
                selected(index, value) => { MobileView.node-sort = index; MobileActions.request(MobileIntent.node-sort, "" + index, ""); }
            }
            MButton { geometry-key: "preview-measure-all"; text: MobileData.delay-busy ? "测速中…" : "全部测速"; compact: true; busy: MobileData.delay-busy; width: max(84px, MobileTypography.font-size(13) * 4 + 16px); horizontal-stretch: 0; enabled: MobileData.core-running && !MobileData.delay-busy && !MobileData.protection-pending;
                clicked => { MobileActions.request(MobileIntent.delay-all, "", ""); }
            }
        }
        for group in MobileData.groups: group-card := MCard {
            property <bool> expanded: group.expanded;
            HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.small-gap;
                MRow { title: group.title; subtitle: group.detail; value: group-card.expanded ? "收起" : "展开"; expandable: true; expanded: group-card.expanded;
                    clicked => { group-card.expanded = !group-card.expanded; }
                }
                if root.width > 580px: MTag { text: group.current; width-limit: 180px; }
                MButton { text: group.testing ? "测速中…" : "组测速"; compact: true; busy: group.testing; width: max(72px, MobileTypography.font-size(13) * 3 + 16px); horizontal-stretch: 0; enabled: MobileData.core-running && !MobileData.delay-busy && !MobileData.protection-pending;
                    GeometryTarget { key: "preview-measure-group:" + group.id; bounds: [parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height]; }
                    clicked => { MobileActions.request(MobileIntent.group-delay, group.id, ""); }
                }
            }
            group-body := Disclosure { expanded: group-card.expanded;
                if group-body.mounted: VerticalLayout { spacing: 10px;
                    for pair in group.nodes: VerticalLayout { spacing: 10px;
                        if PageViews.nodes-list || root.width < 340px || Theme.text-scale > 1.25: NodeCard { item: pair.left; group: group.id; list-view: PageViews.nodes-list;
                            detailed: root.detail-group == group.id && root.detail-node == pair.left.name;
                            detail-requested => { root.show-detail(group.id, pair.left.name); }
                        }
                        if (PageViews.nodes-list || root.width < 340px || Theme.text-scale > 1.25) && pair.right.valid: NodeCard { item: pair.right; group: group.id; list-view: PageViews.nodes-list;
                            detailed: root.detail-group == group.id && root.detail-node == pair.right.name;
                            detail-requested => { root.show-detail(group.id, pair.right.name); }
                        }
                        if !PageViews.nodes-list && root.width >= 340px && Theme.text-scale <= 1.25: HorizontalLayout { spacing: 8px;
                            NodeCard { item: pair.left; group: group.id; list-view: false;
                                detailed: root.detail-group == group.id && root.detail-node == pair.left.name;
                                detail-requested => { root.show-detail(group.id, pair.left.name); }
                            }
                            if pair.right.valid: NodeCard { item: pair.right; group: group.id; list-view: false;
                                detailed: root.detail-group == group.id && root.detail-node == pair.right.name;
                                detail-requested => { root.show-detail(group.id, pair.right.name); }
                            }
                            if !pair.right.valid: Rectangle { }
                        }
                    }
                    HorizontalLayout { alignment: start;
                        MPagination {
                            status: group.page; previous-enabled: group.previous; next-enabled: group.next;
                            compact: root.width >= 640px; horizontal-stretch: self.compact ? 0 : 1;
                            turn(direction) => { MobileActions.request(MobileIntent.node-page, group.id, "" + direction); }
                        }
                    }
                }
            }
        }
    } }
}
export component MobileSubscriptions inherits PageSurface {
    motion-revision: PageViews.profiles-list ? 1 : 0;
    motion-enabled: Motion.layout-active;
    property <string> expanded-id;
    MScroll { VerticalLayout { alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
        MCard { vertical-padding: 6px; horizontal-padding: 8px;
          HorizontalLayout { spacing: 6px; cross-axis-alignment: center;
            MButton { geometry-key: "profiles-view"; width: 48px; height: 48px; horizontal-stretch: 0; quiet: true;
                accessible-label: PageViews.profiles-list ? "切换到宫格视图" : "切换到列表视图";
                ViewModeIcon { list-view: PageViews.profiles-list; x: 14px; y: 14px + parent.press-offset; width: 20px; height: 20px; }
                clicked => { PageViews.profiles-list = !PageViews.profiles-list; }
            }
            MField { placeholder: "粘贴订阅链接"; text <=> MobileView.profile-source; enabled: !MobileData.protected && !MobileData.protection-pending; }
            MButton { text: "导入"; compact: true; primary: true; enabled: !MobileData.profile-busy && !MobileData.protected && !MobileData.protection-pending; width: 56px; horizontal-stretch: 0;
                property <[length]> target: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
                changed target => { MobileView.profile-add-target = self.target; }
                init => { MobileView.profile-add-target = self.target; }
                clicked => { MobileView.selected-id = ""; MobileView.profile-name = ""; MobileView.detail = 3; }
            }
          }
        }
        profile-grid := VerticalLayout {
        property <int> columns: PageViews.profiles-list ? 1 : max(1, floor(root.width / (288px * Theme.text-scale)));
        spacing: MobileTypography.gap; alignment: start;
        for row in ceil(MobileData.profiles.length / profile-grid.columns): HorizontalLayout {
          spacing: MobileTypography.gap; cross-axis-alignment: start;
          for column in profile-grid.columns: slot := VerticalLayout {
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; alignment: start;
            property <int> profile-index: row * profile-grid.columns + column;
            if slot.profile-index < MobileData.profiles.length: card := MCard {
            property <ProfileItem> profile: MobileData.profiles[slot.profile-index];
            GeometryTarget { key: "profile:" + profile.id; bounds: [card.absolute-position.x, card.absolute-position.y, card.width, card.height]; }
            min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            property <bool> detailed: root.expanded-id == profile.id;
            property <bool> mutable: !MobileData.profile-busy && !MobileData.protected && !MobileData.protection-pending;
            vertical-padding: (PageViews.profiles-list ? 4px : 10px) * MobileTypography.density;
            gap: (PageViews.profiles-list ? 2px : 4px) * MobileTypography.density;
            HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.small-gap;
                Rectangle { width: 32px; height: 32px; border-radius: 9px; background: profile.active ? Theme.accent-wash : Theme.inset;
                    Image { source: @image-url("../../icons/subscriptions.svg"); colorize: profile.active ? Theme.accent : Theme.secondary; x: 7px; y: 7px; width: 18px; height: 18px; }
                }
                MHeading { text: profile.name; preferred-width: 0px; font-size: MobileTypography.font-size(15); }
                MTag { text: profile.local ? "本地" : "订阅"; tone: 4; }
            }
            if !PageViews.profiles-list: VerticalLayout { spacing: 4px * MobileTypography.density;
                MSmall { text: profile.source; font-size: MobileTypography.font-size(12); }
                MSmall { text: profile.detail; wrap: word-wrap; font-size: MobileTypography.font-size(12); }
            }
            HorizontalLayout {
                spacing: MobileTypography.small-gap;
                MButton { geometry-key: "profile-use:" + profile.id; text: profile.active ? "使用中" : "使用"; compact: true; primary: !profile.active; selected: profile.active; opacity: profile.active || self.enabled ? 1 : 0.5; enabled: !profile.active && card.mutable;
                    clicked => { MobileActions.request(MobileIntent.activate-profile, profile.id, ""); }
                }
                MButton { geometry-key: "profile-detail:" + profile.id; text: card.detailed ? "收起" : "详情"; compact: true; quiet: true;
                    clicked => { root.expanded-id = card.detailed ? "" : profile.id; }
                }
            }
            if card.detailed: VerticalLayout { spacing: MobileTypography.small-gap;
                MSmall { text: "完整名称：" + profile.name; wrap: word-wrap; }
                MSmall { text: profile.detail; wrap: word-wrap; }
                MSmall { text: "来源：" + profile.source; wrap: word-wrap; }
                HorizontalLayout { spacing: MobileTypography.small-gap;
                    MButton { geometry-key: "profile-update:" + profile.id; text: "更新"; compact: true; quiet: true; enabled: !profile.local && !profile.builtin && card.mutable;
                        clicked => { MobileActions.request(MobileIntent.update-profile, profile.id, ""); }
                    }
                    MButton { geometry-key: "profile-edit:" + profile.id; text: "编辑"; compact: true; quiet: true; enabled: !profile.builtin && card.mutable;
                        clicked => { MobileView.selected-id = profile.id; MobileView.profile-name = profile.name; MobileView.profile-source = profile.source; MobileView.detail = 3; }
                    }
                    MButton { geometry-key: "profile-delete:" + profile.id; text: "删除"; compact: true; danger: !profile.builtin; enabled: !profile.builtin && card.mutable;
                        clicked => { MobileView.selected-id = profile.id; MobileView.profile-name = profile.name; MobileView.profile-active = profile.active; MobileView.detail = 4; } }
                }
            }
        }
        }
        }
        }
    } }
}
component ConnectionsToolbar inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.small-gap; vertical-stretch: 0;
    padding: 12px;
    MField {
        GeometryTarget { key: "connections-search"; bounds: [parent.absolute-position.x, parent.absolute-position.y, parent.width, parent.height]; }
        placeholder: "搜索域名、IP、规则或线路"; text <=> MobileView.query; edited(value) => { MobileActions.request(MobileIntent.query, "connections", value); }
    }
    GridLayout { spacing: MobileTypography.small-gap;
        property <bool> narrow: root.width - 24px < 300px || Theme.text-scale > 1.25;
        MSelect { col: 0; row: 0; colspan: parent.narrow ? 2 : 1;
            geometry-key: "connections-sort";
            value: MobileView.connection-sort; options: ["下载速度 ↓", "下载速度 ↑", "上传速度 ↓", "上传速度 ↑", "下载量 ↓", "下载量 ↑", "名称 A–Z", "名称 Z–A"];
            selected(index, value) => { MobileView.connection-sort = value; MobileActions.request(MobileIntent.connection-sort, value, ""); }
        }
        MButton { col: 1; row: parent.narrow ? 1 : 0;
            geometry-key: "connections-close-all";
            text: "关闭全部"; width: max(100px, MobileTypography.font-size(15) * 4 + 16px); horizontal-stretch: 0; danger: true; enabled: !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.close-all, "", ""); } }
        MSmall { col: 0; row: 1; colspan: parent.narrow ? 1 : 2; text: MobileData.connection-count + " 条活跃连接"; preferred-width: 0px; }
    }
}
component ConnectionsRow inherits Rectangle {
    in property <ConnectionItem> item;
    in property <bool> last;
    property <bool> stacked: root.width < 600px || Theme.text-scale > 1.25;
    GeometryTarget { key: "connection-row:" + root.item.id; bounds: [root.absolute-position.x, root.absolute-position.y, root.width, root.height]; }
    GeometryTarget { key: "connection-name:" + root.item.id; bounds: [identity.absolute-position.x, identity.absolute-position.y, identity.width, identity.height]; }
    height: max(76px, content.preferred-height + 20px);
    background: MobileView.detail == 5 && MobileView.selected-id == root.item.id ? Theme.accent-wash : Theme.surface;
    TouchArea { enabled: !MobileView.modal && !MobileView.notice-modal; mouse-cursor: pointer;
        accessible-role: button; accessible-label: "查看连接详情：" + root.item.host;
        accessible-action-default => { MobileView.selected-id = root.item.id; MobileActions.request(MobileIntent.connection-detail, root.item.id, ""); MobileView.detail = 5; }
        clicked => { MobileView.selected-id = root.item.id; MobileActions.request(MobileIntent.connection-detail, root.item.id, ""); MobileView.detail = 5; }
    }
    content := GridLayout { x: 12px; y: 10px; width: parent.width - 24px; height: self.preferred-height; spacing: 8px;
        identity := VerticalLayout { col: 0; row: 0; colspan: root.stacked ? 3 : 1; spacing: 5px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 2;
            MText { text: root.item.host; font-size: MobileTypography.font-size(14); font-weight: 500; preferred-width: 0px; }
            MSmall { text: root.item.detail; font-size: MobileTypography.font-size(12); preferred-width: 0px; }
        }
        VerticalLayout { col: root.stacked ? 0 : 1; row: root.stacked ? 1 : 0; colspan: root.stacked ? 4 : 1;
            spacing: 5px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 2;
            MSmall { text: root.item.route; font-size: MobileTypography.font-size(12); }
            MSmall { text: root.item.rule; font-size: MobileTypography.font-size(12); }
        }
        VerticalLayout { col: root.stacked ? 0 : 2; row: root.stacked ? 2 : 0; colspan: root.stacked ? 2 : 1;
            spacing: 5px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            MSmall { text: "↓ " + root.item.down; }
            MSmall { text: root.item.download; color: Theme.muted; font-size: MobileTypography.font-size(12); }
        }
        VerticalLayout { col: root.stacked ? 2 : 3; row: root.stacked ? 2 : 0; colspan: root.stacked ? 2 : 1;
            spacing: 5px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            MSmall { text: "↑ " + root.item.up; }
            MSmall { text: root.item.upload; color: Theme.muted; font-size: MobileTypography.font-size(12); }
        }
        Rectangle { col: root.stacked ? 3 : 4; row: 0;
            width: 48px; height: close-action.height; horizontal-stretch: 0; vertical-stretch: 0;
            TouchArea { enabled: !MobileView.modal && !MobileView.notice-modal; }
            close-action := MButton {
                geometry-key: "connection-close:" + root.item.id;
                text: "×"; quiet: true; width: parent.width; danger: true; accessible-role: button; accessible-label: "关闭连接";
                enabled: !MobileData.protected && !MobileData.protection-pending;
                clicked => { MobileActions.request(MobileIntent.close-connection, root.item.id, ""); }
            }
        }
    }
    if !root.last: MDivider { y: parent.height - 1px; width: parent.width; }
}
component ConnectionsFooter inherits HorizontalLayout {
    alignment: start; vertical-stretch: 0;
    MPagination {
        status: MobileData.connection-page;
        previous-enabled: MobileData.connection-previous; next-enabled: MobileData.connection-next;
        compact: root.width >= 640px; horizontal-stretch: self.compact ? 0 : 1;

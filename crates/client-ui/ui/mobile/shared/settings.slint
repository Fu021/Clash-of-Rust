import { MobileTypography } from "typography.slint";
import { Theme, AccentPalette } from "../../theme/palette.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "state.slint";
import { MText, MSmall, MParagraph, MHeading, MCard, MButton, MRow, MDivider, MSwitch, MField, MSelect } from "controls.slint";

export component AppearanceSettings inherits VerticalLayout {
    in property <bool> custom-font-size: true;
    property <bool> stack-themes: Theme.text-scale >= 1.25;
    alignment: start; spacing: 10px;
    MHeading { text: "外观"; }
    MCard {
        MSmall { text: "主题"; }
        GridLayout { spacing: MobileTypography.small-gap;
            for label[i] in ["深色", "浅色", "跟随系统"]: MButton { text: label; selected: Theme.appearance == i;
                col: root.stack-themes ? 0 : i; row: root.stack-themes ? i : 0;
                clicked => { Theme.appearance = i; MobileActions.request(MobileIntent.appearance, "" + i, ""); }
            }
        }
        MDivider { }
        MRow { title: "强调色"; value: AccentPalette.accent-names[Theme.accent-index]; show-swatch: true; swatch: Theme.accent; clicked => { MobileView.detail = 11; } }
        if root.custom-font-size: MDivider { }
        if root.custom-font-size: HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MText { text: "字号"; }
            MSelect { width: 128px; horizontal-stretch: 0; options: ["80%", "90%", "100%", "110%", "125%", "150%"];
                value: "" + round(Theme.text-scale * 100) + "%";
                selected(index, value) => { Theme.text-scale = [0.8, 0.9, 1.0, 1.1, 1.25, 1.5][index]; MobileActions.request(MobileIntent.text-scale, value, ""); }
            }
        }
    }
}
export component NetworkToggles inherits VerticalLayout {
    in property <bool> show-fake-ip-exclusions;
    alignment: start; spacing: MobileTypography.small-gap;
    MSwitch { title: "DNS 覆盖"; checked: MobileData.dns-override || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.dns-override, value ? "true" : "false", ""); }
    }
    MDivider { }
    MSwitch { title: "Fake-IP"; subtitle: "关闭 DNS 覆盖会同时关闭 Fake-IP，重开后可在此启用。"; checked: MobileData.fake-ip || MobileData.protected; enabled: MobileData.dns-override && !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.fake-ip, value ? "true" : "false", ""); }
    }
    if root.show-fake-ip-exclusions: MDivider { }
    if root.show-fake-ip-exclusions: MRow { title: "Fake-IP 排除项"; value: MobileData.fake-ip-exclusions.length + " 项"; clicked => { MobileView.detail = 14; } }
    MDivider { }
    MSwitch { title: "启用 IPv6"; checked: MobileData.ipv6 || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.ipv6, value ? "true" : "false", ""); }
    }
    MDivider { }
    MSwitch { title: "启用 UDP"; checked: MobileData.udp || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.udp, value ? "true" : "false", ""); }
    }
}
export component ScheduleSettings inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MHeading { text: "计划任务"; }
    MCard {
        MText { text: "订阅自动更新"; }
        MSmall { text: "分钟 · 0 关闭 · 默认 360"; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MField { text <=> MobileData.subscription-interval; enabled: !MobileData.working; edited(value) => { MobileView.subscription-interval-dirty = true; } }
            MButton { text: "保存"; enabled: !MobileData.working; clicked => { MobileActions.request(MobileIntent.subscription-interval, MobileData.subscription-interval, ""); } }
        }
        MSmall { text: "仅更新远程订阅；失败保留原配置，保护期间跳过已锁定订阅。"; wrap: word-wrap; }
        MDivider { }
        MText { text: "定时测速"; }
        MSmall { text: "分钟 · 0 关闭"; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MField { text <=> MobileData.interval; edited(value) => { MobileView.interval-dirty = true; } }
            MButton { text: "保存"; clicked => { MobileActions.request(MobileIntent.interval, MobileData.interval, ""); } }
        }
    }
}
export component CurrentVersion inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.small-gap;
    MText { text: "当前版本"; }
    MSmall { text: MobileData.version; wrap: word-wrap; }
}
export component GeoSettingsContents inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.gap;
    MText { text: "Geo 数据"; }
    MParagraph { text: MobileData.geo-status; color: Theme.secondary; font-size: MobileTypography.font-size(14); }
    MButton { text: "更新所有 Geo 数据"; busy: MobileData.geo-updating; enabled: !MobileData.working && !MobileData.geo-updating; clicked => { MobileActions.request(MobileIntent.update-geo, "", ""); } }
}

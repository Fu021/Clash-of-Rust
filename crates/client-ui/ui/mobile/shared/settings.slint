import { MobileTypography } from "typography.slint";
import { Theme, AccentPalette } from "../../theme/palette.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "state.slint";
import { MText, MSmall, MParagraph, MHeading, MCard, MButton, MRow, MDivider, MSwitch, MField, MSelect } from "controls.slint";

component AppearanceThemeButton inherits MButton {
    in property <int> index;
    text: root.index == 0 ? "深色" : root.index == 1 ? "浅色" : "跟随系统";
    selected: Theme.appearance == root.index;
    geometry-key: "appearance-theme:" + root.index;
    clicked => { Theme.appearance = root.index; MobileActions.request(MobileIntent.appearance, "" + root.index, ""); }
}

component AppearanceAccentButton inherits MButton {
    in property <int> index;
    min-width: 48px;
    text: ""; quiet: true; selected: Theme.accent-index == root.index;
    geometry-key: "appearance-accent:" + root.index;
    accessible-role: button; accessible-label: AccentPalette.accent-names[root.index];
    Rectangle { x: (parent.width - 20px) / 2; y: (parent.height - 20px) / 2; width: 20px; height: 20px; border-radius: 10px;
        background: Theme.dark ? AccentPalette.dark-colors[root.index] : AccentPalette.accent-colors[root.index];
    }
    clicked => { Theme.accent-index = root.index; MobileActions.request(MobileIntent.accent, "" + root.index, ""); }
}

export component AppearanceSettings inherits VerticalLayout {
    in property <bool> custom-font-size: true;
    property <bool> stack-themes: Theme.text-scale >= 1.25;
    alignment: start; spacing: 10px;
    MSmall { text: "外观"; font-weight: 600; }
    MCard {
        MSmall { text: "主题"; }
        GridLayout { spacing: MobileTypography.small-gap;
            AppearanceThemeButton { index: 0; col: 0; row: 0; }
            AppearanceThemeButton { index: 1; col: root.stack-themes ? 0 : 1; row: root.stack-themes ? 1 : 0; }
            AppearanceThemeButton { index: 2; col: root.stack-themes ? 0 : 2; row: root.stack-themes ? 2 : 0; }
        }
        MDivider { }
        HorizontalLayout {
            cross-axis-alignment: center; spacing: MobileTypography.gap;
            MText { text: "强调色"; }
            MSmall { text: AccentPalette.accent-names[Theme.accent-index]; horizontal-stretch: 0; }
        }
        swatches := GridLayout {
            property <int> columns: self.width >= 308px ? 6 : 3;
            spacing: 4px;
            AppearanceAccentButton { index: 0; col: 0; row: 0; }
            AppearanceAccentButton { index: 1; col: 1; row: 0; }
            AppearanceAccentButton { index: 2; col: 2; row: 0; }
            AppearanceAccentButton { index: 3; col: swatches.columns == 6 ? 3 : 0; row: swatches.columns == 6 ? 0 : 1; }
            AppearanceAccentButton { index: 4; col: swatches.columns == 6 ? 4 : 1; row: swatches.columns == 6 ? 0 : 1; }
            AppearanceAccentButton { index: 5; col: swatches.columns == 6 ? 5 : 2; row: swatches.columns == 6 ? 0 : 1; }
        }
        if root.custom-font-size: MDivider { }
        if root.custom-font-size: HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MText { text: "字号"; }
            MSelect { width: 128px; horizontal-stretch: 0; options: ["80%", "90%", "100%", "110%", "125%", "150%"];
                value: "" + round(Theme.text-scale * 100) + "%";
                geometry-key: "appearance-scale";
                selected(index, value) => { Theme.text-scale = [0.8, 0.9, 1.0, 1.1, 1.25, 1.5][index]; MobileActions.request(MobileIntent.text-scale, value, ""); }
            }
        }
    }
}
export component NetworkToggles inherits VerticalLayout {
    in property <bool> show-fake-ip-exclusions;
    alignment: start; spacing: MobileTypography.small-gap;
    MSwitch { title: "DNS 覆盖"; checked: MobileData.dns-override || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.dns-override, value ? "true" : "false", ""); }
    }
    MDivider { }
    MSwitch { title: "Fake-IP"; subtitle: "关闭 DNS 覆盖会同时关闭 Fake-IP，重开后可在此启用。"; checked: MobileData.fake-ip || MobileData.protected; enabled: MobileData.dns-override && !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.fake-ip, value ? "true" : "false", ""); }
    }
    if root.show-fake-ip-exclusions: MDivider { }
    if root.show-fake-ip-exclusions: MRow { title: "Fake-IP 排除项"; value: MobileData.fake-ip-exclusions.length + " 项"; clicked => { MobileView.detail = 14; } }
    MDivider { }
    MSwitch { title: "启用 IPv6"; checked: MobileData.ipv6 || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.ipv6, value ? "true" : "false", ""); }
    }
    MDivider { }
    MSwitch { title: "启用 UDP"; checked: MobileData.udp || MobileData.protected; enabled: !MobileData.protected && !MobileData.protection-pending;
        toggled(value) => { MobileActions.request(MobileIntent.udp, value ? "true" : "false", ""); }
    }
}
export component ScheduleSettings inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MHeading { text: "计划任务"; }
    MCard {
        MText { text: "自动检查更新"; }
        MSmall { text: "分钟 · 0 关闭 · 默认 360"; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MField { text <=> MobileData.update-interval; enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending; edited(value) => { MobileView.update-interval-dirty = true; } }
            MButton { text: "保存"; enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.update-interval, MobileData.update-interval, ""); } }
        }
        MSmall { text: "内核运行时自动检查；Claude 保护期间暂停。"; wrap: word-wrap; }
        MDivider { }
        MText { text: "订阅自动更新"; }
        MSmall { text: "分钟 · 0 关闭 · 默认 360"; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MField { text <=> MobileData.subscription-interval; enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending; edited(value) => { MobileView.subscription-interval-dirty = true; } }
            MButton { text: "保存"; enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.subscription-interval, MobileData.subscription-interval, ""); } }
        }
        MSmall { text: "仅远程订阅；Claude 保护期间暂停。"; wrap: word-wrap; }
        MDivider { }
        MText { text: "定时测速"; }
        MSmall { text: "分钟 · 0 关闭"; wrap: word-wrap; }
        HorizontalLayout { cross-axis-alignment: center; spacing: MobileTypography.gap;
            MField { text <=> MobileData.interval; enabled: !MobileData.protected && !MobileData.protection-pending; edited(value) => { MobileView.interval-dirty = true; } }
            MButton { text: "保存"; enabled: !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.interval, MobileData.interval, ""); } }
        }
    }
}
export component CurrentVersion inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.small-gap;
    MText { text: "当前版本"; }
    MSmall { text: MobileData.version; wrap: word-wrap; }
}
export component GeoSettingsContents inherits VerticalLayout {
    alignment: start; spacing: MobileTypography.gap;
    MText { text: "Geo 数据"; }
    MParagraph { text: MobileData.geo-status; color: Theme.secondary; font-size: MobileTypography.font-size(14); }
    MButton { text: "更新所有 Geo 数据"; busy: MobileData.geo-updating; enabled: !MobileData.working && !MobileData.geo-updating && !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.update-geo, "", ""); } }
}

import { PageSurface, Presence } from "../../components/motion.slint";
import { MobileTypography } from "typography.slint";
import { Theme, AccentPalette } from "../../theme/palette.slint";
import { MobileData, MobileView, MobileActions, MobileIntent, ConnectionDetailSnapshot, ConnectionDetailStatus } from "state.slint";
import { DetailItem } from "../../models.slint";
import { GeometryTarget } from "../../components/geometry.slint";
import { YamlDocument } from "../../components/yaml-document.slint";
import { MText, MSmall, MHeading, MParagraph, MCard, MButton, MRow, MDivider, MField, MSelect, MTag, MScroll, MCopyButton, MSwitch } from "controls.slint";
import { MobileFakeIp, MobileRuleActions, MobileSiteResults } from "editors.slint";
import { MobileReport } from "reports.slint";

export component MobileConnectionDetails inherits VerticalLayout {
    in property <string> selected-id;
    in property <int> request;
    in property <ConnectionDetailSnapshot> snapshot;
    in property <bool> close-supported;
    property <bool> narrow: root.width < 460px * Theme.text-scale;
    property <ConnectionDetailStatus> status:
        root.selected-id != "" && root.snapshot.id == root.selected-id && root.snapshot.request == root.request
        && (root.snapshot.status != ConnectionDetailStatus.available || root.snapshot.rows.length > 0)
            ? root.snapshot.status : ConnectionDetailStatus.unavailable;
    property <bool> available: root.status == ConnectionDetailStatus.available;
    spacing: MobileTypography.gap;

    MScroll {
        content-key: root.selected-id + "/" + root.request;
        if root.available: rows-card := MCard {
            GeometryTarget {
                key: "connection-detail-rows";
                bounds: [rows-card.absolute-position.x, rows-card.absolute-position.y, rows-card.width, rows-card.height];
            }
            for row[index] in root.snapshot.rows: VerticalLayout {
                spacing: MobileTypography.small-gap;
                MSmall { text: row.label; }
                MParagraph { text: row.value; }
                if index + 1 < root.snapshot.rows.length: MDivider { }
            }
        }
        if !root.available: status-card := MCard {
            GeometryTarget {
                key: root.status == ConnectionDetailStatus.loading ? "connection-detail-loading"
                    : root.status == ConnectionDetailStatus.ended ? "connection-detail-ended" : "connection-detail-unavailable";
                bounds: [status-card.absolute-position.x, status-card.absolute-position.y, status-card.width, status-card.height];
            }
            MParagraph {
                text: root.status == ConnectionDetailStatus.loading ? @tr("正在加载连接详情…")
                    : root.status == ConnectionDetailStatus.ended ? @tr("此连接已结束，详情不再保留。")
                    : @tr("连接详情暂不可用。");
            }
        }
    }
    GridLayout {
        spacing: MobileTypography.small-gap; vertical-stretch: 0;
        MCopyButton {
            col: 0; row: 0; geometry-key: "connection-detail-copy";
            label: @tr("复制详情"); value: root.available ? "connection:" + root.snapshot.id : "";
            enabled: root.available;
        }
        if root.close-supported: MButton {
            col: root.narrow ? 0 : 1; row: root.narrow ? 1 : 0; colspan: root.narrow ? 2 : 1;
            geometry-key: "connection-detail-disconnect"; text: @tr("关闭连接"); danger: true;
            enabled: root.available && !MobileData.working && !MobileData.protected && !MobileData.protection-pending;
            clicked => { MobileActions.request(MobileIntent.close-connection, root.snapshot.id, ""); }
        }
        MButton {
            col: root.narrow || !root.close-supported ? 1 : 2; row: 0;
            geometry-key: "connection-detail-back"; text: @tr("返回"); clicked => { MobileView.back(); }
        }
    }
}

component MobileEditorActions inherits HorizontalLayout {
    spacing: MobileTypography.small-gap;
    MButton { text: @tr("取消"); enabled: !MobileData.profile-busy; clicked => { MobileView.back(); } }
    MButton { geometry-key: MobileView.detail == 3 ? "profile-save" : ""; text: MobileView.detail == 2 ? @tr("保存规则") : MobileData.profile-busy ? @tr("正在保存…") : @tr("保存订阅"); primary: true;
        enabled: !MobileData.working && !MobileData.profile-busy && (MobileView.detail != 3 || MobileView.selected-id != "" || !MobileData.profile-file-pending);
        busy: MobileView.detail == 3 && MobileData.profile-busy;
        clicked => {
            if MobileView.detail == 2 {
                MobileActions.request(MobileIntent.rule-save, MobileView.rule-text-mode ? MobileView.rule-raw : root.rule-line, MobileView.rule-position + "|" + (MobileView.rule-enabled ? "true" : "false"));
            } else { MobileActions.request(MobileIntent.save-profile, MobileView.profile-name, MobileView.profile-source); }
        }
    }
    in property <string> rule-line;
}

export component MobileDetails inherits PageSurface {
    motion-revision: MobileView.detail;
    property <[DetailItem]> legacy-rows: MobileData.connection-details;
    property <DetailItem> legacy-identity: root.legacy-rows.length > 0
        ? root.legacy-rows[root.legacy-rows.length - 1] : { label: "", value: "" };
    property <bool> legacy-matches: root.legacy-identity.value != "" && root.legacy-identity.value == MobileView.selected-id
        && (root.legacy-identity.label == "连接 ID" || root.legacy-identity.label == "Connection ID");
    property <bool> scrolling-editor-actions: root.height < 200px * MobileTypography.density;
    property <bool> supports-no-resolve: MobileView.rule-kind == "GEOIP" || MobileView.rule-kind == "IP-CIDR" || MobileView.rule-kind == "IP-CIDR6" || MobileView.rule-kind == "IP-ASN" || MobileView.rule-kind == "RULE-SET";
    property <string> rule-line: (MobileView.rule-kind == "MATCH" ? "MATCH," + MobileView.rule-policy : MobileView.rule-kind + "," + MobileView.rule-payload + "," + MobileView.rule-policy) + (root.supports-no-resolve && MobileView.rule-no-resolve ? ",no-resolve" : "");
    if MobileView.detail == 14: MobileFakeIp { }
    if MobileView.detail == 15: MobileRuleActions { }
    if MobileView.detail == 6: MobileSiteResults { }
    if MobileView.detail == 5: MobileConnectionDetails {
        width: parent.width; height: parent.height;
        selected-id: MobileView.selected-id; request: MobileView.connection-detail-request;
        close-supported: MobileData.connection-detail-snapshots;
        snapshot: MobileData.connection-detail-snapshots ? MobileData.connection-detail
            : { id: root.legacy-identity.value, request: self.request,
                status: root.legacy-matches ? ConnectionDetailStatus.available : ConnectionDetailStatus.unavailable,
                rows: root.legacy-matches ? root.legacy-rows : [] };
    }
    if MobileView.detail != 14 && MobileView.detail != 15 && MobileView.detail != 6 && MobileView.detail != 5: VerticalLayout { spacing: MobileTypography.gap;
        details-scroll := MScroll {
            content-key: MobileView.detail + "/" + MobileView.selected-id + "/" + MobileView.category + "/" + MobileView.claude-section + "/" + MobileView.site-status + "/" + MobileView.log-message;
            property <[length]> viewport: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
            changed viewport => { MobileView.profile-editor-viewport = self.viewport; }
            init => { MobileView.profile-editor-viewport = self.viewport; }
            VerticalLayout { width: root.width; alignment: start; spacing: MobileTypography.gap; padding-bottom: MobileTypography.padding;
            if MobileView.detail == 10: MCard {
                MTag { text: @tr("完整日志"); tone: 4; }
                MParagraph { text: MobileView.log-message; }
            }
            if MobileView.detail == 2: MCard {
                HorizontalLayout { spacing: MobileTypography.small-gap;
                    MButton {
                        geometry-key: "rule-editor-form"; text: @tr("表单"); selected: !MobileView.rule-text-mode;
                        clicked => {
                            if MobileView.rule-text-mode {
                                MobileActions.request(MobileIntent.rule-text-mode, MobileView.rule-raw, "form");
                            }
                        }
                    }
                    MButton {
                        geometry-key: "rule-editor-text"; text: @tr("规则文本"); selected: MobileView.rule-text-mode;
                        clicked => {
                            if !MobileView.rule-text-mode {
                                MobileView.rule-raw = root.rule-line;
                                MobileView.rule-text-mode = true;
                            }
                        }
                    }
                }
                if !MobileView.rule-text-mode: VerticalLayout { spacing: MobileTypography.gap;
                    MSmall { text: @tr("规则类型"); }
                    MSelect { options: MobileData.rule-types; value: MobileView.rule-kind;
                        selected(index, value) => { MobileView.rule-kind = value; MobileView.draft-dirty = true; }
                    }
                    if MobileView.rule-kind != "MATCH": MSmall { text: @tr("匹配内容"); }
                    if MobileView.rule-kind != "MATCH": MField { placeholder: @tr("例如 google.com"); text <=> MobileView.rule-payload; edited(value) => { MobileView.draft-dirty = true; } }
                    MSmall { text: @tr("匹配策略"); }
                    MSelect { options: MobileData.rule-policies; value: MobileView.rule-policy;
                        selected(index, value) => { MobileView.rule-policy = value; MobileView.draft-dirty = true; }
                    }
                    if root.supports-no-resolve: MSwitch { title: "no-resolve"; subtitle: @tr("匹配此规则时不额外解析域名"); checked: MobileView.rule-no-resolve;
                        toggled(value) => { MobileView.rule-no-resolve = value; MobileView.draft-dirty = true; }
                    }
                }
                if MobileView.rule-text-mode: VerticalLayout { spacing: MobileTypography.gap;
                    MSmall { text: @tr("完整规则"); }
                    MField { placeholder: "DOMAIN-SUFFIX,google.com,DIRECT"; text <=> MobileView.rule-raw; edited(value) => { MobileView.draft-dirty = true; } }
                }
                MSmall { text: @tr("插入位置"); }
                MField { text <=> MobileView.rule-position; edited(value) => { MobileView.draft-dirty = true; } }
                MSwitch { title: @tr("启用规则"); checked: MobileView.rule-enabled;
                    toggled(value) => { MobileView.rule-enabled = value; MobileView.draft-dirty = true; }
                }
            }
            if MobileView.detail == 3: profile-form := MCard {
                property <length> keyboard: MobileView.keyboard-inset;
                property <length> viewport-height: details-scroll.height;
                property <bool> name-focused: MobileView.profile-name-focused;
                property <bool> source-focused: MobileView.profile-source-focused;
                function reveal-profile-field() {
                    if self.keyboard > 0px {
                        if self.name-focused {
                            details-scroll.reveal(name-field.absolute-position.y, name-field.height);
                        } else if self.source-focused {
                            details-scroll.reveal(source-field.absolute-position.y, source-field.height);
                        }
                    }
                }
                changed keyboard => { self.reveal-profile-field(); }
                changed viewport-height => { self.reveal-profile-field(); }
                changed name-focused => { self.reveal-profile-field(); }
                changed source-focused => { self.reveal-profile-field(); }
                MSmall { text: @tr("订阅名称"); }
                name-field := MField { placeholder: @tr("输入名称"); enabled: !MobileData.profile-busy; text <=> MobileView.profile-name;
                    property <[length]> target: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
                    changed target => { MobileView.profile-name-target = self.target; }
                    changed has-focus => {
                        MobileView.profile-name-focused = self.has-focus;
                    }
                    init => { MobileView.profile-name-target = self.target; MobileView.profile-name-focused = self.has-focus; }
                    edited(value) => { MobileView.draft-dirty = true; }
                }
                if MobileView.selected-id == "": HorizontalLayout { spacing: MobileTypography.small-gap;
                    MButton { geometry-key: "profile-pick-file"; text: @tr("选择本地文件");
                        enabled: !MobileData.profile-busy && !MobileData.profile-file-pending;
                        clicked => { MobileActions.request(MobileIntent.pick-file, "", ""); }
                    }
                    if MobileData.profile-file-selected: MButton { geometry-key: "profile-clear-file"; text: @tr("移除");
                        enabled: !MobileData.profile-busy && !MobileData.profile-file-pending;
                        clicked => { MobileActions.request(MobileIntent.profile-clear-file, "", ""); }
                    }
                }
                MSmall { text: @tr("订阅地址（本地配置可留空）"); }
                source-field := MField { geometry-key: "profile-source"; placeholder: "https://example.com/subscription";
                    enabled: !MobileData.profile-busy && (MobileView.selected-id != "" || (!MobileData.profile-file-selected && !MobileData.profile-file-pending));
                    text <=> MobileView.profile-source;
                    property <[length]> target: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
                    changed target => { MobileView.profile-source-target = self.target; }
                    changed has-focus => {
                        MobileView.profile-source-focused = self.has-focus;
                    }
                    init => { MobileView.profile-source-target = self.target; MobileView.profile-source-focused = self.has-focus; }
                    edited(value) => { MobileView.draft-dirty = true; }
                }
                if MobileData.profile-busy: MSmall { text: @tr("正在保存订阅，请稍候…"); wrap: word-wrap; }
            }
            if MobileView.detail == 16 && MobileData.site-details.length > 0: MCard {
                for row[index] in MobileData.site-details: VerticalLayout { spacing: MobileTypography.small-gap;
                    MSmall { text: row.label; }
                    MParagraph { text: row.value; }
                    if index + 1 < MobileData.site-details.length: MDivider { }
                }
            }
            if MobileView.detail == 1: MobileReport {
                items: MobileData.claude-results;
                section: MobileView.claude-section;
            }
            if root.scrolling-editor-actions && (MobileView.detail == 2 || MobileView.detail == 3): MobileEditorActions { rule-line: root.rule-line; }
        } }
        if MobileView.detail == 10: HorizontalLayout { spacing: MobileTypography.small-gap;
            MCopyButton { label: @tr("复制全文"); value: MobileView.log-message; }
            MButton { text: @tr("关闭"); clicked => { MobileView.back(); } }
        }
        if !root.scrolling-editor-actions && (MobileView.detail == 2 || MobileView.detail == 3): MobileEditorActions { rule-line: root.rule-line; }
        if MobileView.detail == 16: HorizontalLayout { spacing: MobileTypography.small-gap;
            MButton { text: @tr("返回结果"); clicked => { MobileView.detail = 6; } }
            MButton { text: @tr("重测此项"); primary: true; enabled: !MobileData.detecting;
                clicked => { MobileActions.request(MobileIntent.site-probe, MobileView.site-selected, ""); }
            }
        }
    }
}

export component MobileModal inherits Rectangle {
    in property <bool> centered;
    presence := Presence { open: MobileView.modal; }
    visible: presence.mounted;
    in-out property <int> seconds: 3;
    property <int> source-kind: YamlDocument.confirm-close ? 20 : MobileView.detail;
    property <int> kind;
    property <string> yaml-detail;
    changed source-kind => { if MobileView.modal { root.kind = root.source-kind; root.seconds = 3; } }
    property <bool> document-confirm: YamlDocument.confirm-close;
    changed document-confirm => { if self.document-confirm { self.yaml-detail = YamlDocument.discard-detail(); } }
    init => { root.kind = root.source-kind; root.yaml-detail = YamlDocument.discard-detail(); }
    if presence.mounted: Rectangle {
        opacity: presence.progress;
        property <bool> opened: MobileView.modal;
        changed opened => { if self.opened { modal-keys.focus(); } }
        background: #00000066;
        init => { modal-keys.focus(); }
        TouchArea { }
        modal-keys := FocusScope {
            enabled: MobileView.modal;
            width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    if root.kind == 20 { YamlDocument.continue-editing(); }
                    else { MobileView.detail = root.kind == 12 ? MobileView.pending-detail : 0; }
                    return accept;
                }
                return reject;
            }
            Timer { running: MobileView.modal && root.kind == 8 && root.seconds > 0; interval: 1s; triggered => { root.seconds -= 1; } }
            dialog := Rectangle {
                width: min(parent.width - 32px - MobileView.safe-left - MobileView.safe-right, 480px);
                height: min(content.preferred-height, max(0px, parent.height - MobileView.safe-top - MobileView.safe-bottom - 24px));
                x: (parent.width - self.width) / 2;
                y: root.centered ? (parent.height - self.height) / 2 : max(MobileView.safe-top, parent.height - self.height - MobileView.safe-bottom - 12px) + (1 - presence.progress) * (root.centered ? 8px : 20px);
            background: Theme.raised; border-radius: 18px; border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 32px; drop-shadow-offset-y: 8px;
                MScroll {
                    geometry-key: "mobile-modal-scroll";
                    content-key: "" + root.kind;
                    width: parent.width; height: parent.height;
                content := VerticalLayout { alignment: start; spacing: MobileTypography.padding; padding: 24px;
                    MHeading { text: root.kind == 20 ? YamlDocument.discard-title() : root.kind == 4 ? @tr("删除此订阅？") : root.kind == 8 ? @tr("开启 Claude 保护？") : root.kind == 12 ? @tr("放弃未保存的修改？") : root.kind == 13 ? @tr("安装预发布版 {}？", MobileData.update-version) : @tr("强调色"); }
                    if root.kind != 11: MParagraph {
                        text: root.kind == 4 ? @tr("将删除“{}”及其配置文件。", MobileView.profile-name)
                                + (MobileView.profile-active ? @tr("此订阅正在使用，将先切换到默认直连；新连接将不再通过此订阅。") : "")
                                + @tr("此操作无法撤销。")
                            : root.kind == 8 ? @tr("将锁定当前节点及模式，启用 VPN、广泛规则、代理 DNS 和实时拦截，并关闭已有内核连接。全局 DIRECT 无法开启；直连模式将改为规则模式。可能影响其他应用，关闭后恢复。")
                            : root.kind == 13 ? @tr("预发布版本可能存在尚未发现的风险与 Bug，可能导致程序崩溃、网络异常或配置兼容问题。建议先备份配置，确认后再下载安装。")
                            : root.kind == 20 ? root.yaml-detail : @tr("尚有未保存的内容，离开后将丢弃本次编辑。");
                    }
                    if root.kind == 13: MParagraph {
                        text: @tr("安装预发布版后，无法保证在保留数据的情况下恢复正式版；回退可能需要先备份配置，再卸载重装。");
                        color: Theme.danger; font-weight: 600;
                    }
                    if root.kind == 11: VerticalLayout { spacing: MobileTypography.small-gap;
                        for row in [0, 1, 2]: HorizontalLayout { spacing: MobileTypography.small-gap;
                            for column in [0, 1]: MButton { modal-control: true; text: AccentPalette.accent-names[row * 2 + column]; selected: Theme.accent-index == row * 2 + column;
                                geometry-key: "accent-swatch:" + (row * 2 + column);
                                show-swatch: true; swatch: Theme.dark ? AccentPalette.dark-colors[row * 2 + column] : AccentPalette.accent-colors[row * 2 + column];
                                clicked => { Theme.accent-index = row * 2 + column; MobileActions.request(MobileIntent.accent, "" + Theme.accent-index, ""); }
                            }
                        }
                    }
                    if root.kind != 11: MButton {
                        geometry-key: root.kind == 20 ? "yaml-discard-confirm" : root.kind == 12 ? "preview-discard" : "mobile-modal-confirm";
                        modal-control: true; primary: root.kind == 8 || root.kind == 13; danger: root.kind == 4 || root.kind == 12 || root.kind == 20;
                        enabled: root.kind == 20 ? YamlDocument.confirm-close : !MobileData.profile-busy && !MobileData.protected && !MobileData.protection-pending && (root.kind != 8 || root.seconds == 0) && (root.kind != 13 || MobileData.update-confirm-wait == 0);
                        busy: root.kind == 4 && MobileData.profile-busy;
                        text: root.kind == 4 ? (MobileData.profile-busy ? @tr("正在删除…") : @tr("删除订阅")) : root.kind == 12 || root.kind == 20 ? @tr("放弃修改")
                            : root.kind == 13 ? (MobileData.update-confirm-wait > 0 ? @tr("继续安装（{} 秒）", MobileData.update-confirm-wait) : @tr("继续安装"))
                            : root.seconds > 0 ? @tr("开启保护（{} 秒）", root.seconds) : @tr("开启保护");
                        clicked => {
                            if root.kind == 20 { YamlDocument.discard-and-leave(); }
                            else if root.kind == 4 { MobileActions.request(MobileIntent.delete-profile, MobileView.selected-id, ""); }
                            else if root.kind == 8 {
                                MobileActions.request(MobileIntent.claude-protection, "true", "");
                                MobileView.detail = 0;
                            }
                            else if root.kind == 13 {
                                MobileActions.request(MobileIntent.install-update, "", "confirmed");
                                MobileView.detail = 0;
                            } else {
                                MobileView.draft-dirty = false;
                                if MobileView.pending-detail == 0 { MobileActions.request(MobileIntent.rule-discard, "", ""); }
                                if MobileView.pending-detail == 3 { MobileActions.request(MobileIntent.profile-close, "", ""); }
                                if MobileView.pending-page >= 0 { MobileView.navigate(MobileView.pending-page); }
                                MobileView.pending-page = -1; MobileView.detail = 0;
                            }
                        }
                    }
                    MButton { geometry-key: "mobile-modal-cancel"; modal-control: true; text: root.kind == 11 ? @tr("完成") : root.kind == 12 || root.kind == 20 ? @tr("继续编辑") : @tr("取消");
                        clicked => {
                            if root.kind == 20 { YamlDocument.continue-editing(); }
                            else {
                                if root.kind == 13 { MobileActions.request(MobileIntent.install-update, "", "cancel"); }
                                MobileView.detail = root.kind == 12 ? MobileView.pending-detail : 0;
                            }
                        }
                    }
                }
                }
            }
        }
        if !MobileView.modal: TouchArea { }
    }
}

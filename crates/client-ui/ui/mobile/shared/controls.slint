import { Motion, Entrance, ProgressTrack, CopyFeedback, NoticeCountdown } from "../../components/motion.slint";
import { Chevron } from "../../components/controls.slint";
import { GeometryTarget } from "../../components/geometry.slint";
import { RuleDragHandle } from "../../components/rule-drag.slint";
import { MobileTypography } from "typography.slint";
import { Theme } from "../../theme/palette.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "state.slint";
import { ListView as SlintListView } from "std-widgets.slint";

export component MAppIcon inherits Rectangle {
    width: 48px; height: 48px; border-radius: 8px;
    background: icon-area.pressed ? Theme.accent-wash : icon-area.has-hover ? Theme.inset : transparent;
    animate background { duration: Motion.fast; enabled: Motion.active; }
    accessible-role: button;
    accessible-label: "发送系统通知";
    accessible-action-default => { if !MobileView.modal && !MobileView.notice-modal { MobileActions.request(MobileIntent.system-notification, "", ""); } }
    Image { width: 28px; height: 28px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        source: @image-url("../../../../../resources/icons/app.png");
        colorize: Theme.accent;
        animate colorize { duration: Motion.appearance; enabled: Motion.active; }
    }
    FocusScope {
        width: parent.width; height: parent.height;
        enabled: !MobileView.modal && !MobileView.notice-modal;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { MobileActions.request(MobileIntent.system-notification, "", ""); return accept; }
            return reject;
        }
        icon-area := TouchArea { width: parent.width; height: parent.height;
            enabled: !MobileView.modal && !MobileView.notice-modal;
            clicked => { MobileActions.request(MobileIntent.system-notification, "", ""); }
        }
    }
}

export component MText {
    in property <string> text;
    in property <color> color: Theme.ink;
    in property <length> font-size: MobileTypography.font-size(16);
    in property <int> font-weight: 400;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextWrap> wrap: no-wrap;
    horizontal-stretch: 1; vertical-stretch: 0;
    min-width: 0px; preferred-width: glyphs.preferred-width;
    min-height: glyphs.preferred-height; preferred-height: glyphs.preferred-height;
    glyphs := Text {
        width: parent.width; height: parent.height; vertical-alignment: center;
        // Keep a stable drawing box when text changes during native startup.
        y: (self.font-metrics.cap-height - self.font-metrics.ascent - self.font-metrics.descent) / 2;
        text: root.text; color: root.color; animate color { duration: Motion.control; enabled: Motion.active; } font-size: root.font-size; font-weight: root.font-weight;
        horizontal-alignment: root.horizontal-alignment; wrap: root.wrap; overflow: elide;
    }
}
export component MSmall inherits MText { font-size: MobileTypography.font-size(13); color: Theme.secondary; }
export component MHeading inherits MText { font-size: MobileTypography.font-size(19); font-weight: 600; }
export component MParagraph inherits MText { wrap: word-wrap; height: self.preferred-height; }
export component MToolHeading inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    spacing: 12px; cross-axis-alignment: center;
    Rectangle { width: 34px; height: 34px; border-radius: 10px; background: Theme.inset;
        Image { x: 8px; y: 8px; width: 18px; height: 18px; source: root.icon; colorize: Theme.secondary; }
    }
    MText { text: root.title; font-weight: 600; }
    @children
}
// A touch viewport with an explicit content extent. Do not inherit a desktop
// ScrollView whose generated wrapper can constrain conditional layouts to the
// visible height, leaving Android with no scrollable overflow.
export component MScroll inherits Flickable {
    in property <string> content-key;
    out property <length> content-preferred-height: content.preferred-height;
    property <length> bottom: min(0px, self.height - self.content-height);
    changed content-key => { self.content-y = 0px; }
    changed bottom => { self.content-y = clamp(self.content-y, self.bottom, 0px); }
    public function reveal(target-y: length, target-height: length) {
        if root.height > 0px {
            let visible-height = min(target-height, root.height);
            let padding = min(8px, max(0px, (root.height - visible-height) / 2));
            let relative-top = target-y - root.absolute-position.y;
            let offset = relative-top < padding ? padding - relative-top : min(0px, root.height - padding - relative-top - visible-height);
            root.content-y = clamp(root.content-y + offset, root.bottom, 0px);
        }
    }
    min-width: 0px; min-height: 0px;
    horizontal-stretch: 1; vertical-stretch: 1;
    interactive: true; mouse-drag-pan-enabled: true;
    content-width: root.width;
    content-height: max(root.height, content.preferred-height);
    content := VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: self.preferred-height;
        vertical-stretch: 0;
        alignment: start; spacing: 0px; @children
    }
}

// Keep editable headers alive while virtual rows are replaced or recycled.
export component ListHeader inherits MScroll {
    in property <length> list-height;
    in property <length> list-content-height;
    out property <length> header-height: root.content-preferred-height + 12px;
    vertical-stretch: 0;
    height: clamp(root.header-height + root.content-y, 0px, root.list-height);
    content-height: root.height + max(0px, root.list-content-height - root.list-height);
}

// Slint recognizes virtual row layout by the immediate component name "ListView".
export component ListView inherits SlintListView {
    in property <string> content-key;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    vertical-scrollbar-policy: always-off;
    property <length> bottom: min(0px, self.visible-height - self.content-height);
    changed content-key => { self.content-y = 0px; }
    changed bottom => { self.content-y = clamp(self.content-y, self.bottom, 0px); }
}
export component MCard inherits Rectangle {
    in property <bool> selected;
    in property <bool> interactive;
    in property <length> vertical-padding: MobileTypography.padding;
    in property <length> horizontal-padding: MobileTypography.padding;
    in property <length> gap: MobileTypography.gap;
    callback clicked();
    preferred-width: 0px; min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    height: content.preferred-height;
    background: root.selected ? Theme.accent-wash : Theme.surface;
    border-width: 1px; border-color: root.selected ? Theme.accent : Theme.line; border-radius: 18px;
    animate background, border-color { duration: Motion.control; enabled: Motion.active; }
    if root.interactive: TouchArea { enabled: !MobileView.modal && !MobileView.notice-modal; mouse-cursor: pointer; clicked => { root.clicked(); } }
    content := VerticalLayout {
        alignment: start;
        padding-left: root.horizontal-padding; padding-right: root.horizontal-padding;
        padding-top: root.vertical-padding; padding-bottom: root.vertical-padding;
        spacing: root.gap; @children
    }
}
export component MButton inherits Rectangle {
    in property <string> geometry-key;
    GeometryTarget { key: root.geometry-key; bounds: [root.absolute-position.x, root.absolute-position.y, root.width, root.height]; }
    in property <bool> modal-control;
    in property <string> text;
    in property <bool> primary;
    in property <bool> selected;
    in property <bool> danger;
    in property <bool> dropdown;
    in property <bool> show-swatch;
    in property <color> swatch;
    in property <bool> enabled: true;
    in property <bool> busy;
    in property <bool> success;
    out property <length> press-offset: area.pressed && root.interactive ? 1px : 0px;
    animate press-offset { duration: Motion.fast; easing: ease-out; enabled: Motion.active; }
    in property <bool> notice-control;
    in property <bool> quiet;
    in property <bool> compact;
    in property <color> text-color: root.primary ? #ffffff : root.danger ? Theme.danger : root.success ? Theme.success : root.selected ? Theme.accent : Theme.ink;
    property <bool> interactive: root.enabled && !root.busy && (!MobileView.modal || root.modal-control) && (!MobileView.notice-modal || root.notice-control);
    property <bool> keyboard-focus;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.interactive { root.clicked(); } }
    forward-focus: keys;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    height: max(48px, label.preferred-height + (root.compact ? 16px : 24px)); vertical-stretch: 0;
    opacity: root.enabled || root.busy ? 1 : 0.5;
    animate opacity { duration: Motion.fast; enabled: Motion.active; }
    surface := Rectangle {
        x: 0px; y: root.compact ? 4px : 0px;
        width: root.width; height: root.height - 2 * self.y;
        background: root.primary ? (area.pressed && root.enabled ? Theme.primary.darker(0.15) : Theme.primary)
            : root.success ? Theme.success-wash : root.selected || (area.pressed && root.enabled) ? Theme.accent-wash
            : area.has-hover && root.enabled ? Theme.inset : root.quiet ? transparent : Theme.surface;
        border-width: 1px; border-radius: root.compact ? 8px : 10px;
        border-color: root.enabled && root.keyboard-focus && keys.has-focus ? Theme.ink
            : root.primary ? Theme.primary : root.selected || (area.pressed && root.enabled) ? Theme.accent : root.quiet ? transparent : Theme.line;
        animate background, border-color { duration: Motion.fast; enabled: Motion.active; }
        if root.busy: ProgressTrack { y: parent.height - 3px; width: parent.width; indeterminate: true; track: transparent; fill: root.primary ? #ffffff : Theme.accent; }
    }
    if root.show-swatch: Rectangle {
        x: 12px; y: (parent.height - 16px) / 2 + root.press-offset; width: 16px; height: 16px;
        border-radius: 8px; background: root.swatch;
    }
    label := MText { y: root.press-offset; width: parent.width - 12px - (root.dropdown ? 24px : 0px) - (root.show-swatch ? 26px : 0px); x: root.show-swatch ? 32px : 6px; height: parent.height;
        text: root.text; horizontal-alignment: center;
        color: root.text-color;
        font-size: MobileTypography.font-size(root.compact ? 13 : 15);
    }
    if root.dropdown: Image { source: @image-url("../../icons/chevron-down.svg");
        x: parent.width - 28px; y: (parent.height - 18px) / 2 + root.press-offset; width: 18px; height: 18px; colorize: Theme.secondary;
    }
    keys := FocusScope {
        enabled: root.interactive;
        focus-gained(reason) => { root.keyboard-focus = reason == FocusReason.tab-navigation; }
        key-pressed(event) => {
            root.keyboard-focus = true;
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    area := TouchArea { enabled: root.interactive; mouse-cursor: pointer;
        clicked => { root.keyboard-focus = false; keys.focus(); root.clicked(); }
    }
}
// Permanent while protection is active: the status is readable everywhere,
// but only disabling protection or diagnostics remain available.
export component MProtectionLock inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> pending: false;
    min-height: max(50px, detail.preferred-height + 18px);
    preferred-height: self.min-height;
    border-radius: 12px; border-width: 1px;
    border-color: Theme.success.with-alpha(0.28);
    background: Theme.success-wash;
    HorizontalLayout {
        padding-left: 12px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
        spacing: 8px; cross-axis-alignment: center;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.success; horizontal-stretch: 0; }
        detail := MParagraph {
            text: "Claude 保护只读模式，更新与设置已暂停。";
            font-size: MobileTypography.font-size(13); color: Theme.ink;
            horizontal-stretch: 1; min-width: 0px;
        }
        MButton {
            text: "关闭保护"; quiet: true; compact: true;
            width: max(88px, MobileTypography.font-size(13) * 5.4); horizontal-stretch: 0;
            enabled: root.enabled && !root.pending;
            clicked => { MobileActions.request(MobileIntent.claude-protection, "false", ""); }
        }
    }
}
export component MPagination inherits HorizontalLayout {
    in property <string> status;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    in property <bool> compact;
    callback turn(int);
    alignment: start; spacing: MobileTypography.small-gap; vertical-stretch: 0;
    MButton {
        text: root.compact || Theme.text-scale > 1.25 ? "‹" : "上一页";
        accessible-role: button; accessible-label: "上一页";
        width: root.compact || Theme.text-scale > 1.25 ? 48px : max(80px, MobileTypography.font-size(15) * 3 + 20px);
        horizontal-stretch: 0; enabled: root.previous-enabled;
        clicked => { root.turn(-1); }
    }
    MSmall { text: root.status; horizontal-alignment: center; wrap: word-wrap; }
    MButton {
        text: root.compact || Theme.text-scale > 1.25 ? "›" : "下一页";
        accessible-role: button; accessible-label: "下一页";
        width: root.compact || Theme.text-scale > 1.25 ? 48px : max(80px, MobileTypography.font-size(15) * 3 + 20px);
        horizontal-stretch: 0; enabled: root.next-enabled;
        clicked => { root.turn(1); }
    }
}
export component MDragHandle inherits RuleDragHandle {
    hold-duration: 550ms;
    context: MobileData.rule-page-index + "/" + MobileView.query + "/" + MobileData.rule-profile + "/" + MobileView.rule-source;
    blocked: MobileView.modal || MobileView.notice-modal;
    width: max(24px, 48px - MobileTypography.padding - MobileTypography.small-gap);
    height: 48px; horizontal-stretch: 0;
    // Share the card padding with the touch target while keeping the icon narrow.
    hit-padding: MobileTypography.padding;
    hit-width: 48px;
}
export component MRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> value;
    in property <color> value-color: Theme.secondary;
    in property <bool> show-swatch;
    in property <color> swatch;
    in property <bool> arrow: true;
    in property <bool> expandable;
    in property <bool> expanded;
    in property <bool> interactive: true;
    callback clicked();
    vertical-stretch: 0; min-width: 0px; height: max(48px, 52px * MobileTypography.density, content.preferred-height + MobileTypography.gap);
    content := HorizontalLayout { cross-axis-alignment: center; spacing: 10px;
        VerticalLayout { spacing: 6px; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
            MText { text: root.title; }
            if root.subtitle != "": MSmall { text: root.subtitle; wrap: word-wrap; }
        }
        if root.show-swatch: Rectangle { width: 16px; height: 16px; horizontal-stretch: 0; border-radius: 8px; background: root.swatch; }
        if root.value != "": MSmall {
            text: root.value; color: root.value-color;
            max-width: MobileTypography.font-size(14) * 6; horizontal-stretch: 0;
        }
        if root.arrow && root.expandable: Chevron { expanded: root.expanded; horizontal-stretch: 0; }
        if root.arrow && !root.expandable: Image {
            source: @image-url("../../icons/chevron-right.svg");
            width: 18px; height: 18px; horizontal-stretch: 0; colorize: Theme.secondary;
        }
    }
    TouchArea { enabled: root.interactive && !MobileView.modal && !MobileView.notice-modal; mouse-cursor: root.interactive ? pointer : default; clicked => { root.clicked(); } }
}
export component MBackButton inherits MButton {
    text: ""; width: 48px; height: 48px; horizontal-stretch: 0;
    accessible-role: button; accessible-label: "返回";
    Image { source: @image-url("../../icons/chevron-left.svg");
        width: 24px; height: 24px; x: 12px; y: 12px + root.press-offset; colorize: Theme.ink;
    }
}
export component MDivider inherits Rectangle { height: 1px; vertical-stretch: 0; background: Theme.subtle-line; }
export component MSwitch inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    vertical-stretch: 0; height: max(48px, 52px * MobileTypography.density, content.preferred-height + MobileTypography.gap);
    opacity: root.enabled ? 1 : 0.5;
    animate opacity { duration: Motion.control; enabled: Motion.active; }
    content := HorizontalLayout { spacing: MobileTypography.gap; cross-axis-alignment: center;
        if root.title != "" || root.subtitle != "": VerticalLayout { spacing: 6px; MText { text: root.title; wrap: word-wrap; } if root.subtitle != "": MSmall { text: root.subtitle; wrap: word-wrap; } }
        Rectangle { width: 44px; height: 26px; horizontal-stretch: 0; border-radius: 13px; background: root.checked ? Theme.primary : Theme.muted;
            animate background { duration: Motion.control; enabled: Motion.active; }
            Rectangle { x: root.checked ? 21px : 3px; animate x { duration: Motion.control; easing: ease-out; enabled: Motion.active; } y: 3px; width: 20px; height: 20px; border-radius: 10px; background: #ffffff; }
        }
    }
    TouchArea { enabled: root.enabled && !MobileView.modal && !MobileView.notice-modal; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}
export component MField inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> secret;
    out property <bool> has-focus: input.has-focus;
    out property <bool> placeholder-visible: input.text == "" && input.preedit-text == "";
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    forward-focus: input;
    height: max(48px, input.preferred-height + 20px); min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    background: Theme.surface; border-radius: 6px; border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    animate border-color, background { duration: Motion.fast; enabled: Motion.active; }
    input := TextInput { x: 12px; width: parent.width - 24px; height: parent.height;
        enabled: root.enabled && !MobileView.modal && !MobileView.notice-modal;
        text <=> root.text; input-type: root.secret ? InputType.password : InputType.text; font-size: MobileTypography.font-size(16); color: Theme.ink; single-line: true; vertical-alignment: center;
        selection-background-color: Theme.primary; selection-foreground-color: #ffffff;
        edited => { root.edited(self.text); }
    }
    MSmall { x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.placeholder-visible ? root.placeholder : "";
    }
}
export component MSelect inherits Rectangle {
    in property <bool> enabled: true;
    property <bool> error-active: MobileView.notice-modal;
    changed enabled => { if !root.enabled { popup.close(); } }
    changed error-active => { if root.error-active { popup.close(); } }
    in property <[string]> options;
    in property <string> value;
    callback selected(int, string);
    height: button.height; vertical-stretch: 0; min-width: 0px; preferred-width: 0px; horizontal-stretch: 1;
    button := MButton { width: parent.width; text: root.value; dropdown: true; enabled: root.enabled; clicked => { popup.show(); } }
    popup := PopupWindow {
        y: root.height + 4px; width: max(root.width, 200px);
        height: min(300px, root.options.length * 52px + 16px);
        close-policy: close-on-click-outside;
        Rectangle { entrance := Entrance { } opacity: entrance.progress; background: Theme.surface; border-radius: 8px; border-width: 1px; border-color: Theme.line;
            MScroll { VerticalLayout { alignment: start; spacing: 4px; padding: MobileTypography.small-gap;
                for option[i] in root.options: MButton { width: popup.width - 16px; text: option; selected: option == root.value;
                    enabled: root.enabled;
                    clicked => { root.selected(i, option); popup.close(); }
                }
            } }
        }
    }
}
export component MTag inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    in property <length> width-limit: 240px;
    height: max(24px, 28px * MobileTypography.density, label.preferred-height + MobileTypography.small-gap); width: min(root.width-limit, label.preferred-width + MobileTypography.padding);
    horizontal-stretch: 0; vertical-stretch: 0; border-radius: 5px;
    background: root.tone == 4 ? Theme.inset : root.tone == 3 ? Theme.danger-wash : root.tone == 2 ? Theme.warning-wash : root.tone == 1 ? Theme.success-wash : Theme.accent-wash;
    animate background { duration: Motion.control; enabled: Motion.active; }
    label := MSmall { width: parent.width; height: parent.height; text: root.text; horizontal-alignment: center;
        color: root.tone == 4 ? Theme.secondary : root.tone == 3 ? Theme.danger : root.tone == 2 ? Theme.warning : root.tone == 1 ? Theme.success : Theme.accent;
    }
}
export component MProgress inherits ProgressTrack {
    track: Theme.subtle-line; fill: Theme.accent;
}
// Keep the message, action and lifetime indicator in one padded layout, just
// like the desktop notice. Absolute offsets must not place controls below it.
export component MNotice inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <length> available-height;
    property <bool> can-recover: MobileView.notice-recover-network && MobileData.vpn-connected && !MobileData.protected && !MobileData.protection-pending;
    property <bool> can-restart: MobileView.notice-modal && !MobileData.core-running && !MobileData.protected && !MobileData.protection-pending;
    property <bool> has-recovery: root.can-restart || root.can-recover;
    property <int> action-count: root.has-recovery ? 4 : 3;
    property <int> action-columns: root.width / Theme.text-scale < 220px ? 1 : root.has-recovery || root.width / Theme.text-scale < 300px ? 2 : 3;
    in-out property <[length]> close-target;
    callback dismissed();
    height: min(content.preferred-height, max(72px, root.available-height));
    border-radius: MobileView.notice-modal ? 18px : 14px; border-width: 1px; border-color: Theme.line; background: root.error ? Theme.surface : Theme.ink;
    drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000030;
    TouchArea { mouse-cursor: root.error ? default : pointer; clicked => { if !root.error { root.dismissed(); } } }
    content := VerticalLayout { padding: MobileView.notice-modal ? Theme.card-padding : 12px; spacing: MobileTypography.small-gap; alignment: start;
        if root.error: HorizontalLayout { cross-axis-alignment: center; spacing: 10px;
            Rectangle { width: 28px; height: 28px; border-radius: 8px; background: Theme.danger-wash;
                MHeading { text: "!"; width: parent.width; height: parent.height; color: Theme.danger; horizontal-alignment: center; }
            }
            MHeading { text: MobileView.notice-modal ? "需要处理" : "操作未完成"; font-size: MobileTypography.font-size(MobileView.notice-modal ? 18 : 14); }
        }
        MScroll {
            content-key: root.text; preferred-height: body.preferred-height;
            body := VerticalLayout { alignment: start; spacing: Theme.content-gap;
                message-area := Rectangle {
                    property <[length]> target: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
                    changed target => { if !root.error { root.close-target = self.target; } }
                    init => { if !root.error { root.close-target = self.target; } }
                    height: message.preferred-height;
                    accessible-role: AccessibleRole.text; accessible-label: root.text;
                    message := MParagraph { width: parent.width; text: root.text; color: root.error ? Theme.ink : Theme.canvas; font-size: MobileTypography.font-size(14); }
                    if !root.error: TouchArea {
                        accessible-role: button; accessible-label: "关闭提示";
                        accessible-action-default => { root.dismissed(); }
                        mouse-cursor: pointer; clicked => { root.dismissed(); }
                    }
                }
            }
        }
        if root.error: GridLayout { spacing: MobileTypography.small-gap;
            for index in root.action-count: MButton {
                property <[length]> target: [self.absolute-position.x, self.absolute-position.y, self.width, self.height];
                changed target => { if index == root.action-count - 1 { root.close-target = self.target; } }
                init => { if index == root.action-count - 1 { root.close-target = self.target; } }
                col: mod(index, root.action-columns); row: floor(index / root.action-columns);
                modal-control: true; notice-control: true; quiet: true; compact: true;
                text: index == root.action-count - 1 ? "关闭" : index == 0 ? "导出诊断" : index == 1 ? "新建 Issue" : root.can-restart ? "重启内核" : "关闭代理";
                enabled: index != 2 || !root.has-recovery || !MobileData.working;
                clicked => {
                    if index == root.action-count - 1 { root.dismissed(); }
                    else { MobileActions.request(index == 0 ? MobileIntent.export-diagnostics : index == 1 ? MobileIntent.report-issue : root.can-restart ? MobileIntent.restart-core : MobileIntent.disconnect, index == 2 ? "" : root.text, ""); }
                }
            }
        }
        if !root.error: NoticeCountdown {
            revision: MobileView.notice-revision; elapsed: MobileView.notice-elapsed;
            track: Theme.canvas.with-alpha(0.15); fill: Theme.accent;
        }
    }
}
export component MNav inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> stacked;
    in property <bool> pill: true;
    callback clicked();
    min-height: 48px; border-radius: root.stacked ? 12px : 6px;
    background: root.selected && !root.stacked ? Theme.inset : area.pressed ? Theme.inset : transparent;
    animate background { duration: Motion.control; enabled: Motion.active; }
    if root.stacked: VerticalLayout { padding-top: 4px; padding-bottom: 4px; spacing: 4px; alignment: center;
        Rectangle { height: 28px;
            Rectangle { x: (parent.width - self.width) / 2; width: 58px; height: 28px; border-radius: 14px; background: root.selected && root.pill ? Theme.accent-wash : transparent;
                Image { x: (parent.width - 22px) / 2; y: 3px; source: root.icon; width: 22px; height: 22px; colorize: root.selected ? Theme.accent : Theme.secondary; }
            }
        }
        MSmall { text: root.text; font-size: MobileTypography.font-size(12); horizontal-alignment: center; color: root.selected ? Theme.accent : Theme.secondary; font-weight: root.selected ? 600 : 400; }
    }
    if !root.stacked: HorizontalLayout { padding-left: 14px; padding-right: 12px; spacing: MobileTypography.gap; cross-axis-alignment: center;
        Image { source: root.icon; width: 20px; height: 20px; colorize: Theme.secondary; }
        MText { text: root.text; color: root.selected ? Theme.ink : Theme.secondary; font-weight: root.selected ? 600 : 400; }
    }
    area := TouchArea { enabled: !MobileView.modal && !MobileView.notice-modal; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component MCopyButton inherits MButton {
    in property <string> value;
    in property <string> label: "复制";
    feedback := CopyFeedback { revision: MobileView.copy-revision; acknowledged: MobileView.copy-value; value: root.value; }
    text: feedback.copied ? "已复制" : root.label; success: feedback.copied;
    clicked => { feedback.requested(); MobileActions.request(MobileIntent.copy, root.value, ""); }
}

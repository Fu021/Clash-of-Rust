// Viewer-only host: no network, VPN, filesystem or native side effects.
import { Theme } from "../../theme/palette.slint";
import { MobileData, MobileView } from "state.slint";
import { MobileFixture } from "fixtures.slint";
import { MSmall } from "controls.slint";
import { Motion } from "../../components/motion.slint";
import "../../../../../resources/fonts/SourceHanSansCN-Regular.otf";

export component MobilePreviewSurface inherits Rectangle {
    in-out property <bool> preview-motion;
    changed preview-motion => { Motion.enabled = root.preview-motion; }
    init => { Motion.enabled = root.preview-motion; }
    background: Theme.canvas;
    in-out property <int> preview-page <=> MobileView.page;
    in-out property <int> preview-detail <=> MobileView.detail;
    in-out property <bool> preview-dark;
    in-out property <bool> preview-connected <=> MobileData.vpn-connected;
    in-out property <length> inset-top <=> MobileView.safe-top;
    in-out property <length> inset-bottom <=> MobileView.safe-bottom;
    in-out property <length> inset-left <=> MobileView.safe-left;
    in-out property <length> inset-right <=> MobileView.safe-right;
    in-out property <length> preview-keyboard <=> MobileView.keyboard-inset;
    in-out property <float> text-scale: 1;
    in-out property <bool> preview-selected-rule <=> MobileView.rule-selected;
    in-out property <bool> preview-shortcuts <=> MobileView.shortcuts-open;
    in-out property <bool> preview-protection-pending <=> MobileData.protection-pending;
    in-out property <string> preview-notice <=> MobileView.notice;
    in-out property <float> preview-notice-elapsed <=> MobileView.notice-elapsed;
    in-out property <bool> preview-sparse;
    changed preview-sparse => {
        if root.preview-sparse { MobileData.profiles = [MobileData.profiles[0]]; }
    }
    changed preview-dark => { Theme.system-dark = root.preview-dark; }
    changed text-scale => { Theme.text-scale = root.text-scale; }
    MobileFixture { }
    Rectangle { @children }
    if root.preview-keyboard > 0px: Rectangle {
        y: parent.height - root.preview-keyboard; height: root.preview-keyboard; width: parent.width;
        background: Theme.inset;
        MSmall { width: parent.width; y: 44px; height: 28px; horizontal-alignment: center; text: "系统键盘"; }
    }
    if root.inset-top > 0px: MSmall {
        x: root.inset-left + 20px; y: max(0px, (root.inset-top - 24px) / 2);
        width: 80px; height: 24px; font-size: 14px; text: "9:41"; font-weight: 600;
    }
    if root.inset-top > 0px: MSmall {
        x: parent.width - root.inset-right - 132px; y: max(0px, (root.inset-top - 24px) / 2);
        width: 112px; height: 24px; font-size: 13px;
        text: root.preview-connected ? "VPN  ▰  100%" : "▰  100%"; horizontal-alignment: right;
    }
    if root.inset-bottom >= 20px && root.preview-keyboard == 0px: Rectangle {
        x: (parent.width - 100px) / 2; y: parent.height - 10px;
        width: 100px; height: 4px; border-radius: 2px; background: Theme.ink; opacity: 0.6;
    }
}

import { Motion, MotionScope, Presence } from "../../components/motion.slint";
import { MobileTypography } from "typography.slint";
// Responsive chrome only. Each platform supplies its own routes and pages.
import { Theme } from "../../theme/palette.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "state.slint";
import { MText, MSmall, MHeading, MButton, MBackButton, MTag, MNav, MScroll, MNotice, MAppIcon, MProtectionLock, MProgress } from "controls.slint";
import { MobileDetails, MobileModal } from "details.slint";
import { ProtectionBadge, ProtectionAlert } from "../../components/protection-status.slint";
import { Wordmark, ConnectionPower } from "../../components/brand.slint";
import { RuleShortcutsDialog } from "../../components/rule-shortcuts.slint";
import { GeometryTarget } from "../../components/geometry.slint";

component RulesShortcutButton inherits MButton {
    geometry-key: "rule-shortcuts-open";
    text: "快捷规则"; compact: true; quiet: true;
    width: max(80px, MobileTypography.font-size(13) * 4 + 16px); horizontal-stretch: 0;
    enabled: !MobileData.protected && !MobileData.protection-pending && !MobileData.working;
    clicked => { MobileView.shortcuts-open = true; }
}

component HeaderStatus inherits VerticalLayout {
    in property <bool> compact;
    in property <bool> rules-shortcut;
    horizontal-stretch: 0;
    spacing: 6px; alignment: center; min-width: status-row.min-width;
    status-row := HorizontalLayout { alignment: end; cross-axis-alignment: center; spacing: 8px;
        if MobileData.protection-health > 0: ProtectionBadge {
            health: MobileData.protection-health;
            touch-size: 48px;
            enabled: !MobileView.modal && !MobileView.notice-modal;
            clicked => { MobileView.navigate(8); }
        }
        if root.rules-shortcut: RulesShortcutButton { }
        MTag {
            text: MobileData.core-running ? "● 内核运行中" : "○ 内核未运行"; tone: MobileData.core-running ? 1 : 4;
        }
    }
}

export component MobileFrame inherits Rectangle {
    forward-focus: keys;
    out property <[length]> notice-close-target: notice-panel.close-target;
    MotionScope { }
    notice-presence := Presence { open: MobileView.notice != ""; }
    property <string> notice-source: MobileView.notice;
    property <string> notice-text;
    changed notice-source => { if self.notice-source != "" { self.notice-text = self.notice-source; } }
    in property <[int]> primary-pages;
    in property <[int]> sidebar-pages;
    in property <[int]> sidebar-footer-pages;
    in property <bool> grouped-tools;
    in property <bool> tab-pill;
    in property <length> title-size: 24px;
    in property <length> sidebar-width: 192px;
    in property <length> tab-height: 72px;
    in property <bool> centered-modal;
    in property <bool> compact-system-insets;
    in property <bool> standalone-detail;
    in property <string> standalone-title;
    in property <bool> update-available;
    in property <bool> update-busy;
    in property <bool> update-downloading;
    in property <string> update-status;
    in property <float> update-progress;
    callback install-update();
    out property <length> update-banner-height: update-banner.height;
    in property <[string]> titles: ["首页", "代理", "订阅", "连接", "规则", "日志", "网络诊断", "IP 检测", "A÷检测", "设置", "工具"];
    property <[image]> icons: [@image-url("../../icons/home.svg"), @image-url("../../icons/proxies.svg"), @image-url("../../icons/subscriptions.svg"), @image-url("../../icons/connections.svg"), @image-url("../../icons/rules.svg"), @image-url("../../icons/logs.svg"), @image-url("../../icons/network.svg"), @image-url("../../icons/ip.svg"), @image-url("../../icons/ai.svg"), @image-url("../../icons/settings.svg"), @image-url("../../icons/network.svg")];
    property <length> usable-width: root.width - MobileView.safe-left - MobileView.safe-right;
    property <length> usable-height: max(0px, root.height - MobileView.safe-top - MobileView.safe-bottom - MobileView.keyboard-inset);
    property <bool> short: root.height - MobileView.safe-top - MobileView.safe-bottom < 480px;
    property <bool> narrow: root.usable-width < 640px && !root.short;
    property <bool> stacked-header: root.narrow && Theme.text-scale >= 1.25;
    property <bool> expanded: root.usable-width >= 1024px && !root.short;
    property <bool> bottom: root.narrow && MobileView.keyboard-inset == 0px;
    property <length> nav-width: root.narrow ? 0px : root.expanded ? root.sidebar-width : 76px;
    property <length> content-padding: root.expanded ? 24px : MobileTypography.padding;
    property <length> header-height: max(root.short ? 56px : 72px * MobileTypography.density, header-content.preferred-height + 16px);
    // Android keeps the gesture inset inside the navigation surface, without
    // adding a second empty strip below it. iOS retains its own safe-area policy.
    property <length> nav-content-height: max(root.tab-height, MobileTypography.font-size(12) * 1.5 + 38px);
    property <length> bottom-height: root.nav-content-height + (root.compact-system-insets ? max(8px, MobileView.safe-bottom) : MobileView.safe-bottom);
    property <bool> detail-page: MobileView.detail > 0 && !MobileView.modal && !root.standalone-detail;
    property <bool> has-back: root.standalone-detail || (root.detail-page && !root.pane) || ((!root.expanded || root.grouped-tools) && MobileView.page >= 3 && MobileView.page <= 8);
    property <bool> report-detail: MobileView.detail == 1 || MobileView.detail == 7 || MobileView.detail == 9;
    property <bool> pane: body.width >= 880px && root.detail-page && !root.report-detail && MobileView.detail != 2 && MobileView.detail != 3;
    property <bool> modal-notice: MobileView.notice-modal;
    property <string> rule-profile: MobileData.rule-profile;
    property <string> previous-rule-profile;
    changed rule-profile => {
        if root.previous-rule-profile != "" { MobileView.shortcuts-open = false; }
        root.previous-rule-profile = root.rule-profile;
    }
    changed modal-notice => { if self.modal-notice { keys.focus(); } }
    property <string> detail-title: MobileView.detail == 14 ? "Fake-IP" : MobileView.detail == 15 ? "规则操作" : MobileView.detail == 16 ? "检测详情" : MobileView.detail == 1 ? "风险项目" : MobileView.detail == 2 ? "编辑规则" : MobileView.detail == 3 ? (MobileView.selected-id == "" ? "添加订阅" : "编辑订阅") : MobileView.detail == 5 ? "连接详情" : MobileView.detail == 6 ? (MobileView.category == "all" ? "全部检测结果" : MobileView.category) : MobileView.detail == 7 ? "正常项目" : MobileView.detail == 9 ? "其他线索" : "日志详情";
    property <duration> notice-start;
    property <int> notice-revision: MobileView.notice-revision;
    property <float> notice-elapsed: MobileView.notice-elapsed;
    changed notice-revision => { root.notice-start = animation-tick() - MobileView.notice-elapsed * 1s; }
    changed notice-elapsed => { root.notice-start = animation-tick() - MobileView.notice-elapsed * 1s; }
    init => { root.notice-start = animation-tick() - MobileView.notice-elapsed * 1s; root.notice-text = MobileView.notice; }
    background: root.nav-width > 0px ? Theme.sidebar : Theme.canvas;
    animate background { duration: Motion.appearance; enabled: Motion.active; }
    Timer { running: MobileView.notice != "" && !MobileView.notice-error; interval: 100ms;
        triggered => { if animation-tick() - root.notice-start >= 5s { MobileView.notice = ""; } }
    }
    Timer {
        running: MobileView.notice-back-pending > 0;
        interval: 250ms;
        triggered => { MobileView.notice-back-pending = 0; }
    }
    keys := FocusScope {
        width: parent.width; height: parent.height;
        capture-key-pressed(event) => {
            if MobileView.shortcuts-open && (event.text == Key.Escape || event.text == Key.Back) {
                MobileView.shortcuts-open = false;
                if event.text == Key.Back { MobileView.notice-back-pending += 1; }
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Back) && MobileView.notice != "" && MobileView.notice-error {
                MobileView.notice = "";
                if (event.text == Key.Back) { MobileView.notice-back-pending += 1; }
                return accept;
            }
            if event.text == Key.Escape && MobileView.rule-drag-id != "" {
                MobileView.rule-drag-id = ""; MobileView.rule-drag-target = ""; return accept;
            }
            if event.text == Key.Escape && !MobileView.modal {
                if root.detail-page || root.standalone-detail { MobileView.back(); }
                else if MobileView.page >= 3 && MobileView.page <= 8 { MobileView.navigate(10); }
                return accept;
            }
            return reject;
        }
        if root.nav-width > 0px: Rectangle {
            x: MobileView.safe-left + root.nav-width; y: MobileView.safe-top;
            width: max(0px, root.width - self.x); height: max(0px, root.height - self.y);
            background: Theme.canvas; border-top-left-radius: 18px;
        }
        if root.nav-width > 0px: Rectangle {
            // Paint behind the system bars/cutouts; inset interactive content only.
            x: 0px; y: 0px; width: MobileView.safe-left + root.nav-width;
            height: root.height - MobileView.keyboard-inset;
            background: Theme.sidebar;
            animate background { duration: Motion.appearance; enabled: Motion.active; }
            VerticalLayout { x: MobileView.safe-left; y: MobileView.safe-top;
                width: root.nav-width; height: root.usable-height;
                padding: MobileTypography.small-gap; spacing: 10px;
                if !root.short: HorizontalLayout { height: 46px; spacing: 8px; padding-left: root.expanded ? 8px : 6px; cross-axis-alignment: center;
                    MAppIcon { width: 36px; height: 48px; }
                    if root.expanded: Wordmark { width: 138px; }
                }
                if root.expanded: HorizontalLayout { height: 48px; spacing: 12px; padding-left: 10px; cross-axis-alignment: center;
                    ConnectionPower { width: 30px; height: 30px; connected: MobileData.vpn-connected; label: MobileData.vpn-connected ? "断开 VPN" : "连接 VPN";
                        enabled: !MobileData.working && !MobileData.protected && !MobileData.protection-pending && !MobileView.modal && !MobileView.notice-modal;
                        clicked => { MobileActions.request(MobileData.vpn-connected || MobileData.vpn-pending ? MobileIntent.disconnect : MobileIntent.connect, "", ""); }
                    }
                    MText { text: MobileData.vpn-connected ? "已连接" : MobileData.vpn-pending ? "连接中…" : "未连接"; }
                }
                MScroll { vertical-stretch: 1; min-height: 0px;
                    if root.expanded: VerticalLayout { alignment: start; spacing: 4px;
                        for route-id in root.sidebar-pages: VerticalLayout { alignment: start; spacing: 4px;
                            if route-id == 6: MSmall { text: "工具"; height: max(28px, MobileTypography.font-size(12) + 12px); font-size: MobileTypography.font-size(12); }
                            MNav { geometry-key: "preview-nav:" + route-id; height: 48px; text: root.titles[route-id]; icon: root.icons[route-id]; selected: MobileView.page == route-id || (route-id == 10 && MobileView.page >= 3 && MobileView.page <= 8);
                                clicked => { MobileView.navigate(route-id); }
                            }
                        }
                    }
                    if !root.expanded: VerticalLayout { alignment: start; spacing: root.short ? 0px : 8px;
                        for route-id in root.primary-pages: MNav { geometry-key: "preview-nav:" + route-id; height: root.short ? 56px : 68px; stacked: true; pill: root.tab-pill;
                            text: root.titles[route-id]; icon: root.icons[route-id]; selected: MobileView.page == route-id || (route-id == 10 && MobileView.page >= 3 && MobileView.page <= 8);
                            clicked => { MobileView.navigate(route-id); }
                        }
                    }
                }
                if root.expanded: VerticalLayout { vertical-stretch: 0; spacing: 10px;
                    for route-id in root.sidebar-footer-pages: MNav { geometry-key: "preview-nav:" + route-id; height: 48px; text: root.titles[route-id]; icon: root.icons[route-id]; selected: MobileView.page == route-id;
                        clicked => { MobileView.navigate(route-id); }
                    }
                    MSmall { height: 28px; text: MobileData.version; }
                }
            }
        }
        header := Rectangle {
            x: MobileView.safe-left + root.nav-width + root.content-padding; y: MobileView.safe-top;
            width: root.usable-width - root.nav-width - root.content-padding * 2; height: root.header-height;
            header-content := VerticalLayout {
              y: 8px; width: parent.width; height: self.preferred-height; spacing: MobileTypography.small-gap;
              HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                if root.has-back: MBackButton {
                    clicked => { if root.detail-page || root.standalone-detail { MobileView.back(); } else { MobileView.navigate(10); } }
                }
                MHeading { text: root.standalone-detail ? root.standalone-title : root.detail-page && !root.pane ? root.detail-title : root.titles[MobileView.page];
                    font-size: root.short ? MobileTypography.font-size(21) : root.usable-width < 360px ? MobileTypography.font-size(20) : MobileTypography.font-size(round(root.title-size / 1px));
                    horizontal-stretch: 0; wrap: word-wrap;
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.stacked-header && !(root.narrow && MobileView.page == 4): HeaderStatus {
                    compact: root.usable-height < 600px;
                    rules-shortcut: MobileView.page == 4 && !root.detail-page;
                }
                if MobileView.page == 4 && !root.detail-page && (root.narrow || root.stacked-header): RulesShortcutButton { }
              }
              if root.stacked-header: HeaderStatus { compact: root.usable-height < 600px; }
            }
        }
        protection-alert := ProtectionAlert {
            visible: MobileData.protection-health == 3;
            x: header.x; y: header.y + header.height + 4px; width: header.width;
            height: self.visible ? self.preferred-height : 0px;
            health: MobileData.protection-health; message: MobileData.protection-message;
            font-size: MobileTypography.font-size(13); enabled: !MobileView.modal && !MobileView.notice-modal;
            clicked => { MobileView.navigate(8); }
        }
        protection-lock := MProtectionLock {
            visible: MobileData.protected || MobileData.protection-pending;
            x: header.x; y: protection-alert.y + protection-alert.height + (protection-alert.visible ? 8px : 0px);
            width: header.width; height: self.visible ? self.preferred-height : 0px;
            pending: MobileData.protection-pending;
            enabled: !MobileData.working && !MobileView.modal && !MobileView.notice-modal;
        }
        update-banner := Rectangle {
            visible: (root.update-available || root.update-downloading) && !MobileData.protected && !MobileData.protection-pending;
            x: header.x; y: protection-lock.y + protection-lock.height + (protection-lock.visible ? 8px : 0px);
            width: header.width; height: self.visible ? update-content.preferred-height : 0px;
            background: Theme.accent-wash; border-radius: 12px;
            update-content := VerticalLayout {
                padding: 10px; spacing: 6px;
                HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                    VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 2px;
                        MSmall { text: root.update-downloading ? "正在下载更新" : "发现新版本"; font-weight: 600; color: Theme.accent; }
                        MSmall { text: !root.update-downloading && MobileView.draft-dirty ? "请先保存或放弃当前修改" : root.update-status; wrap: word-wrap; }
                    }
                    if root.update-downloading: MButton {
                        text: "取消"; compact: true; enabled: !MobileView.modal && !MobileView.notice-modal;
                        width: max(64px, MobileTypography.font-size(13) * 2 + 20px); horizontal-stretch: 0;
                        clicked => { MobileActions.request(MobileIntent.cancel-update, "", ""); }
                    }
                    if root.update-available && !root.update-downloading: MButton {
                        geometry-key: "mobile-update-install"; text: "下载安装"; compact: true; primary: true;
                        width: max(84px, MobileTypography.font-size(13) * 4 + 20px); horizontal-stretch: 0;
                        enabled: !root.update-busy && !MobileView.draft-dirty && !MobileData.profile-busy && !MobileView.modal && !MobileView.notice-modal;
                        clicked => { root.install-update(); }
                    }
                }
                if root.update-downloading: MProgress { value: root.update-progress; }
            }
        }
        body := Rectangle {
            x: header.x; y: update-banner.y + update-banner.height + (update-banner.visible ? 8px : 0px); width: header.width;
            height: max(0px, root.usable-height - (self.y - MobileView.safe-top) - (root.bottom ? root.bottom-height - MobileView.safe-bottom : 0px));
            HorizontalLayout { spacing: MobileTypography.padding;
                Rectangle {
                    page-host := Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; visible: !root.detail-page || root.pane;
                        GeometryTarget { key: "preview-content"; bounds: [page-host.absolute-position.x, page-host.absolute-position.y, page-host.width, page-host.height]; }
                        @children
                    }
                    if root.detail-page && !root.pane: MobileDetails { width: parent.width; height: parent.height; }
                }
                if root.pane: Rectangle { width: 344px;
                    VerticalLayout { spacing: MobileTypography.gap;
                        HorizontalLayout { spacing: MobileTypography.small-gap; cross-axis-alignment: center;
                            MHeading { text: root.detail-title; }
                            MButton { text: "关闭"; width: max(64px, MobileTypography.font-size(15) * 2 + 16px); horizontal-stretch: 0; clicked => { MobileView.back(); } }
                        }
                        MobileDetails { }
                    }
                }
            }
        }
        if root.bottom: Rectangle {
            x: 0px; y: root.height - root.bottom-height;
            width: root.width; height: root.bottom-height; background: Theme.sidebar;
            animate background { duration: Motion.appearance; enabled: Motion.active; }
            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.line; }
            HorizontalLayout { x: MobileView.safe-left + 8px; y: 4px; width: root.usable-width - 16px; height: root.nav-content-height; spacing: 4px;
                for route-id in root.primary-pages: MNav { geometry-key: "preview-nav:" + route-id; stacked: true; pill: root.tab-pill;
                    text: root.titles[route-id]; icon: root.icons[route-id]; selected: MobileView.page == route-id || (route-id == 10 && MobileView.page >= 3 && MobileView.page <= 8);
                    clicked => { MobileView.navigate(route-id); }
                }
            }
        }
        MobileModal { centered: root.centered-modal || root.expanded; }
        RuleShortcutsDialog {
            x: MobileView.safe-left; y: MobileView.safe-top;
            width: root.usable-width; height: root.usable-height;
            opened <=> MobileView.shortcuts-open;
            labels: MobileData.shortcuts; values: MobileData.shortcut-values; available: MobileData.shortcut-available;
            row-height: max(48px, MobileTypography.font-size(16) * 2);
            editable: !MobileData.working && !MobileData.protected && !MobileData.protection-pending;
            blocked: MobileView.page != 4 || MobileView.detail != 0 || MobileView.modal || MobileView.notice-modal || MobileData.protected || MobileData.protection-pending;
            toggled(index, value) => { MobileActions.request(MobileIntent.rule-shortcut, "" + index, value ? "true" : "false"); }
        }
        // Last sibling: notifications overlay both page content and modal sheets.
        Rectangle {
            x: 0px; y: 0px; width: root.width; height: root.height - MobileView.keyboard-inset;
            visible: notice-presence.mounted;
            opacity: notice-presence.progress;
            background: MobileView.notice-modal ? #00000066 : transparent;
            if MobileView.notice-modal: TouchArea { }
            error-focus := FocusScope {
                property <bool> active: MobileView.notice-modal;
                enabled: self.active;
                changed active => { if self.active { self.focus(); } }
                init => { if self.active { self.focus(); } }
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Back {
                        MobileView.notice = "";
                        if (event.text == Key.Back) { MobileView.notice-back-pending += 1; }
                        return accept;
                    }
                    return reject;
                }
            }
            notice-panel := MNotice {
                x: MobileView.safe-left + (root.usable-width - self.width) / 2;
                y: MobileView.notice-modal ? MobileView.safe-top + max(8px, (root.usable-height - self.height) / 2)
                    : max(MobileView.safe-top + 8px, parent.height - (root.bottom ? root.bottom-height : MobileView.safe-bottom) - self.height - 24px) + (1 - notice-presence.progress) * 8px;
                width: min(600px, root.usable-width - 24px);
                text: root.notice-text;
                error: MobileView.notice-error;
                available-height: root.usable-height * (MobileView.notice-modal ? 0.8 : MobileView.notice-error ? 0.65 : 0.4);
                dismissed => { MobileView.notice = ""; }
            }
        }
    }
}

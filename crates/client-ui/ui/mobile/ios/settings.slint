import { PageSurface } from "../../components/motion.slint";
import { MobileData } from "../shared/state.slint";
import { IosData, IosActions, IosIntent } from "state.slint";
import { MSmall, MHeading, MCard, MButton, MRow, MDivider, MSwitch, MScroll } from "../shared/controls.slint";
import { AppearanceSettings, NetworkToggles, ScheduleSettings, CurrentVersion, GeoSettingsContents } from "../shared/settings.slint";

component IosNetwork inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: "网络"; font-weight: 600; }
    MCard { NetworkToggles { } }
}
component IosConnection inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: "VPN 与系统"; font-weight: 600; }
    MCard {
        MSwitch { title: "按需连接"; checked: IosData.on-demand; enabled: !MobileData.protected && !MobileData.protection-pending;
            toggled(value) => { IosActions.request(IosIntent.on-demand, value ? "true" : "false"); }
        }
        MDivider { }
        MRow { title: "系统 VPN 配置"; value: IosData.vpn-profile; interactive: !MobileData.protected && !MobileData.protection-pending; clicked => { IosActions.request(IosIntent.vpn-settings, ""); } }
        MDivider { }
        MRow { title: "打开系统设置"; interactive: !MobileData.protected && !MobileData.protection-pending; clicked => { IosActions.request(IosIntent.system-settings, ""); } }
    }
}
component IosUpdates inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: "更新"; font-weight: 600; }
    MCard {
        CurrentVersion { }
        MSmall { text: "版本与分发信息"; }
        MButton { text: "查看版本更新"; clicked => { IosActions.request(IosIntent.version-info, ""); } }
        MDivider { }
        GeoSettingsContents { }
    }
}
export component IosSettings inherits PageSurface {
    MScroll {
        if root.width < 760px: VerticalLayout { alignment: start; spacing: 20px; padding-bottom: 20px;
            IosConnection { } IosNetwork { } AppearanceSettings { } IosUpdates { } ScheduleSettings { }
        }
        if root.width >= 760px: HorizontalLayout { spacing: 20px; width: root.width;
            VerticalLayout { alignment: start; spacing: 20px; IosConnection { } IosNetwork { } }
            VerticalLayout { alignment: start; spacing: 20px; AppearanceSettings { } IosUpdates { } ScheduleSettings { } }
        }
    }
}

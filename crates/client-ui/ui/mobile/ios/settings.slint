import { PageSurface } from "../../components/motion.slint";
import { MobileData } from "../shared/state.slint";
import { IosData, IosActions, IosIntent } from "state.slint";
import { MSmall, MHeading, MCard, MButton, MRow, MDivider, MSwitch, MScroll } from "../shared/controls.slint";
import { AppearanceSettings, NetworkToggles, MaintenanceSettings } from "../shared/settings.slint";

component IosNetwork inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MHeading { text: "网络"; }
    MCard { NetworkToggles { } }
}
component IosConnection inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MHeading { text: "VPN 与系统"; }
    MCard {
        MSwitch { title: "按需连接"; checked: IosData.on-demand;
            toggled(value) => { IosActions.request(IosIntent.on-demand, value ? "true" : "false"); }
        }
        MDivider { }
        MRow { title: "系统 VPN 配置"; value: IosData.vpn-profile; clicked => { IosActions.request(IosIntent.vpn-settings, ""); } }
        MDivider { }
        MRow { title: "打开系统设置"; clicked => { IosActions.request(IosIntent.system-settings, ""); } }
    }
}
component IosAbout inherits MCard {
    MRow { title: "当前版本"; value: MobileData.version; arrow: false; interactive: false; }
    MSmall { text: "版本与分发信息"; }
    MButton { text: "查看版本更新"; clicked => { IosActions.request(IosIntent.version-info, ""); } }
}
export component IosSettings inherits PageSurface {
    MScroll {
        if root.width < 760px: VerticalLayout { alignment: start; spacing: 20px; padding-bottom: 20px;
            AppearanceSettings { } IosNetwork { } IosConnection { } MaintenanceSettings { } IosAbout { }
        }
        if root.width >= 760px: HorizontalLayout { spacing: 20px; width: root.width;
            VerticalLayout { alignment: start; spacing: 20px; AppearanceSettings { } IosConnection { } }
            VerticalLayout { alignment: start; spacing: 20px; IosNetwork { } MaintenanceSettings { } IosAbout { } }
        }
    }
}

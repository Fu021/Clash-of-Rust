import { PageSurface } from "../../components/motion.slint";
import { LanguageOptions } from "../../components/language-options.slint";
import { MobileTypography } from "../shared/typography.slint";
import { MobileData, MobileView, MobileActions, MobileIntent } from "../shared/state.slint";
import { AndroidData, AndroidActions, AndroidIntent } from "state.slint";
import { MText, MSmall, MHeading, MCard, MButton, MRow, MDivider, MSwitch, MField, MSelect, MScroll, MProgress } from "../shared/controls.slint";
import { AppearanceSettings, NetworkToggles, ScheduleSettings, CurrentVersion, GeoSettingsContents } from "../shared/settings.slint";

component AndroidHelp inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: @tr("帮助"); font-weight: 600; }
    MCard {
        vertical-padding: 4px;
        HorizontalLayout { spacing: MobileTypography.gap; cross-axis-alignment: center;
            MText { text: @tr("官网使用指南"); min-width: 0px; wrap: word-wrap; }
            label := MSmall { visible: false; text: @tr("在浏览器打开"); font-size: MobileTypography.font-size(13); }
            MButton {
                geometry-key: "settings-open-guide"; text: label.text; compact: true;
                width: max(88px, label.preferred-width + 24px); horizontal-stretch: 0;
                clicked => { MobileActions.request(MobileIntent.open-guide, "", ""); }
            }
        }
    }
}

component AndroidLanguage inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: @tr("语言/language"); font-weight: 600; }
    MCard {
        MSelect {
            geometry-key: "language";
            options: LanguageOptions.tags;
            value: MobileData.language;
            display-value(tag) => { LanguageOptions.label(tag) }
            enabled: !MobileData.working;
            selected(index, value) => { MobileActions.request(MobileIntent.language, value, ""); }
        }
    }
}
component AndroidNetwork inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: @tr("网络"); font-weight: 600; }
    MCard {
        HorizontalLayout { spacing: MobileTypography.gap; cross-axis-alignment: center;
            MText { text: @tr("混合端口"); }
            MField { width: 96px; horizontal-stretch: 0; text <=> MobileData.mixed-port; enabled: !MobileData.protected && !MobileData.protection-pending; edited(value) => { AndroidData.ports-dirty = true; } }
        }
        if AndroidData.ports-dirty: MButton { text: @tr("保存端口"); primary: true; enabled: !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.save-ports, MobileData.mixed-port, ""); } }
        MDivider { }
        NetworkToggles { show-fake-ip-exclusions: true; ipv6-locked: AndroidData.ipv6-locked; }
    }
}
component AndroidConnection inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: @tr("VPN 与系统"); font-weight: 600; }
    MCard {
        MRow { title: @tr("VPN 设置"); value: AndroidData.authorization-status; interactive: !MobileData.protected && !MobileData.protection-pending; clicked => { AndroidActions.request(AndroidIntent.vpn-settings, ""); } }
        MDivider { }
        MRow { geometry-key: "preview-application-routing"; title: @tr("应用分流"); value: AndroidData.application-scope;
            clicked => { AndroidActions.request(AndroidIntent.application-routing, ""); }
        }
        MDivider { }
        MSwitch { title: @tr("通知显示实时速度"); checked: AndroidData.notification-speeds;
            toggled(value) => { AndroidActions.request(AndroidIntent.notification-speeds, value ? "true" : "false"); }
        }
        MDivider { }
        MRow { title: @tr("电池与后台运行"); clicked => { AndroidActions.request(AndroidIntent.battery-settings, ""); } }
    }
}
component AndroidUpdates inherits VerticalLayout {
    alignment: start; spacing: 10px;
    MSmall { text: @tr("更新"); font-weight: 600; }
    MCard {
        CurrentVersion { }
        MSwitch { title: @tr("包含预发布版本"); checked: MobileData.update-prereleases; enabled: !MobileData.working && !AndroidData.update-busy && !MobileData.protected && !MobileData.protection-pending;
            toggled(value) => { MobileActions.request(MobileIntent.update-prereleases, value ? "true" : "false", ""); }
        }
        MSmall { text: AndroidData.update-status; wrap: word-wrap; }
        if AndroidData.update-downloading: MProgress { value: AndroidData.update-progress; indeterminate: AndroidData.update-progress == 0; }
        HorizontalLayout { spacing: MobileTypography.small-gap;
            MButton { text: @tr("检查更新"); busy: AndroidData.update-busy && !AndroidData.update-downloading; enabled: !AndroidData.update-busy && !MobileData.protected && !MobileData.protection-pending; clicked => { MobileActions.request(MobileIntent.check-update, "", ""); } }
            if AndroidData.update-available: MButton { text: @tr("安装更新"); primary: true; enabled: !AndroidData.update-busy && !MobileData.protected && !MobileData.protection-pending;
                clicked => {
                    if MobileData.update-preview {
                        MobileActions.request(MobileIntent.install-update, "", "prepare");
                        MobileView.detail = 13;
                    } else { MobileActions.request(MobileIntent.install-update, "", ""); }
                }
            }
        }
        if AndroidData.update-downloading: MButton { text: @tr("取消下载"); clicked => { MobileActions.request(MobileIntent.cancel-update, "", ""); } }
        MRow { title: @tr("查看 Release"); subtitle: @tr("在浏览器查看版本与发布说明"); clicked => { MobileActions.request(MobileIntent.open-release, "", ""); } }
        MDivider { }
        GeoSettingsContents { }
    }
}
export component AndroidSettings inherits PageSurface {
    MScroll {
        content-y <=> MobileView.settings-scroll-y;
        changed content-height => { MobileView.settings-content-height = self.content-height; }
        changed height => { MobileView.settings-viewport-height = self.height; }
        init => { MobileView.settings-content-height = self.content-height; MobileView.settings-viewport-height = self.height; }
        VerticalLayout { alignment: start; spacing: 20px;
            AndroidHelp { }
            if root.width < 760px: VerticalLayout { alignment: start; spacing: 20px; padding-bottom: 20px;
                AndroidLanguage { } AndroidConnection { } AndroidNetwork { } AppearanceSettings { custom-font-size: false; } AndroidUpdates { } ScheduleSettings { }
            }
            if root.width >= 760px: HorizontalLayout { spacing: 20px; width: root.width;
                VerticalLayout { width: (root.width - 20px) / 2; horizontal-stretch: 0; alignment: start; spacing: 20px;
                    AndroidLanguage { } AndroidConnection { } AndroidNetwork { }
                }
                VerticalLayout { width: (root.width - 20px) / 2; horizontal-stretch: 0; alignment: start; spacing: 20px;
                    AppearanceSettings { custom-font-size: false; } AndroidUpdates { } ScheduleSettings { }
                }
            }
        }
    }
}

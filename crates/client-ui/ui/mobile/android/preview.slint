import { MobilePreviewSurface } from "../shared/preview.slint";
import { AndroidSurface } from "app.slint";
import "../../../../../resources/fonts/SourceHanSansCN-Regular.otf";
import { AndroidData } from "state.slint";
import { MobileData, MobileView } from "../shared/state.slint";
export component AndroidPreview inherits Window {
    in-out property <bool> preview-long-names <=> scene.preview-long-names;
    preferred-width: 393px; preferred-height: 852px;
    default-font-family: "Source Han Sans CN";
    in-out property <bool> preview-motion <=> scene.preview-motion;
    in-out property <bool> preview-list-view <=> scene.preview-list-view;
    in-out property <int> preview-page <=> scene.preview-page;
    in-out property <bool> preview-network-detail <=> scene.preview-network-detail;
    in-out property <int> preview-network-tool <=> scene.preview-network-tool;
    in-out property <int> preview-detail <=> scene.preview-detail;
    in-out property <bool> preview-dark <=> scene.preview-dark;
    in-out property <bool> preview-connected <=> scene.preview-connected;
    in-out property <bool> preview-core-running <=> scene.preview-core-running;
    in-out property <length> inset-top <=> scene.inset-top;
    in-out property <length> inset-bottom <=> scene.inset-bottom;
    in-out property <length> inset-left <=> scene.inset-left;
    in-out property <length> inset-right <=> scene.inset-right;
    in-out property <length> preview-keyboard <=> scene.preview-keyboard;
    in-out property <float> text-scale <=> scene.text-scale;
    in-out property <bool> preview-selected-rule <=> scene.preview-selected-rule;
    in-out property <bool> preview-shortcuts <=> scene.preview-shortcuts;
    in-out property <bool> preview-protection-pending <=> scene.preview-protection-pending;
    in-out property <bool> preview-protected <=> scene.preview-protected;
    in-out property <int> preview-protection-health <=> scene.preview-protection-health;
    in-out property <string> preview-protection-message <=> scene.preview-protection-message;
    in-out property <string> preview-notice <=> scene.preview-notice;
    in-out property <bool> preview-notice-error <=> scene.preview-notice-error;
    in-out property <bool> preview-notice-critical <=> scene.preview-notice-critical;
    in-out property <bool> preview-notice-recover-network <=> scene.preview-notice-recover-network;
    in-out property <float> preview-notice-elapsed <=> scene.preview-notice-elapsed;
    in-out property <bool> preview-sparse <=> scene.preview-sparse;
    in-out property <bool> preview-profile-busy <=> MobileData.profile-busy;
    in-out property <bool> preview-update-prereleases <=> MobileData.update-prereleases;
    in-out property <bool> preview-update-preview <=> MobileData.update-preview;
    in-out property <string> preview-update-version <=> MobileData.update-version;
    in-out property <bool> preview-update-available <=> AndroidData.update-available;
    in-out property <string> preview-update-status <=> AndroidData.update-status;
    in-out property <bool> preview-update-downloading <=> AndroidData.update-downloading;
    in-out property <float> preview-update-progress <=> AndroidData.update-progress;
    in-out property <int> preview-applications-mode <=> AndroidData.applications-mode;
    in-out property <int> preview-applications-filter <=> AndroidData.applications-filter;
    in-out property <bool> preview-policies-editing <=> AndroidData.policies-editing;
    in-out property <bool> preview-policies-choosing <=> AndroidData.policies-choosing;
    in-out property <bool> preview-applications-limited <=> AndroidData.applications-visibility-limited;
    in-out property <bool> preview-applications-dirty <=> MobileView.draft-dirty;
    in-out property <length> preview-settings-scroll <=> MobileView.settings-scroll-y;
    in-out property <length> preview-rules-scroll <=> MobileView.rules-scroll-y;
    in-out property <length> preview-home-scroll <=> MobileView.home-scroll-y;
    scene := MobilePreviewSurface {
        inset-top: 28px; inset-bottom: 24px; preview-connected: true;
        AndroidSurface { }
    }
    init => {
        AndroidData.authorization-status = "已允许";
        MobileData.protection-supported = true;
        AndroidData.applications-loaded = true;
        AndroidData.policies-supported = true;
        AndroidData.policies-profile = "示例订阅";
        AndroidData.policies-status = "只作用于进入 VPN 的应用；未指定的应用跟随配置。";
        AndroidData.policies-applications = [
            { name: "浏览器", package: "org.example.browser", selected: true, available: true },
            { name: "视频", package: "org.example.video", selected: true, available: true },
            { name: "音乐", package: "org.example.music", selected: true, available: true },
            { name: "地图", package: "org.example.maps", selected: false, available: false, assignment: "属于 日常直连" },
            { name: "天气", package: "org.example.weather", selected: false, available: false, assignment: "属于 日常直连" },
            { name: "工作聊天", package: "org.example.chat", selected: false, available: false, assignment: "未进入 VPN" }
        ];
        AndroidData.policies-name = "视频与浏览";
        AndroidData.policies-target = "策略组 · 自动选择";
        AndroidData.policies-selected = 3;
        AndroidData.policies-targets = ["直连", "拦截", "策略组 · 自动选择", "节点 · 日本 01"];
        AndroidData.policies = [
            {id: "media", name: "视频与浏览", target: "策略组 · 自动选择", status: "已应用 · 新连接生效", count: 3, applications: "浏览器、视频、音乐"},
            {id: "maps", name: "日常直连", target: "直连", status: "已应用 · 新连接生效", count: 2, applications: "地图、天气"},
            {id: "work", name: "工作应用", target: "节点 · 已移除节点", status: "目标失效 · 阻止连接", count: 1, applications: "工作聊天"}
        ];
        AndroidData.applications-total = 6;
        AndroidData.applications-selected = 2;
        AndroidData.applications-mode = 1;
        AndroidData.applications-saved-summary = "仅选中 2 个应用";
        AndroidData.applications-query-permission = true;
        AndroidData.applications = [
            {name: "浏览器", package: "org.example.browser", selected: true, icon: @image-url("../../icons/network.svg"), has-icon: true},
            {name: "地图", package: "org.example.maps", selected: false, icon: @image-url("../../icons/ip.svg"), has-icon: true},
            {name: "邮件", package: "org.example.mail", selected: true, icon: @image-url("../../icons/subscriptions.svg"), has-icon: true},
            {name: "音乐", package: "org.example.music", selected: false, icon: @image-url("../../icons/proxies.svg"), has-icon: true},
            {name: "很长的应用名称用于检查操作控件是否始终可见", package: "org.example.long.application.name", selected: false, icon: @image-url("../../icons/home.svg"), has-icon: true},
            {name: "Clash of Rust", package: "org.clashofrust.android", selected: false, icon: @image-url("../../icons/settings.svg"), has-icon: true},
        ];
    }
}

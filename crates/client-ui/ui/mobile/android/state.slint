// Android-only presentation and native requests. iOS does not import this file.
export enum AndroidIntent { vpn-settings, application-routing, application-query, application-system, application-filter, application-mode, application-toggle, application-select, application-revert, application-save, application-refresh, application-permissions, notification-speeds, battery-settings, check-update, save-ports, background }
export global AndroidActions { callback request(AndroidIntent, string); }
export struct ApplicationItem { name: string, package: string, selected: bool, icon: image, has-icon: bool }
export struct ApplicationPolicyItem { id: string, name: string, target: string, status: string, count: int, applications: string }
export struct ApplicationPolicyApp { name: string, package: string, selected: bool, icon: image, has-icon: bool, available: bool, assignment: string }
export global AndroidData {
    in-out property <bool> policies-supported;
    in-out property <string> policies-profile;
    in-out property <string> policies-status;
    in-out property <[ApplicationPolicyApp]> policies-applications;
    in-out property <[string]> policies-targets;
    in-out property <[ApplicationPolicyItem]> policies;
    in-out property <string> policies-query;
    in-out property <string> policies-name;
    in-out property <string> policies-target;
    in-out property <bool> policies-reject-missing: true;
    in-out property <bool> policies-editing;
    in-out property <bool> policies-choosing;
    in-out property <bool> policies-system;
    in-out property <int> policies-filter;
    in-out property <int> policies-selected;
    in-out property <int> policies-revision: -1;
    in-out property <length> policies-scroll-y;
    in-out property <[ApplicationItem]> applications;
    in-out property <bool> applications-loading;
    in-out property <bool> applications-saving;
    in-out property <bool> applications-loaded;
    in-out property <bool> applications-system;
    in-out property <string> applications-query;
    in-out property <string> applications-error;
    in-out property <bool> applications-visibility-limited;
    in-out property <bool> applications-query-permission;
    in-out property <int> applications-icon-failures;
    in-out property <string> applications-saved-summary;
    in-out property <int> applications-mode;
    in-out property <int> applications-filter;
    in-out property <int> applications-total;
    in-out property <string> applications-snapshot;
    in-out property <int> applications-selected;
    in-out property <length> applications-scroll-y;
    in-out property <bool> notification-speeds: true;
    in-out property <bool> ports-dirty;
    in-out property <string> authorization-status: "未授权";
    in-out property <string> application-scope: "全部应用";
    in-out property <string> update-status: "尚未检查更新";
    in-out property <bool> update-busy;
    in-out property <bool> update-downloading;
    in-out property <bool> update-available;
    in-out property <float> update-progress;
}

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://api.github.com; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
